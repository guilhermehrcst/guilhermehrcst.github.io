---
// Resources by what the student does with them (V0.4 §4.3): study (courses, tracks, lessons), practise
// (practice, past exams, simulators), consult (reference material). An empty group is omitted, never
// rendered as a promise. With `anchors`, each group carries its id (#conteudo, #pratique, #consulta).
import ResourceList from './ResourceList.astro';
import { isPractice, type PublishedLearningResource } from '../lib/learning-resources';
import { pt as t } from '../i18n/pt';

interface Props { resources: readonly PublishedLearningResource[]; headingLevel?: 2 | 3; anchors?: boolean }
const { resources, headingLevel = 2, anchors = false } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const itemLevel = (headingLevel + 1) as 3 | 4;
const isReference = (r: PublishedLearningResource) => r.format === 'reference';
const groups = [
  { id: 'conteudo', label: t.subject.content, resources: resources.filter((r) => !isPractice(r) && !isReference(r)) },
  { id: 'pratique', label: t.subject.practice, resources: resources.filter(isPractice) },
  { id: 'consulta', label: t.subject.reference, resources: resources.filter(isReference) },
].filter((group) => group.resources.length > 0);
---
{groups.map((group) => (
  <section class="part" id={anchors ? group.id : undefined} data-part={group.id}>
    <Heading class="part-title">{group.label}</Heading>
    <ResourceList resources={group.resources} headingLevel={itemLevel} />
  </section>
))}

<style>
  .part + .part { margin-top: var(--space-7); }
  .part-title { font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-2); }
</style>
