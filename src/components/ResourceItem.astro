---
// One free resource: who offers it, its official title (never translated) as the one link out, and the
// few facts that help a student decide. Adapted from the former LearningResourceCard, without the
// curator plate, image or numbering (spec §2.2). The id stays in data-resource-id, never in `id`, so a
// resource can appear in two lists of one page. V0.4: on the page that is its home, its first occurrence
// carries `anchor`, the id #recurso-<id> that search results open (anchorPlan decides; verify-dist checks).
import ProviderMark from './ProviderMark.astro';
import ExternalLinkIcon from './icons/radix/ExternalLinkIcon.astro';
import type { PublishedLearningResource } from '../lib/learning-resources';
import { resourceDisplayFacts } from '../lib/resource-display';
import { resourceAnchor } from '../lib/search-index';
import { pt as t } from '../i18n/pt';

interface Props { resource: PublishedLearningResource; headingLevel?: 2 | 3 | 4; compact?: boolean; anchor?: boolean }
// compact: for long lists of similar resources; the provider joins the facts instead of its own line.
const { resource: r, headingLevel = 3, compact = false, anchor = false } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const l = t.resource;

const { overview, access } = resourceDisplayFacts(r, l, compact);
---
<li
  class:list={['resource', compact && 'compact']}
  id={anchor ? resourceAnchor(r.id) : undefined}
  data-resource-id={r.id}
  data-subject={r.subject}
  data-format={r.format}
  data-school-years={r.schoolYears?.join(' ')}
  data-paths={r.paths.join(' ')}
  data-exams={r.exams?.join(' ')}
>

  {!compact && <p class="provider"><ProviderMark name={r.provider} /></p>}
  <Heading class="title">
    <a href={r.url} target="_blank" rel="noopener noreferrer">
      <span class="link-title"><span translate="no">{r.title}</span><ExternalLinkIcon /></span>
      <span class="source-action" data-source-action aria-hidden="true">{l.openSource}</span>
      <span class="sr-only"> ({l.newTab})</span>
    </a>
  </Heading>
  <p class="facts">{overview.join(' · ')}</p>
  {access.length > 0 && (
    <p class="access" data-resource-access><span class="access-label">{l.accessLabel}:</span>{' '}{access.join(' · ')}</p>
  )}
</li>

<style>
  /* The card of "Comece por um caminho pronto" (FeaturedPaths): raised paper, a hairline rule, the large
     radius, the serif title. The title is the one link out; it covers the whole card, and its visible
     action ("Abrir na fonte"), inside that same link, sits at the card's foot (verify-dist: exactly one). */
  .resource {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    height: 100%;
    padding: var(--space-5) var(--space-5) calc(var(--space-5) + 44px + var(--space-2));
    background: var(--raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    transition: border-color var(--t-ui) var(--ease);
  }
  .resource:hover { border-color: var(--rule-strong); }
  .resource:focus-within { outline: 2px solid var(--action); outline-offset: 3px; }
  .provider { font-size: var(--fs-small); color: var(--muted); min-height: 36px; display: flex; align-items: center; }
  .title { font-family: var(--serif); font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem); font-weight: 460; line-height: 1.2; letter-spacing: -0.015em; }
  .title a { text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .title a:focus-visible { outline: none; }
  .resource:hover .link-title, .title a:focus-visible .link-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .link-title :global(svg) { display: inline-block; width: 0.7em; height: 0.7em; margin-left: 0.3em; vertical-align: 0; color: var(--muted); }
  .resource:hover .link-title :global(svg) { color: var(--action); }
  .facts { padding-top: var(--space-3); border-top: 1px solid var(--rule); font-size: var(--fs-small); color: var(--muted); line-height: 1.5; }
  .access { font-size: var(--fs-small); line-height: 1.5; color: var(--ink); }
  .access-label { margin-right: 0.3em; font-weight: 600; }
  /* The link's visible action, like "Abrir o guia do ENEM →" on the Home. */
  .source-action { position: absolute; left: var(--space-5); bottom: var(--space-5); display: inline-flex; align-items: center; min-height: 44px; font-family: var(--sans); font-size: var(--fs-body); font-weight: 560; letter-spacing: 0; color: var(--action); }
  .source-action::after { content: '↗'; margin-left: 0.35em; transition: transform var(--t-ui) var(--ease); }
  .resource:hover .source-action::after { transform: translate(2px, -2px); }
  .compact { gap: var(--space-1); padding: var(--space-4) var(--space-4) calc(var(--space-4) + 44px + var(--space-1)); }
  .compact .title { font-size: var(--fs-h3); }
  .compact .source-action { left: var(--space-4); bottom: var(--space-4); }
</style>
