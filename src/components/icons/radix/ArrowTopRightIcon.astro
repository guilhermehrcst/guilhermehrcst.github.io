---
// Radix Icons: ArrowTopRightIcon (15x15, filled glyph). The path, viewBox and fill rules are copied,
// unchanged, from @radix-ui/react-icons 1.3.2 (MIT, Copyright (c) 2022 WorkOS; the licence text is
// published at /licenses/RadixIcons-MIT.txt).
//
// Radix Icons are the site's default family for new interface icons. The package ships React
// components and this site has no React, so each glyph used lives here as one .astro file holding
// the official SVG, and nothing else: no colour, size, spacing or animation of its own. The context
// styles it (`class`, or CSS on the parent): it takes `currentColor` and, without a size, the 15px of
// the original. To add a glyph, copy its SVG from the package's source into a file of this folder.
//
// Decorative by default (aria-hidden): beside a text that already says what the control does, the
// icon must not be announced twice. Give it an `aria-label` (and it stops being hidden) only when it
// stands alone.
import type { HTMLAttributes } from 'astro/types';

interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
  role?: HTMLAttributes<'svg'>['role'];
  'aria-label'?: string;
  'aria-hidden'?: 'true' | 'false';
}
const { class: className, width = 15, height = 15, role, 'aria-label': label, 'aria-hidden': hidden } = Astro.props;
const ariaHidden = hidden ?? (label ? undefined : 'true');
---
<svg
  class={className}
  width={width}
  height={height}
  viewBox="0 0 15 15"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role={role}
  aria-label={label}
  aria-hidden={ariaHidden}
  focusable="false"
>
