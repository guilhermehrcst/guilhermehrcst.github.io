---
import Label from './Label.astro';
import { dicts } from '../i18n/routes';
import type { Lang } from '../i18n/types';

interface Props { lang: Lang }
const t = dicts[Astro.props.lang].principles;
---
<section class="principles" aria-labelledby="principles-label">
  <div class="grid">
    <Label text={t.label} class="pr-label" />
  </div>
  <h2 id="principles-label" class="sr-only">{t.label.replace(/^\d+\s*\/\s*/, '')}</h2>
  <ol>
    {t.items.map((it, i) => (
      <li class="item grid rv-rule" data-reveal>
        <span class="meta idx">0{i + 1}</span>
        <h3 class="word">{it.title}<span class="slash rv-slash" data-reveal aria-hidden="true">/</span></h3>
        <p class="pbody">{it.body}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .principles { padding-block: var(--space-section); }
  :global(.pr-label) { grid-column: 1 / -1; margin-bottom: clamp(24px, 4vw, 56px); }
  .item {
    position: relative;
    padding-block: 14px clamp(28px, 4vw, 64px);
    align-items: end;
  }
  /* The rule is a drawn line (scaleX), with a short blue tick at its start: the section mark. */
  .item::before, .item::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--ink); transform-origin: left; }
  .item::after { right: auto; width: 28px; height: 3px; background: var(--signal); }
  .item:last-child { border-bottom: 1px solid var(--ink); }
  :global(.reveal-ready) .item:not(:global(.is-in))::before { transform: scaleX(0); }
  :global(.reveal-ready) .item:not(:global(.is-in))::after { transform: scaleX(0); }
  .item::before { transition: transform 900ms var(--ease); }
  .item::after { transition: transform 500ms var(--ease) 500ms; }
  .idx { grid-column: 1 / -1; align-self: start; color: var(--muted); margin-bottom: clamp(8px, 2vw, 28px); }
  /* Sized to the longest word across both languages (CORRECTNESS/, --fit-word),
     confined to ~3/4 of the width so the text can sit beside it. */
  .word {
    grid-column: 1 / span 9;
    font-size: calc((100vw - 2 * var(--margin)) * 0.74 / var(--fit-word));
    font-weight: 600;
    line-height: 0.82;
    /* a touch looser than the 700 display lines: at 600 the same tracking lets R-R and T-N touch */
    letter-spacing: calc(var(--display-track) + 0.008em);
    font-variation-settings: var(--display-opsz);
    text-transform: uppercase;
    margin-left: -0.04em;
  }
  .pbody { grid-column: 10 / span 3; font-size: var(--fs-small); color: var(--muted); max-width: 26em; text-wrap: pretty; }

  @media (max-width: 1024px) {
    .word { grid-column: 1 / -1; font-size: calc((100vw - 2 * var(--margin)) / var(--fit-word)); }
    .pbody { grid-column: 3 / span 4; margin-top: 20px; }
  }
  @media (max-width: 640px) {
    .pbody { grid-column: 1 / -1; }
  }
</style>
