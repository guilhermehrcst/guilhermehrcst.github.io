---
// A subject's resources in the order of the flow: first what to study, then where to practise, then what
// to consult (spec §6.3, V0.4 §4.3), grouped by ResourceGroups. With `anchors`, the groups are the page's
// #conteudo, #pratique and #consulta; without, a page can show several subjects without repeating ids.
import ResourceGroups from './ResourceGroups.astro';
import { filterResources } from '../lib/learning-library';
import { publishedResources } from '../lib/learning-resources';
import { routes } from '../lib/routes';
import type { PathId, SubjectId } from '../lib/taxonomy';

interface Props { subject: SubjectId; path?: PathId | undefined; headingLevel?: 2 | 3; anchors?: boolean }
const { subject, path, headingLevel = 2, anchors = false } = Astro.props;
const all = filterResources(publishedResources, { subject, ...(path ? { paths: [path] } : {}) });
---
<ResourceGroups resources={all} headingLevel={headingLevel} anchors={anchors} page={anchors ? routes.subject(subject) : undefined} />
