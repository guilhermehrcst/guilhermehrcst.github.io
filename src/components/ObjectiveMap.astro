---
// A path seen through the school areas: for each area, its subjects, each with the resources that declare
// this path and a link to the subject's page. Technology closes the page with a link to its own path.
// An area or subject without resources for the path is left out, never shown empty. Without `practice`,
// practice is left to the exam pages that hold it (Vestibular: /enem/ and /uerj/).
import TrackSection from './TrackSection.astro';
import ResourceList from './ResourceList.astro';
import { mapSections } from '../lib/learning-library';
import { routes } from '../lib/routes';
import type { PathId } from '../lib/taxonomy';
import { pt as t } from '../i18n/pt';

interface Props { path: PathId; technology?: boolean; practice?: boolean }
const { path, technology = true, practice = true } = Astro.props;
const areas = mapSections(path, { practice });
const tech = t.objectiveMap.technology;
---
{areas.map((area) => (
  <TrackSection id={area.id} title={area.label}>
    <div class="subjects">
      {area.subjects.map((subject) => (
        <div class="subject">
          <h3><a href={routes.subject(subject.id)}>{t.objectiveMap.more(subject.label)}{' '}<span aria-hidden="true">→</span></a></h3>
          <ResourceList resources={subject.resources} headingLevel={4} compact />
        </div>
      ))}
    </div>
  </TrackSection>
))}

{technology && (
  <TrackSection id="tecnologia" title={tech.title} why={tech.why}>
    <p><a class="more" href={routes.objective('tecnologia')}>{tech.link}{' '}<span aria-hidden="true">→</span></a></p>
  </TrackSection>
)}

<style>
  .subjects { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6) var(--space-7); }
  @media (min-width: 768px) { .subjects { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* Inside a subject column the list is a single column. */
  .subject :global(.resources) { grid-template-columns: minmax(0, 1fr); }
  h3 { font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-2); }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .more { display: inline-flex; align-items: center; gap: 0.35em; min-height: 44px; font-weight: 500; }
</style>
