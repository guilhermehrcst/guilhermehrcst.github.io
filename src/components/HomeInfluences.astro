---
// Home 08, influences: the résumé's endless editorial rail, under the Home's chapter head.
import HomeChapter from './HomeChapter.astro';
import ResumeInfluences from './ResumeInfluences.astro';
import { dicts } from '../i18n/routes';
import type { Lang } from '../i18n/types';

interface Props { lang: Lang }
const copy = dicts[Astro.props.lang].resume.influences;
---
<HomeChapter id="influences" n="08" title={copy.title}>
  <ResumeInfluences copy={copy} />
</HomeChapter>
