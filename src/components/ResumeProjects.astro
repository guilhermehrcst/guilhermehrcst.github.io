---
// `projects --selected`: Pexiscale, Lume and Pexis Machine, as structured terminal output. Every
// word comes from the dictionaries (résumé work entries and the Pexis Machine copy); nothing here
// is new copy, no metric is added, and Pexis Machine has no link because none is approved.
import type { Dict } from '../i18n/types';

interface Props { t: Dict }
const { t } = Astro.props;
const { pexiscale: px, lume } = t.resume.work;
const pm = t.pexisMachine;
---
<p class="t-comment">{t.resume.work.note}</p>

<article class="pj" aria-labelledby="pj-px">
  <header class="pj-head">
    <span class="pj-n" aria-hidden="true">[01]</span>
    <h3 id="pj-px" class="pj-name">{px.name}<span class="sl" aria-hidden="true">/</span></h3>
    <p class="pj-kind">{px.kind}</p>
    <p class="pj-stack">{px.stack}</p>
    <p class="pj-link"><a class="u" href={px.link.href} rel="noopener">{px.link.text}</a></p>
  </header>
  <div class="pj-body">
    <ul class="t-rows">{px.points.map((p) => <li>{p}</li>)}</ul>
    <dl class="t-figs">
      {px.figures.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
    </dl>
  </div>
</article>

<article class="pj" aria-labelledby="pj-lm">
  <header class="pj-head">
    <span class="pj-n" aria-hidden="true">[02]</span>
    <h3 id="pj-lm" class="pj-name">{lume.name}<span class="sl" aria-hidden="true">/</span></h3>
    <p class="pj-kind">{lume.kind}</p>
    <p class="pj-stack">{lume.stack}</p>
    <p class="pj-link"><a class="u" href={lume.link.href} rel="noopener">{lume.link.text}</a></p>
  </header>
  <div class="pj-body">
    <div>
      <p class="pj-desc">{lume.description}</p>
      <ul class="t-rows">{lume.points.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div class="pj-side">
      <p class="t-label">{lume.method.label}</p>
      <dl class="t-kv">
        {lume.method.items.map((m) => <div><dt>{m.term}</dt><dd>{m.definition}</dd></div>)}
      </dl>
    </div>
  </div>
  <div class="pj-exp">
    <p class="t-label">{lume.experiment.label}</p>
    <dl class="t-figs">
      <div><dt>{lume.experiment.movement.label}</dt><dd>{lume.experiment.movement.value}</dd></div>
      <div><dt>{lume.experiment.time.label}</dt><dd>{lume.experiment.time.value}</dd></div>
    </dl>
    <p class="pj-exp-text">{lume.experiment.text}</p>
  </div>
</article>

<article class="pj" aria-labelledby="pj-pm">
  <header class="pj-head">
    <span class="pj-n" aria-hidden="true">[03]</span>
    <h3 id="pj-pm" class="pj-name">{pm.name}<span class="sl" aria-hidden="true">/</span></h3>
    <p class="pj-kind">{pm.kind}</p>
  </header>
  <div class="pj-body">
    <div>
      <p class="pj-desc">{pm.question}</p>
      <p class="pj-text">{pm.body}</p>
    </div>
    <dl class="t-kv">
      {pm.facts.map((f) => <div><dt>{f.title}</dt><dd>{f.body}</dd></div>)}
    </dl>
  </div>
</article>

<style>
  .pj { padding-block: var(--space-lg) var(--space-xl); border-top: 1px solid var(--void-rule); }
  .pj-head { display: grid; grid-template-columns: 4ch minmax(0, 1fr); column-gap: var(--gap); row-gap: 4px; align-items: baseline; }
  .pj-head > :not(.pj-n) { grid-column: 2; }
  .pj-n { grid-row: 1; font-family: var(--mono); font-size: var(--fs-t-cmd); color: var(--void-signal); }
  .pj-name {
    font-size: var(--fs-t-h3);
    font-weight: var(--display-wght);
    line-height: 0.95;
    letter-spacing: var(--display-track);
    font-variation-settings: var(--display-opsz);
    text-transform: uppercase;
  }
  .pj-kind { margin-top: var(--space-xs); font-size: var(--fs-lead); line-height: 1.3; }
  .pj-stack { font-family: var(--mono); font-size: var(--fs-t-cmd); color: var(--void-muted); }
  .pj-link { margin-top: var(--space-xs); font-family: var(--mono); font-size: var(--fs-t-cmd); }
  .pj-link a { text-decoration: none; }

  .pj-body {
    margin-top: var(--space-lg);
    padding-left: calc(4ch + var(--gap));
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-lg) var(--space-xl);
    align-items: start;
  }
  .pj-desc { font-size: var(--fs-lead); line-height: 1.35; text-wrap: pretty; margin-bottom: var(--space-md); }
  .pj-text { color: var(--void-muted); line-height: 1.55; text-wrap: pretty; }
  .pj-side { display: flex; flex-direction: column; gap: var(--space-sm); }
  .pj-exp { margin-top: var(--space-lg); padding-left: calc(4ch + var(--gap)); display: flex; flex-direction: column; gap: var(--space-sm); }
  .pj-exp-text { max-width: 46em; color: var(--void-muted); line-height: 1.55; text-wrap: pretty; }

  @media (max-width: 900px) {
    .pj-body { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .pj-head { grid-template-columns: minmax(0, 1fr); }
    .pj-head > :not(.pj-n) { grid-column: 1; }
    .pj-n { grid-row: auto; }
    .pj-body, .pj-exp { padding-left: 0; }
  }

  @media print {
    .pj { padding-block: 8pt 10pt; border-top-color: var(--gh-gray-200); break-inside: auto; }
    .pj-head { break-after: avoid; }
    .pj-n { color: var(--gh-gray-600); }
    .pj-name { font-size: 16pt; }
    .pj-kind, .pj-desc { font-size: 11pt; }
    .pj-stack, .pj-link, .pj-text, .pj-exp-text { color: var(--gh-gray-600); }
    .pj-body { margin-top: 6pt; gap: 6pt 18pt; }
  }
</style>
