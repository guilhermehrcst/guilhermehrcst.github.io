---
import { Picture } from 'astro:assets';
import portrait from '../assets/hero/guilherme.jpg';
import { dicts, routes } from '../i18n/routes';
import type { Lang } from '../i18n/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang].hero;

// Fine line icons for the three metadata rows (same 1.5 stroke as the contact arrows).
const icons = [
  'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11ZM12 12.3a2.3 2.3 0 1 0 0-4.6 2.3 2.3 0 0 0 0 4.6Z', // location
  'M3.5 5h17v11h-17ZM9 20h6M12 16v4', // practice: a screen
  'M13 3 5.5 13.5H11L10 21l7.5-10.5H12Z', // now: a bolt
];
---
<section class="hero" aria-labelledby="hero-title" data-narrative-section="whoami">
  <h1 id="hero-title" class="hero-name">
    <span class="line"><span class="rise" style="--d: 0ms">Guilherme</span></span>
    <span class="line"><span class="rise" style="--d: 80ms">Henrique<span class="slash" aria-hidden="true">/</span></span></span>
  </h1>

  <div class="hero-body grid">
    <figure class="hero-photo">
      <Picture
        src={portrait}
        formats={['webp']}
        fallbackFormat="jpeg"
        widths={[480, 720, 980]}
        sizes="(max-width: 640px) 100vw, 50vw"
        alt={t.photoAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>

    <div class="hero-aside">
      <ul class="hero-meta">
        {t.meta.map((value, i) => (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={icons[i]} /></svg>
            <span class="meta">{value}</span>
          </li>
        ))}
      </ul>

      <p class="hero-blurb">{t.blurb}</p>

      <div class="hero-cta">
        <a class="cta" href={routes.resume[lang]}>
          <span>{t.cta}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.5 19.5 19.5 4.5M8.5 4.5h11v11" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* The hero is one composition: header, name, then the photo and its column. The name is
     bounded by two things: the width of the grid (as before: --fit-name) and now also by the
     window height, so that the photo and the column start near the middle of the viewport
     whatever the window's shape:
       photo top = header + gaps + 2 lines of name  =>  name <= (split - chrome) / 1.68
     On a tall or narrow window the width rule wins and the name stays full-bleed. */
  .hero {
    --hero-gap: var(--space-sm);
    --hero-split: 45svh; /* where the photo and the column start, as a share of the window */
    --hero-rest: calc(100svh - var(--hero-split)); /* what is left of the window for the photo and the column */
    --hero-chrome: calc(var(--header-h) + 1px + 2 * var(--hero-gap) + var(--space-xs) + 1px);
    padding-top: calc(var(--header-h) + 1px + var(--hero-gap));
  }

  .hero-name {
    --fit-size: calc((100vw - 2 * var(--margin)) / var(--fit-name));
    padding-inline: var(--margin);
    padding-bottom: var(--space-xs);
    font-size: var(--fit-size);
    font-size: min(var(--fit-size), max(3.5rem, calc((var(--hero-split) - var(--hero-chrome)) / 1.68)));
    font-weight: var(--display-wght);
    line-height: 0.84;
    letter-spacing: var(--display-track);
    font-variation-settings: var(--display-opsz);
    text-transform: uppercase;
    margin-left: -0.045em; /* optical: pull the G's side bearing onto the grid edge */
  }
  .line {
    display: block;
    /* Mask for the load reveal. Padding gives the Q tail room; the negative
       margin keeps the measured line height. */
    overflow: clip;
    padding-bottom: 0.11em;
    margin-bottom: -0.11em;
  }
  .rise { display: block; }
  .slash { color: var(--signal); margin-left: 0.02em; }

  /* Below the name: photo and column share one row and one height. The photo is a structural
     piece (it touches the hairlines of the grid), the column a quiet stack whose last element,
     the action, closes it at the photo's lower edge. */
  .hero-body {
    padding-top: var(--hero-gap);
    border-top: 1px solid var(--rule);
  }
  .hero-photo {
    position: relative;
    grid-column: 1 / span 6;
    /* Fill the column in both directions. justify-self matters: a grid item with an aspect-ratio and
       an auto width otherwise derives its width from the stretched height and spills into the next column. */
    align-self: stretch;
    justify-self: stretch;
    min-width: 0;
    aspect-ratio: 3 / 2; /* a floor: the row is at least this tall; it stretches to the column when that is taller */
    overflow: clip;
    background: var(--surface); /* the box is reserved (no layout shift); a quiet tone until the image arrives */
  }
  .hero-photo :global(picture) { position: absolute; inset: 0; display: block; }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 10%;
  }

  .hero-aside {
    grid-column: 7 / span 6;
    --pad: var(--space-lg);
    /* The column's vertical metrics are the smaller of a width rule and a share of what is left of the
       window (--hero-rest), so photo, rows, statement and action end near the fold on a laptop and keep
       their width-based size on a tall window. Both rules are continuous, and so is their minimum. */
    --pad-v: clamp(1.25rem, min(var(--space-lg), calc(var(--hero-rest) * 0.073)), 2.5rem);
    --row-h: clamp(3.25rem, min(2.92rem + 1.33vw, calc(var(--hero-rest) * 0.125)), 4.5rem); /* 52px on a phone, ~62px at 1440x900 */
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--rule);
  }
  .hero-meta li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: var(--row-h);
    padding: 0 var(--pad);
    border-bottom: 1px solid var(--rule);
  }
  .hero-meta svg { flex: none; width: 18px; height: 18px; color: var(--muted); }
  .hero-meta .meta { font-size: var(--fs-meta-l); }

  .hero-blurb {
    padding: var(--pad-v) var(--pad) 0;
    font-size: clamp(1.75rem, min(1.03rem + 1.756vw, calc(var(--hero-rest) * 0.075)), 2.75rem); /* 28px phone, ~32px at 1024x768, 37px at 1440x900 */
    font-weight: 450;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* The action spans the column edge to edge and sits at its foot. */
  .hero-cta { margin-top: auto; padding-top: var(--pad-v); }
  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: clamp(3.75rem, min(3.33rem + 1.714vw, calc(var(--hero-rest) * 0.158)), 5.25rem); /* 60px phone, 78px at 1440x900 */
    padding: 0 var(--pad);
    background: var(--signal);
    color: var(--ink); /* ink on the blue is 5.9:1; white would be 3.35:1 */
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background-color 180ms var(--ease), color 180ms var(--ease);
  }
  .cta svg { flex: none; width: 26px; height: 26px; transition: transform 180ms var(--ease); }
  .cta:hover, .cta:focus-visible { background: var(--ink); color: var(--paper); }
  .cta:hover svg, .cta:focus-visible svg { transform: translate(2px, -2px); }
  .cta:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* Entrance: the name rises through its masks (as before); the photo is revealed by a
     clip from the top, once; the aside fades in. Nothing moves afterwards. */
  :global(.motion) .rise { transform: translate3d(0, 104%, 0); }
  :global(.motion.loaded) .rise {
    transform: none;
    transition: transform var(--t-hero) var(--ease) var(--d);
  }
  /* An animation, not a transition, so no clip-path stays applied afterwards: the settled
     photo is the same picture, pixel for pixel, as the static one. */
  :global(.motion:not(.loaded)) .hero-photo { clip-path: inset(0 0 100% 0); }
  :global(.motion.loaded) .hero-photo { animation: photo-reveal var(--t-hero) var(--ease) 220ms backwards; }
  @keyframes photo-reveal {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  :global(.motion) .hero-aside { opacity: 0; }
  :global(.motion.loaded) .hero-aside {
    opacity: 1;
    transition: opacity var(--t-medium) linear 520ms;
  }

  /* Tablet: same 50/50 composition on the 6-column grid. */
  @media (max-width: 1024px) {
    .hero-photo { grid-column: 1 / span 3; aspect-ratio: 5 / 4; }
    .hero-aside { grid-column: 4 / span 3; --pad: var(--space-md); }
  }

  /* Mobile is its own composition: the photo takes the full width, kept shorter than its
     tablet/desktop ratio so the name, the photo, the text and the action are about one screen. */
  @media (max-width: 640px) {
    .hero-photo { grid-column: 1 / -1; align-self: auto; aspect-ratio: 10 / 11; }
    .hero-photo :global(img) { object-position: 50% 0; }
    .hero-aside {
      grid-column: 1 / -1;
      --pad: 0px;
      margin-top: var(--space-md);
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    /* Text and action come straight after the photo; the metadata closes the block as a caption. */
    .hero-blurb { order: 1; padding-top: var(--space-md); }
    .hero-cta { order: 2; margin-top: 0; padding-top: var(--space-md); }
    .cta { padding: 0 var(--space-md); }
    .hero-meta { order: 3; margin-top: var(--space-lg); border-top: 1px solid var(--rule); }
  }
</style>
