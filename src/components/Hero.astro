---
import { Picture } from 'astro:assets';
import portrait from '../assets/hero/guilherme.jpg';
import { dicts, routes } from '../i18n/routes';
import type { Lang } from '../i18n/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang].hero;

// Fine line icons for the three metadata rows (same 1.5 stroke as the contact arrows).
const icons = [
  'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11ZM12 12.3a2.3 2.3 0 1 0 0-4.6 2.3 2.3 0 0 0 0 4.6Z', // location
  'M3.5 5h17v11h-17ZM9 20h6M12 16v4', // practice: a screen
  'M13 3 5.5 13.5H11L10 21l7.5-10.5H12Z', // now: a bolt
];
---
<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero-name">
    <span class="line"><span class="rise" style="--d: 0ms">Guilherme</span></span>
    <span class="line"><span class="rise" style="--d: 80ms">Henrique<span class="slash" aria-hidden="true">/</span></span></span>
  </h1>

  <div class="hero-body grid">
    <figure class="hero-photo">
      <Picture
        src={portrait}
        formats={['webp']}
        fallbackFormat="jpeg"
        widths={[480, 720, 980]}
        sizes="(max-width: 640px) 100vw, 50vw"
        alt={t.photoAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>

    <div class="hero-aside">
      <ul class="hero-meta">
        {t.meta.map((value, i) => (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={icons[i]} /></svg>
            <span class="meta">{value}</span>
          </li>
        ))}
      </ul>

      <p class="hero-blurb">{t.blurb}</p>

      <div class="hero-cta">
        <a class="cta" href={routes.resume[lang]}>
          <span>{t.cta}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.5 19.5 19.5 4.5M8.5 4.5h11v11" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: calc(var(--header-h) + clamp(14px, 1.9vw, 28px)); }

  /* The name is the protagonist. Size is derived from the measured advance
     width of the longest line (see --fit-name in global.css), so the line spans
     the grid without overflowing it. */
  .hero-name {
    padding-inline: var(--margin);
    padding-bottom: clamp(6px, 0.9vw, 14px);
    font-size: calc((100vw - 2 * var(--margin)) / var(--fit-name));
    font-weight: var(--display-wght);
    line-height: 0.8;
    letter-spacing: var(--display-track);
    font-variation-settings: var(--display-opsz);
    text-transform: uppercase;
    margin-left: -0.045em; /* optical: pull the G's side bearing onto the grid edge */
  }
  .line {
    display: block;
    /* Mask for the load reveal. Padding gives the Q tail room; the negative
       margin keeps the measured line height. */
    overflow: clip;
    padding-bottom: 0.11em;
    margin-bottom: -0.11em;
  }
  .rise { display: block; }
  .slash { color: var(--signal); margin-left: 0.02em; }

  /* Below the name: the photo is the main visual piece, the aside is a quiet column.
     The fold cuts the photo, as the viewport cuts the name on scroll. */
  .hero-body {
    padding-top: clamp(14px, 1.6vw, 24px);
    border-top: 1px solid var(--rule);
  }
  .hero-photo {
    grid-column: 1 / span 6;
    aspect-ratio: 4 / 5;
    overflow: clip;
    background: #e6e4dd; /* the box is reserved (no layout shift); a quiet tone until the image arrives */
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .hero-aside {
    grid-column: 7 / span 6;
    --pad: clamp(16px, 2.4vw, 36px);
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--rule);
  }
  .hero-meta li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px var(--pad);
    border-bottom: 1px solid var(--rule);
  }
  .hero-meta svg { flex: none; width: 18px; height: 18px; color: var(--muted); }
  .hero-meta .meta { font-size: 0.75rem; }
  .hero-meta li:first-child { padding-top: 4px; }

  .hero-blurb {
    padding: clamp(20px, 2.2vw, 32px) var(--pad) 0;
    max-width: 21em;
    font-size: clamp(1.5rem, 2.35vw, 2.5rem);
    font-weight: 450;
    line-height: 1.14;
    letter-spacing: -0.014em;
    text-wrap: balance;
  }

  .hero-cta { padding: clamp(20px, 2vw, 28px) var(--pad) 0; }
  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 0 22px;
    background: var(--signal);
    color: var(--paper);
    font-size: 1.125rem;
    font-weight: 560;
    letter-spacing: -0.005em;
    text-decoration: none;
    transition: background-color 180ms var(--ease);
  }
  .cta svg { flex: none; width: 22px; height: 22px; transition: transform 180ms var(--ease); }
  .cta:hover, .cta:focus-visible { background: var(--ink); }
  .cta:hover svg, .cta:focus-visible svg { transform: translate(2px, -2px); }
  .cta:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }

  /* Entrance: the name rises through its masks (as before); the photo is revealed by a
     clip from the top, once; the aside fades in. Nothing moves afterwards. */
  :global(.motion) .rise { transform: translate3d(0, 104%, 0); }
  :global(.motion.loaded) .rise {
    transform: none;
    transition: transform var(--t-hero) var(--ease) var(--d);
  }
  /* An animation, not a transition, so no clip-path stays applied afterwards: the settled
     photo is the same picture, pixel for pixel, as the static one. */
  :global(.motion:not(.loaded)) .hero-photo { clip-path: inset(0 0 100% 0); }
  :global(.motion.loaded) .hero-photo { animation: photo-reveal var(--t-hero) var(--ease) 220ms backwards; }
  @keyframes photo-reveal {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  :global(.motion) .hero-aside { opacity: 0; }
  :global(.motion.loaded) .hero-aside {
    opacity: 1;
    transition: opacity var(--t-medium) linear 520ms;
  }

  /* Tablet: same 50/50 composition on the 6-column grid. */
  @media (max-width: 1024px) {
    .hero-photo { grid-column: 1 / span 3; }
    .hero-aside { grid-column: 4 / span 3; }
    .hero-blurb { font-size: clamp(1.25rem, 3.1vw, 1.75rem); }
  }

  /* Mobile is its own composition: the photo takes the full width, kept shorter than
     its tablet/desktop ratio so the whole hero stays about one screen and a half. */
  @media (max-width: 640px) {
    .hero-photo { grid-column: 1 / -1; aspect-ratio: 10 / 11; }
    .hero-aside {
      grid-column: 1 / -1;
      --pad: 0px;
      margin-top: 18px;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
    /* Text and action come straight after the photo; the metadata closes the block as a caption. */
    .hero-blurb { order: 1; font-size: 1.5rem; padding-top: 24px; }
    .hero-cta { order: 2; padding-top: 22px; }
    .hero-meta { order: 3; margin-top: 28px; border-top: 1px solid var(--rule); }
    .hero-meta li:first-child { padding-top: 14px; }
  }
</style>
