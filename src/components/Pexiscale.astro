---
import { Picture } from 'astro:assets';
import Label from './Label.astro';
import ProjectDetail from './ProjectDetail.astro';
import { dicts } from '../i18n/routes';
import type { Lang } from '../i18n/types';
import sales from '../assets/pexiscale/sales.png';
import catalog from '../assets/pexiscale/catalog.png';
import home from '../assets/pexiscale/home.png';

interface Props { lang: Lang }
const t = dicts[Astro.props.lang].pexiscale;
const w = dicts[Astro.props.lang].resume.work.pexiscale;

// The figure is the product itself: three screenshots of the Pexiscale workspace, with demo data.
// The browser around them is cropped away (each file starts at the product's own edge) and nothing
// inside the product is edited. Sales leads, whole, with its navigation: it is where the commercial
// work happens. The catalogue and the AI home follow as details, cropped to their content and
// framed alike, so the two sit as one pair under it.
// Never upscale: the last width is the file's own.
const widths = (w: number) => [...[480, 768, 1080, 1440].filter((x) => x < w), w];
// sizes: the figure spans 8 of 12 columns of the Home's document column (HomeNarrative.astro): about
// half the window beside the terminal (from 1180px), two thirds of it below that, all of it on a phone.
const shots = [
  { key: 'sales', src: sales, main: true, sizes: '(min-width: 1180px) 48vw, (min-width: 1025px) 66vw, 100vw' },
  { key: 'catalog', src: catalog, main: false, sizes: '(min-width: 1180px) 24vw, (min-width: 1025px) 33vw, (min-width: 641px) 50vw, 100vw' },
  { key: 'home', src: home, main: false, sizes: '(min-width: 1180px) 24vw, (min-width: 1025px) 33vw, (min-width: 641px) 50vw, 100vw' },
] as const;
---
<section class="pexi" id="pexiscale" aria-labelledby="pexi-title" data-narrative-section="pexiscale">
  <div class="grid head">
    <Label text={t.label} class="p-label" />
    <h2 id="pexi-title" class="giant">{t.name}<span class="slash rv-slash" data-reveal aria-hidden="true">/</span></h2>
    <p class="meta spec"><span>{w.kind}</span><span class="spec-stack">{w.stack}</span></p>
    <p class="question">{t.question}</p>
  </div>

  <div class="grid body">
    <div class="aside">
      <p class="lead">{t.body}</p>
      <p class="link">
        <a href={t.link.href}><span class="u">{t.link.text}</span> <span class="arrow ne" aria-hidden="true">↗</span></a>
        <span class="meta note">{t.link.note}</span>
      </p>
    </div>

    <figure class="fig rv" data-reveal>
      <div class="shots">
        {shots.map((s) => (
          <div class:list={['shot', s.main && 'main']}>
            <Picture
              src={s.src}
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={82}
              widths={widths(s.src.width)}
              sizes={s.sizes}
              alt={t.figure.shots[s.key]}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
      <figcaption class="meta cap">{t.figure.caption}</figcaption>
    </figure>
  </div>

  <ProjectDetail project={t} num="02" />
</section>

<style>
  .pexi { padding-block: var(--space-section); }
  .pexi :global(.p-label) { grid-column: 1 / -1; color: var(--muted); }
  .giant {
    grid-column: 1 / -1;
    font-size: var(--fs-display-l);
    font-weight: var(--display-wght);
    line-height: 0.8;
    letter-spacing: var(--display-track);
    font-variation-settings: var(--display-opsz);
    text-transform: uppercase;
    margin: var(--space-md) 0 0 -0.045em;
  }
  .question {
    grid-column: 4 / span 9;
    margin-top: var(--space-xl);
    font-size: var(--fs-h3);
    font-weight: 440;
    line-height: 1.02;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  /* What it is and what it is built with: the résumé's own two lines, which the terminal repeats. */
  .spec { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 2px; margin-top: var(--space-md); }
  .spec-stack { color: var(--muted); }

  .body { margin-top: var(--space-xl); row-gap: var(--space-xl); align-items: end; }
  .aside { grid-column: 1 / span 4; display: flex; flex-direction: column; gap: var(--space-lg); }
  .lead { font-size: var(--fs-lead); line-height: 1.3; letter-spacing: -0.006em; text-wrap: pretty; }
  .link { display: flex; flex-direction: column; gap: 6px; }
  .link a { text-decoration: none; font-weight: 500; }
  .note { color: var(--muted); }

  .fig { grid-column: 5 / span 8; }
  /* One frame per screenshot: a hairline, no radius, no shadow; the product's own pale ground
     inside it. Sales runs the width of the figure, the two details share the row under it. */
  .shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
  .shot { border: 1px solid var(--rule); background: var(--surface); }
  .shot.main { grid-column: 1 / -1; }
  .shot :global(img) { display: block; width: 100%; height: auto; }
  .cap { margin-top: 12px; color: var(--muted); text-transform: none; letter-spacing: 0; }

  @media (max-width: 1024px) {
    .question { grid-column: 1 / -1; }
    .fig { grid-column: 1 / -1; order: -1; }
    .aside { grid-column: 1 / span 4; }
  }
  @media (max-width: 640px) {
    .aside { grid-column: 1 / -1; }
    .shots { grid-template-columns: minmax(0, 1fr); }
  }
</style>
