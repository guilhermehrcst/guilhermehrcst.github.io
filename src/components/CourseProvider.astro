---
// The institution of a course, as its mark(s) instead of its name (marks: lib/providers.ts).
// A partnership is its institutions' marks side by side with a quiet "+". An institution without a
// mark is shown as its name, so a missing asset never breaks a cell. The artwork is shown whole
// (object-fit: contain): its transparent margin is trimmed by the box, never the artwork.
import { Image } from 'astro:assets';
import { providerMarks } from '../lib/providers';
import type { Mark } from '../lib/providers';

interface Props { name: string }
const { name } = Astro.props;
const list = providerMarks[name];

const geometry = (m: Mark) => {
  const [x0, y0, x1, y1] = m.bbox;
  const { width: W, height: H } = m.src;
  const cw = (x1 - x0) / W;
  const ch = (y1 - y0) / H;
  // The canvas as it is drawn on desktop at 3x, never larger than the file.
  const drawnW = Math.round((m.h * ((x1 - x0) / (y1 - y0))) / cw);
  return {
    style: `--h: ${m.h}; --ratio: ${(x1 - x0) / (y1 - y0)}; --cx: ${x0 / W}; --cy: ${y0 / H}; --cw: ${cw}; --ch: ${ch}`,
    width: Math.min(drawnW, W),
    height: Math.min(drawnW, W) * (H / W),
  };
};
---
{list ? (
  <span class="brand" role={list.length > 1 ? 'group' : undefined} aria-label={list.length > 1 ? name : undefined}>
    {list.map((m, i) => {
      const g = geometry(m);
      return (
        <>
          {i > 0 && <span class="plus" aria-hidden="true">+</span>}
          <span class:list={['mk', m.ground === 'ink' && 'on-ink']}>
            <span class="art" style={g.style}>
              <Image src={m.src} alt={m.alt} width={Math.round(g.width)} height={Math.round(g.height)} densities={[1, 2, 3]} format="png" />
            </span>
          </span>
        </>
      );
    })}
  </span>
) : (
  <span class="cc-inst-text">{name}</span>
)}

<style>
  /* One slot height for every mark, so the titles of neighbouring cells start on one line whatever
     the institution. --bs scales the marks down with the window (tablet, phone). */
  .brand {
    --bs: 1;
    --slot: calc(36px * var(--bs));
    display: flex;
    align-items: center;
    gap: calc(10px * var(--bs));
    min-height: var(--slot);
    min-width: 0;
  }
  .mk { flex: none; display: block; }
  .mk.on-ink { background: var(--ink); padding: calc(5px * var(--bs)) calc(8px * var(--bs)); }
  .art { position: relative; display: block; overflow: hidden; height: calc(var(--h) * 1px * var(--bs)); aspect-ratio: var(--ratio); }
  .art :global(img) {
    position: absolute;
    max-width: none;
    width: calc(100% / var(--cw));
    height: calc(100% / var(--ch));
    left: calc(var(--cx) / var(--cw) * -100%);
    top: calc(var(--cy) / var(--ch) * -100%);
    object-fit: contain;
    object-position: left center;
  }
  .plus { flex: none; color: var(--muted); font-size: calc(15px * var(--bs)); font-weight: 500; line-height: 1; }
  .cc-inst-text { color: var(--muted); }

  @media (max-width: 1024px) { .brand { --bs: 0.94; } }
  @media (max-width: 640px) { .brand { --bs: 0.88; } }
</style>
