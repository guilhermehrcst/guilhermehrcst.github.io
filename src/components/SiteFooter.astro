---
// The site map, derived from the taxonomy, the tracks and the routes (spec §5.2, item 5): objectives,
// subjects, technology tracks and the Academy's own pages. Every link is a real page or a real anchor
// (verify-dist checks both, and that the footer reaches every objective and subject). Also the date the
// catalogue was last verified (from the data, never typed), the Academy's independence, and the
// licences of what the site ships. The brand is the official lockup (src/assets/brand), never redrawn.
import { Image } from 'astro:assets';
import lockup from '../assets/brand/lockup-white.png';
import { routes } from '../lib/routes';
import { ACADEMIC_SUBJECTS, EXAM_ORDER, OBJECTIVES, PATH_ORDER, SUBJECTS } from '../lib/taxonomy';
import { publishedTracks } from '../lib/tech-tracks';
import { VERIFIED_ON } from '../lib/learning-resources';
import { formatDate } from '../lib/dates';
import { pt as t } from '../i18n/pt';

const f = t.footer;
const date = formatDate(VERIFIED_ON);
const tracks = publishedTracks();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="about">
      <p class="brand"><Image src={lockup} alt="Pexis Academy" height={64} densities={[1, 2, 3]} format="png" /></p>
      <p class="tagline">{f.tagline}</p>
      <p class="small"><time datetime={VERIFIED_ON} data-verified-on>{f.verified(date)}</time></p>
      <p class="small">{f.independence}</p>
    </div>
    <nav aria-label={f.objectives}>
      <p class="eyebrow">{f.objectives}</p>
      <ul role="list">
        {[...PATH_ORDER, ...EXAM_ORDER].map((id) => <li><a href={routes.objective(id)}>{OBJECTIVES[id].label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label={f.subjects}>
      <p class="eyebrow">{f.subjects}</p>
      <ul role="list" class="cols">
        {ACADEMIC_SUBJECTS.map((id) => <li><a href={routes.subject(id)}>{SUBJECTS[id].label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label={f.technology}>
      <p class="eyebrow">{f.technology}</p>
      <ul role="list">
        {tracks.map((track) => <li><a href={`${routes.objective('tecnologia')}#${track.id}`}>{track.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label={f.academy}>
      <p class="eyebrow">{f.academy}</p>
      <ul role="list">
        <li><a href={routes.subjectIndex}>{f.nav.explore}</a></li>
        <li><a href={routes.search}>{f.nav.search}</a></li>
        <li><a href={routes.about}>{f.nav.about}</a></li>
        <li><a href={`${routes.about}#verificacao`}>{f.nav.verification}</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <p>
      {f.licenses}:{' '}<a href="/licenses/GoogleSansFlex-OFL.txt">Google Sans Flex (OFL)</a>,{' '}<a href="/licenses/Newsreader-OFL.txt">Newsreader (OFL)</a>,{' '}<a href="/licenses/RadixIcons-MIT.txt">Radix Icons (MIT)</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-8); border-top: 1px solid var(--rule); background: var(--surface); }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6) var(--space-5);
    padding-block: var(--space-8) var(--space-7);
  }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .about { grid-column: 1 / -1; } }
  @media (min-width: 1180px) {
    .grid { grid-template-columns: minmax(0, 3fr) minmax(0, 1.4fr) minmax(0, 2.4fr) minmax(0, 2fr) minmax(0, 1.6fr); column-gap: var(--space-6); }
    .about { grid-column: auto; }
  }

  .about { display: grid; gap: var(--space-3); align-content: start; max-width: 36ch; }
  /* The official lockup on the brand plate, larger than in the header ("ACADEMY" at 8.4px). */
  .brand { justify-self: start; padding: 14px 20px; background: var(--brand); line-height: 0; }
  .brand :global(img) { display: block; width: auto; height: 64px; }
  .tagline { color: var(--ink); }
  .small { font-size: var(--fs-small); color: var(--muted); }
  .eyebrow { margin-bottom: var(--space-2); }
  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-5); }
  li a { display: inline-flex; align-items: center; min-height: 40px; color: var(--ink); text-decoration: none; }
  li a:hover { color: var(--action); text-decoration: underline; text-underline-offset: 0.2em; }
  .legal > p { margin: 0; padding-block: var(--space-4) var(--space-6); border-top: 1px solid var(--rule); font-size: var(--fs-small); color: var(--muted); }
</style>
