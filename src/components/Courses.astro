---
import Base from '../layouts/Base.astro';
import Monument from './Monument.astro';
import LearningResourceCard from './LearningResourceCard.astro';
import { dicts } from '../i18n/routes';
import { AREA_ORDER, AREA_SUBJECTS, publishedResources } from '../lib/learning-resources';
import type { CourseImageLayout, LearningAreaId, LearningSubjectId, PublishedLearningResource, TechnologySectionId } from '../lib/learning-resources';
import type { Lang } from '../i18n/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang].courses;
const email = dicts[lang].contact.items.find((item) => item.icon === 'email')?.href;
const techOrder: TechnologySectionId[] = ['build', 'data', 'systems', 'security'];

const spans = (n: number): number[] => Array.from({ length: n }, (_, index) => {
  if (n === 4) return 6;
  const rest = n % 3;
  if (rest === 0 || index < n - rest) return 4;
  return rest === 1 ? 12 : 6;
});
const layoutSpan: Record<CourseImageLayout, number> = { opening: 12, 'media-right': 7, tile: 5, half: 8, tall: 4, band: 12 };
const spanOf = (resource: PublishedLearningResource, fallback: number) => resource.curated?.image ? layoutSpan[resource.curated.image.layout] : fallback;

type ResourceGroup = { id: string; label?: string; items: PublishedLearningResource[] };
const groupsFor = (area: LearningAreaId): ResourceGroup[] => {
  const items = publishedResources.filter((resource) => resource.area === area);
  if (area === 'technology') {
    return techOrder
      .map((id) => ({ id, label: t.technologySections[id], items: items.filter((resource) => resource.technology?.section === id) }))
      .filter((group) => group.items.length > 0);
  }
  if (area === 'nature' || area === 'humanities') {
    return AREA_SUBJECTS[area]
      .map((subject: LearningSubjectId) => ({ id: subject, label: t.subjects[subject], items: items.filter((resource) => resource.subject === subject) }))
      .filter((group) => group.items.length > 0);
  }
  return [{ id: area, items }];
};

let pick = 0;
const sections = AREA_ORDER.map((area) => ({
  area,
  copy: t.areas[area],
  groups: groupsFor(area),
  count: publishedResources.filter((resource) => resource.area === area).length,
}));
---
<Base lang={lang} page="courses" title={t.meta.title} description={t.meta.description}>
  <main id="main" class="library">
    <div class="frame">
      <header class="row head hero">
        <div class="cell cell-l">
          <p class="meta eyebrow">
            {t.eyebrow.map((word, index) => (<>{index > 0 && <span class="slash" aria-hidden="true">/</span>}<span>{word}</span></>))}
          </p>
          <h1 class="h-hero">{t.heading}<span class="slash" aria-hidden="true">/</span></h1>
        </div>
        <div class="cell cell-r"><p class="lead">{t.intro}</p></div>
      </header>

      <nav class="row jump" aria-label={t.nav.label}>
        <span class="jump-k" aria-hidden="true">{t.nav.jump}</span>
        <ul>
          <li><a href="#library-start">{t.nav.all}</a></li>
          {AREA_ORDER.map((area) => <li><a href={`#area-${area}`}>{t.nav.areas[area]}</a></li>)}
        </ul>
      </nav>

      <div id="library-start">
        {sections.map((section, sectionIndex) => (
          <section class="area" id={`area-${section.area}`} aria-labelledby={`area-${section.area}-title`} data-learning-area-section>
            <div class="row head">
              <div class="cell cell-l">
                <p class="meta count">{String(sectionIndex + 1).padStart(2, '0')} <span class="slash" aria-hidden="true">/</span> {section.count} {t.labels.resources}</p>
                <h2 class="h-sec" id={`area-${section.area}-title`}>{section.copy.title}<span class="slash" aria-hidden="true">/</span></h2>
              </div>
              <div class="cell cell-r"><p class="lead">{section.copy.intro}</p></div>
            </div>

            {section.groups.map((group) => {
              const fallback = spans(group.items.length);
              return (
                <div class="group" data-learning-group>
                  {group.label && <div class="group-head"><p class="meta">{section.copy.label}</p><h3>{group.label}</h3></div>}
                  <ul class="resource-grid">
                    {group.items.map((resource, index) => {
                      const n = resource.curated ? ++pick : undefined;
                      const span = spanOf(resource, fallback[index] ?? 4);
                      return <LearningResourceCard resource={resource} t={t} n={n} style={`--span: ${span}; --i: ${index}`} />;
                    })}
                  </ul>
                </div>
              );
            })}
          </section>
        ))}
      </div>

      <section class="row head closing" aria-labelledby="closing-h">
        <div class="cell cell-l"><h2 class="h-sec" id="closing-h">{t.closing.title}<span class="slash" aria-hidden="true">/</span></h2></div>
        <div class="cell cell-r">
          <p class="lead">{t.closing.body}</p>
          {email && <p class="suggest"><span>{t.closing.prompt}</span><a href={email}><span class="u">{t.closing.cta}</span> <span aria-hidden="true">→</span></a></p>}
        </div>
      </section>
    </div>
  </main>
  <Monument lang={lang} page="courses" />
</Base>

<style>
  .library { --fs-hero: clamp(2.5rem, 6vw, 7rem); --fs-sec: clamp(2.25rem, 5vw, 5.5rem); padding-top: var(--header-h); }
  @media (prefers-reduced-motion: no-preference) { :global(html:has(.library)) { scroll-behavior: smooth; } }
  .frame { margin-inline: var(--margin); border-inline: 1px solid var(--rule); }
  .row { border-bottom: 1px solid var(--rule); }
  .head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .cell { padding: var(--space-lg); display: flex; flex-direction: column; justify-content: flex-end; gap: var(--space-md); min-width: 0; }
  .cell-r { border-left: 1px solid var(--rule); }
  .hero .cell { min-height: clamp(360px, 52svh, 620px); }
  .area > .head .cell { min-height: clamp(200px, 21vw, 320px); }
  .closing .cell { min-height: clamp(180px, 18vw, 280px); }
  .eyebrow { display: flex; gap: 0.75em; margin-bottom: auto; color: var(--muted); }
  .count { color: var(--muted); }
  .h-hero, .h-sec { font-weight: 600; line-height: 0.95; letter-spacing: -0.022em; font-variation-settings: var(--display-opsz); overflow-wrap: anywhere; }
  .h-hero { font-size: var(--fs-hero); }
  .h-sec { font-size: var(--fs-sec); }
  .lead { font-size: var(--fs-lead); line-height: 1.35; color: var(--muted); text-wrap: pretty; max-width: 30em; }

  .jump { display: flex; align-items: stretch; min-height: 64px; }
  .jump-k { flex: none; display: flex; align-items: center; padding-inline: var(--space-lg); border-right: 1px solid var(--rule); color: var(--muted); }
  .jump ul { display: flex; overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain; }
  .jump ul::-webkit-scrollbar { display: none; }
  .jump li { flex: none; display: flex; }
  .jump a { position: relative; display: flex; align-items: center; min-height: 48px; padding-inline: var(--space-md); font-weight: 500; text-decoration: none; white-space: nowrap; }
  .jump a::after { content: ''; position: absolute; left: var(--space-md); right: var(--space-md); bottom: 12px; height: 2px; background: var(--signal); transform: scaleX(0); transform-origin: left; transition: transform var(--t-ui) var(--ease); }
  .jump a:hover::after, .jump a:focus-visible::after { transform: scaleX(1); }

  .group { border-bottom: 1px solid var(--rule); }
  .group-head { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); align-items: baseline; gap: var(--space-md); padding: var(--space-md) var(--space-lg); border-bottom: 1px solid var(--rule); }
  .group-head .meta { color: var(--muted); }
  .group-head h3 { font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 600; letter-spacing: -0.015em; }
  .resource-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .resource-grid > :global(li) { grid-column: span var(--span, 4); transition-delay: calc(var(--i, 0) * 50ms); }

  .suggest { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px var(--space-sm); }
  .suggest a { text-decoration: none; font-weight: 600; }

  @media (max-width: 1180px) {
    .resource-grid > :global(li) { grid-column: span 6; }
    .resource-grid > :global(li:last-child:nth-child(odd)) { grid-column: 1 / -1; }
    .resource-grid > :global(li.is-curated) { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .head { grid-template-columns: minmax(0, 1fr); }
    .cell-r { border-left: 0; border-top: 1px solid var(--rule); }
    .cell { padding: var(--space-lg) var(--space-md); }
    .hero .cell-l { min-height: 0; padding-top: var(--space-xl); }
    .hero .cell-r, .area > .head .cell, .closing .cell { min-height: 0; }
    .area > .head .cell-l { padding-top: var(--space-2xl); }
    .jump-k { padding-inline: var(--space-md); }
    .resource-grid > :global(li), .resource-grid > :global(li:last-child:nth-child(odd)) { grid-column: 1 / -1; }
    .group-head { grid-template-columns: 1fr; padding-inline: var(--space-md); gap: 4px; }
  }
</style>
