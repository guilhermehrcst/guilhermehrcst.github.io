---
import Base from '../layouts/Base.astro';
import Monument from './Monument.astro';
import LearningResourceCard from './LearningResourceCard.astro';
import CourseFilters from './CourseFilters.astro';
import { dicts, routes } from '../i18n/routes';
import { AREA_ORDER, AREA_SUBJECTS, publishedResources } from '../lib/learning-resources';
import type { CourseImageLayout, LearningAreaId, LearningSubjectId, PublishedLearningResource, TechnologySectionId } from '../lib/learning-resources';
import type { Lang } from '../i18n/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang].courses;
const email = dicts[lang].contact.items.find((item) => item.icon === 'email')?.href;
const techOrder: TechnologySectionId[] = ['build', 'data', 'systems', 'security'];

const spans = (n: number): number[] => Array.from({ length: n }, (_, index) => {
  if (n === 4) return 6;
  const rest = n % 3;
  if (rest === 0 || index < n - rest) return 4;
  return rest === 1 ? 12 : 6;
});
const layoutSpan: Record<CourseImageLayout, number> = { opening: 12, 'media-right': 7, tile: 5, half: 8, tall: 4, band: 12 };
const spanOf = (resource: PublishedLearningResource, fallback: number) => resource.curated?.image ? layoutSpan[resource.curated.image.layout] : fallback;

type ResourceGroup = { id: string; label?: string; items: PublishedLearningResource[] };
const groupsFor = (area: LearningAreaId): ResourceGroup[] => {
  const items = publishedResources.filter((resource) => resource.area === area);
  if (area === 'technology') {
    return techOrder
      .map((id) => ({ id, label: t.technologySections[id], items: items.filter((resource) => resource.technology?.section === id) }))
      .filter((group) => group.items.length > 0);
  }
  if (area === 'nature' || area === 'humanities') {
    return AREA_SUBJECTS[area]
      .map((subject: LearningSubjectId) => ({ id: subject, label: t.subjects[subject], items: items.filter((resource) => resource.subject === subject) }))
      .filter((group) => group.items.length > 0);
  }
  return [{ id: area, items }];
};

let pick = 0;
const sections = AREA_ORDER.map((area) => ({
  area,
  copy: t.areas[area],
  groups: groupsFor(area),
  count: publishedResources.filter((resource) => resource.area === area).length,
}));
---
<Base lang={lang} page="courses" title={t.meta.title} description={t.meta.description}>
  <main id="main" class="library">
    <div class="frame">
      <header class="hero">
        <p class="meta eyebrow">
          {t.eyebrow.map((word, index) => (<>{index > 0 && <span class="slash" aria-hidden="true">/</span>}<span>{word}</span></>))}
        </p>
        <h1>{t.heading}<span class="slash" aria-hidden="true">/</span></h1>
        <p class="lead">{t.intro}</p>
      </header>

      <nav class="study-paths" aria-label={t.tracks.label}>
        <p class="meta">{t.tracks.label}</p>
        <a href={routes['courses-enem'][lang]}><span>{t.tracks.enem}</span><span aria-hidden="true">→</span></a>
        <a href={routes['courses-uerj'][lang]}><span>{t.tracks.uerj}</span><span aria-hidden="true">→</span></a>
      </nav>

      <CourseFilters t={t} />

      <div class="area-list" id="library-start">
        {sections.map((section, sectionIndex) => (
          <details class="area" id={`area-${section.area}`} data-learning-area-section>
            <summary>
              <span class="meta area-index">{String(sectionIndex + 1).padStart(2, '0')}</span>
              <span class="area-name">{section.copy.label}</span>
              <span class="area-intro">{section.copy.intro}</span>
              <span class="meta area-count">{section.count} {t.labels.resources}</span>
              <span class="area-toggle" aria-hidden="true">+</span>
            </summary>

            <div class="area-content">
              <h2 class="sr-only">{section.copy.label}</h2>
              {section.groups.map((group) => {
                const fallback = spans(group.items.length);
                return (
                  <div class="group" data-learning-group>
                    {group.label && <div class="group-head"><p class="meta">{section.copy.label}</p><h3>{group.label}</h3></div>}
                    <ul class="resource-grid">
                      {group.items.map((resource, index) => {
                        const n = resource.curated ? ++pick : undefined;
                        const span = spanOf(resource, fallback[index] ?? 4);
                        return <LearningResourceCard resource={resource} t={t} n={n} style={`--span: ${span}; --i: ${index}`} />;
                      })}
                    </ul>
                  </div>
                );
              })}
            </div>
          </details>
        ))}
      </div>

      <section class="closing" aria-labelledby="closing-h">
        <h2 id="closing-h">{t.closing.title}<span class="slash" aria-hidden="true">/</span></h2>
        <div>
          <p>{t.closing.body}</p>
          {email && <p class="suggest"><span>{t.closing.prompt}</span><a href={email}><span class="u">{t.closing.cta}</span> <span aria-hidden="true">→</span></a></p>}
        </div>
      </section>
    </div>
  </main>
  <Monument lang={lang} page="courses" />
  <script>
    import '../scripts/course-filters';
  </script>
</Base>

<style>
  .library { padding-top: var(--header-h); }
  .frame { margin-inline: var(--margin); border-inline: 1px solid var(--rule); }

  .hero {
    min-height: clamp(300px, 42svh, 500px);
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    grid-template-rows: auto 1fr;
    border-bottom: 1px solid var(--rule);
  }
  .eyebrow {
    grid-column: 1 / -1;
    display: flex;
    gap: 0.75em;
    padding: var(--space-lg);
    color: var(--muted);
    border-bottom: 1px solid var(--rule);
  }
  .hero h1 {
    align-self: end;
    padding: var(--space-lg);
    font-size: clamp(2.75rem, 6.7vw, 7.25rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.032em;
    overflow-wrap: anywhere;
  }
  .hero .lead {
    align-self: end;
    padding: var(--space-lg);
    border-left: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--fs-lead);
    line-height: 1.4;
    text-wrap: pretty;
  }

  .study-paths {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 4.5fr) minmax(0, 4.5fr);
    border-bottom: 1px solid var(--rule);
  }
  .study-paths > * {
    min-height: 72px;
    display: flex;
    align-items: center;
    padding-inline: var(--space-lg);
  }
  .study-paths .meta { color: var(--muted); }
  .study-paths a {
    justify-content: space-between;
    gap: var(--space-md);
    border-left: 1px solid var(--rule);
    font-weight: 600;
    text-decoration: none;
  }
  .study-paths a:hover > span:last-child,
  .study-paths a:focus-visible > span:last-child { transform: translateX(3px); }
  .study-paths a > span:last-child { transition: transform var(--t-ui) var(--ease); }

  .area { border-bottom: 1px solid var(--rule); }
  .area > summary {
    list-style: none;
    display: grid;
    grid-template-columns: 64px minmax(150px, 2.2fr) minmax(0, 5.2fr) auto 28px;
    gap: var(--space-md);
    align-items: center;
    min-height: 92px;
    padding: var(--space-md) var(--space-lg);
    cursor: pointer;
  }
  .area > summary::-webkit-details-marker { display: none; }
  .area > summary:hover,
  .area > summary:focus-visible { background: var(--surface); }
  .area[open] > summary { background: var(--surface); border-bottom: 1px solid var(--rule); }
  .area-index, .area-count, .area-intro { color: var(--muted); }
  .area-name { font-size: clamp(1.2rem, 1.7vw, 1.55rem); font-weight: 600; letter-spacing: -0.015em; }
  .area-intro { font-size: var(--fs-meta-l); line-height: 1.4; text-wrap: pretty; }
  .area-count { white-space: nowrap; text-align: right; }
  .area-toggle { font-size: 1.5rem; line-height: 1; text-align: center; transition: transform var(--t-ui) var(--ease); }
  .area[open] .area-toggle { transform: rotate(45deg); }

  .area-content { background: var(--paper); }
  .group + .group { border-top: 1px solid var(--rule); }
  .group-head {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--rule);
  }
  .group-head .meta { color: var(--muted); }
  .group-head h3 { font-size: clamp(1.2rem, 1.8vw, 1.55rem); font-weight: 600; letter-spacing: -0.015em; }
  .resource-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .resource-grid > :global(li) { grid-column: span var(--span, 4); transition-delay: calc(var(--i, 0) * 50ms); }

  .closing {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    min-height: 190px;
    border-bottom: 1px solid var(--rule);
  }
  .closing h2 {
    display: flex;
    align-items: flex-end;
    padding: var(--space-lg);
    font-size: clamp(2rem, 4.5vw, 4.75rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.025em;
  }
  .closing > div {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-md);
    padding: var(--space-lg);
    border-left: 1px solid var(--rule);
    color: var(--muted);
  }
  .suggest { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px var(--space-sm); }
  .suggest a { color: var(--ink); text-decoration: none; font-weight: 600; }

  @media (max-width: 1180px) {
    .resource-grid > :global(li) { grid-column: span 6; }
    .resource-grid > :global(li:last-child:nth-child(odd)) { grid-column: 1 / -1; }
    .resource-grid > :global(li.is-curated) { grid-column: 1 / -1; }
    .area > summary { grid-template-columns: 48px minmax(150px, 2fr) minmax(0, 4fr) auto 24px; }
  }

  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; grid-template-rows: auto auto auto; min-height: 0; }
    .eyebrow, .hero h1, .hero .lead { grid-column: 1; }
    .hero h1 { padding: var(--space-xl) var(--space-md); }
    .eyebrow, .hero .lead { padding-inline: var(--space-md); }
    .hero .lead { border-left: 0; border-top: 1px solid var(--rule); }

    .study-paths { grid-template-columns: 1fr; }
    .study-paths > * { padding-inline: var(--space-md); min-height: 62px; }
    .study-paths a { border-left: 0; border-top: 1px solid var(--rule); }

    .area > summary {
      grid-template-columns: 34px 1fr auto 24px;
      gap: var(--space-sm);
      min-height: 74px;
      padding: var(--space-md);
    }
    .area-intro { display: none; }
    .area-count { font-size: 0.72rem; }
    .group-head { grid-template-columns: 1fr; padding-inline: var(--space-md); gap: 4px; }
    .resource-grid > :global(li), .resource-grid > :global(li:last-child:nth-child(odd)) { grid-column: 1 / -1; }

    .closing { grid-template-columns: 1fr; min-height: 0; }
    .closing h2, .closing > div { padding: var(--space-xl) var(--space-md); }
    .closing > div { border-left: 0; border-top: 1px solid var(--rule); }
  }

  @media (max-width: 390px) {
    .area > summary { grid-template-columns: 30px 1fr 22px; }
    .area-count { display: none; }
  }
</style>
