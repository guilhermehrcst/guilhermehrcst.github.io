---
// "Um caminho mais claro para aprender." (V0.3): Objetivo → Área → Assunto → Conteúdo → Prática, shown on
// one real route that differs from the hero's: Vestibular → Ciências da Natureza (Física) → (topic) → Física para ENEM →
// Questões de Física da UERJ. A step with nothing published says so and links nowhere (no topic is
// verified yet). The build fails if the route stops being true: the course must be tagged for Vestibular,
// the practice must be in the UERJ guide, and the UERJ must live inside Vestibular.
import { resolveGuide } from '../lib/exam-guides';
import { resourcesByIds } from '../lib/learning-library';
import { publishedResources } from '../lib/learning-resources';
import { routes } from '../lib/routes';
import { AREAS, EXAM_PARENT, OBJECTIVES, SUBJECTS } from '../lib/taxonomy';
import { pt as t } from '../i18n/pt';

const p = t.home.path;
const l = t.resource;
const subject = SUBJECTS.fisica;
const [content, practice] = resourcesByIds(publishedResources, ['kultivi-physics-enem', 'uerj-physics-practice']);
if (!content || !practice) throw new Error('LearningPath: the course or the practice is missing');
if (!content.paths.includes('vestibulares')) throw new Error('LearningPath: the course does not declare Vestibular');
if (EXAM_PARENT.uerj !== 'vestibulares') throw new Error('LearningPath: the UERJ is not inside Vestibular');
if (!resolveGuide('uerj').find((s) => s.id === 'provas')?.resources.some((r) => r.id === practice.id)) throw new Error('LearningPath: the practice is not in the UERJ guide');
const topic = subject.topics.find((item) => item.published);
const facts = (r: typeof content) => [r.provider, l.formats[r.format], r.registration && r.registration !== 'unconfirmed' && l.registration[r.registration]].filter(Boolean).join(' · ');

type Step = {
  id: keyof typeof p.steps;
  value?: string;
  meta: string;
  href?: string;
  link?: string;
  resourceId?: string;
  noTranslate?: boolean;
};
const vest = routes.objective('vestibulares');
const steps: Step[] = [
  { id: 'objetivo', value: OBJECTIVES.vestibulares.label, meta: p.vestMeta, href: vest, link: p.links.objective },
  // The area is the area (Ciências da Natureza); the subject it leads to is named under it.
  { id: 'area', value: AREAS[subject.area].label, meta: p.subjectMeta(subject.label), href: `${routes.subjectIndex}#area-${subject.area}`, link: p.links.area },
  topic
    ? { id: 'assunto', value: topic.label, meta: subject.label, href: routes.subject(subject.id), link: p.links.subject }
    : { id: 'assunto', meta: p.topicNote },
  { id: 'conteudo', value: content.title, meta: facts(content), href: `${vest}#${subject.area}`, link: p.links.content, resourceId: content.id, noTranslate: true },
  { id: 'pratica', value: practice.title, meta: facts(practice), href: `${routes.objective('uerj')}#provas`, link: p.links.practice, resourceId: practice.id },
];
---
<div class="panel">
  <p class="route"><span class="dot" aria-hidden="true"></span>{p.route}</p>
  <ol class="steps" role="list">
    {steps.map((step, i) => (
      <li class:list={['step', !step.href && 'pending']} data-path-step={step.id} data-demo-resource-id={step.resourceId}>
        <span class="node" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div class="body">
          <p class="label">{p.steps[step.id]}</p>
          {step.value
            ? <p class="value" translate={step.noTranslate ? 'no' : undefined}>{step.value}</p>
            : <p class="value" data-path-pending>{p.pending}</p>}
          <p class="meta">{step.meta}</p>
          {step.href && <a href={step.href}>{step.link}{' '}<span aria-hidden="true">→</span></a>}
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .panel {
    background: var(--raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
  }
  .route {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--muted);
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--action); }

  /* Phone, tablet and small desktop: a vertical rail; each node sits on it. */
  .steps { padding: var(--space-5) var(--space-5) var(--space-3); }
  .step { position: relative; display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); column-gap: var(--space-4); padding-bottom: var(--space-5); }
  .step::before {
    content: '';
    position: absolute;
    top: 2.25rem;
    bottom: 0;
    left: calc(1.125rem - 0.5px);
    border-left: 1px solid var(--rule-strong);
  }
  .step:last-child::before { display: none; }
  .node {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--action);
    border-radius: 50%;
    background: var(--tint-brand);
    color: var(--action);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .pending .node { border-style: dashed; border-color: var(--rule-strong); background: var(--raised); color: var(--muted); }
  /* Whatever touches a pending step is dashed: the path is real up to it and resumes after it. */
  .pending::before, .step:has(+ .pending)::before { border-left-style: dashed; }
  .body { min-width: 0; padding-top: 0.4rem; }
  .label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .value { margin-top: var(--space-1); font-family: var(--serif); font-size: 1.375rem; font-weight: 460; line-height: 1.2; letter-spacing: -0.01em; }
  .pending .value { color: var(--muted); font-style: italic; }
  .meta { margin-top: var(--space-1); font-size: var(--fs-small); color: var(--muted); }
  .step a { display: inline-flex; align-items: center; gap: 0.35em; min-height: 44px; font-size: var(--fs-small); font-weight: 560; }
  .step a span { transition: transform var(--t-ui) var(--ease); }
  .step a:hover span { transform: translateX(3px); }

  /* Tablet and small desktop: the link moves beside the step, so the panel stays compact. */
  @media (min-width: 640px) and (max-width: 1179px) {
    .body { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--space-6); }
    .body > p { grid-column: 1; }
    .step a { grid-column: 2; grid-row: 1 / span 3; align-self: center; }
  }

  /* Wide desktop: five columns on one horizontal rail (below 1180px a column is too narrow for its link). */
  @media (min-width: 1180px) {
    .steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); padding: var(--space-6) 0 var(--space-4); }
    .step { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; row-gap: var(--space-4); padding: 0 var(--space-5); }
    .step + .step .body { border-left: 1px solid var(--rule); margin-left: calc(-1 * var(--space-5)); padding-left: var(--space-5); }
    .step::before { top: 1.125rem; bottom: auto; left: 2.25rem; right: 0; border-left: 0; border-top: 1px solid var(--rule-strong); }
    .step:last-child::before { display: none; }
    .pending::before, .step:has(+ .pending)::before { border-top-style: dashed; }
    .body { padding-top: 0; min-height: 100%; }
  }
</style>
