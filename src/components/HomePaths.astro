---
// "Escolha seu caminho" on the Home (V2), after the LabAcademy reference: the six paths as wide coloured cards.
// Each: its own ground, an original illustration (PathArt) in a cut-corner panel of the deeper tone at the top
// right, a white disc with an arrow at the top left, then the path in the serif, one line of what it holds,
// and an outlined pill with what it really holds today (counted from the published catalogue at build time,
// objectiveFacts, never typed; "Em preparação" for a path in preparation). V2.1: the name leads, the state
// follows the description. The middle card of each
// row is turned over (text above, panel below), as the reference does, so six cards never read as six
// identical boxes. The whole card is the link. On a phone a card is a compact row. /materias/ keeps its
// editorial index (ObjectiveList.astro).
import PathArt from './PathArt.astro';
import ArrowTopRightIcon from './icons/radix/ArrowTopRightIcon.astro';
import { objectiveFacts } from '../lib/learning-library';
import { routes } from '../lib/routes';
import { superiorCopyFor } from '../lib/superior-copy';
import { OBJECTIVES, PATH_ORDER, PREPARING_PATHS, type PathId } from '../lib/taxonomy';
import { pt as t } from '../i18n/pt';

const o = t.home.objectives;
const superior = superiorCopyFor();
/** The ground of each path: a colour, never a meaning. */
const TONE: Record<PathId, string> = {
  'ensino-fundamental': 'peach',
  'ensino-medio': 'sky',
  vestibulares: 'blush',
  'ensino-superior': 'cream',
  tecnologia: 'sage',
  'pre-militar': 'sand',
};
---
<ul class="paths" role="list">
  {PATH_ORDER.map((id, i) => {
    const facts = objectiveFacts(id);
    const preparing = PREPARING_PATHS.includes(id);
    // Turned over: the middle card of each row (three columns), or cards 2-3 of every four (two columns).
    const flip3 = i % 3 === 1;
    const flip2 = i % 4 === 1 || i % 4 === 2;
    return (
      <li class:list={[flip2 && 'flip-2', flip3 && 'flip-3']}>
        <a href={routes.objective(id)} data-path-count={preparing ? undefined : facts.resources} class:list={['card', `tone-${TONE[id]}`, preparing && 'preparing']}>
          <span class="go" aria-hidden="true"><ArrowTopRightIcon width={18} height={18} /></span>
          <span class="art"><PathArt path={id} /></span>
          <span class="text">
            <span class="name">{OBJECTIVES[id].label}</span>
            <span class="what">{id === 'ensino-superior' ? superior.objective : o.items[id]}</span>
            <span class="pill">{preparing ? t.preparing.label : o.facts(facts.resources, facts.tracks)}</span>
          </span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .paths { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  @media (min-width: 640px) { .paths { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); } }
  @media (min-width: 1024px) { .paths { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); } }

  .tone-peach { --ground: var(--peach); --deep: var(--peach-deep); }
  .tone-sky { --ground: var(--sky); --deep: var(--sky-deep); }
  .tone-blush { --ground: var(--blush); --deep: var(--blush-deep); }
  .tone-cream { --ground: var(--cream); --deep: var(--cream-deep); }
  .tone-sage { --ground: var(--sage); --deep: var(--sage-deep); }
  .tone-sand { --ground: var(--sand); --deep: var(--sand-deep); }

  /* A phone: a compact row, the text beside a small cut-corner panel. */
  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 96px;
    grid-template-areas: "text art";
    align-items: center;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
    border-radius: 24px;
    background: var(--ground);
    color: var(--ink);
    text-decoration: none;
    transition: transform var(--t-ui) var(--ease), box-shadow var(--t-ui) var(--ease);
  }
  .art {
    grid-area: art;
    display: block;
    aspect-ratio: 1;
    padding: 10px;
    border-radius: 18px;
    background: var(--deep);
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 34% 100%, 0 66%);
  }
  .art :global(.path-art) { transition: transform 400ms var(--ease); }
  .text { grid-area: text; display: grid; justify-items: start; gap: var(--space-1); min-width: 0; }
  .pill {
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-2);
    padding: 2px 10px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .preparing .pill { border-color: var(--action); color: var(--action); }
  .name { font-family: var(--serif); font-size: 1.5rem; font-weight: 440; line-height: 1.05; letter-spacing: -0.02em; }
  .what { font-size: var(--fs-small); line-height: 1.45; color: var(--muted); }
  .go { display: none; }

  .card:hover { box-shadow: 0 18px 36px -28px rgb(29 33 37 / 0.45); transform: translateY(-2px); }
  .card:hover .art :global(.path-art) { transform: scale(1.03); }
  .card:focus-visible { outline: 2px solid var(--action); outline-offset: 3px; border-radius: 24px; }

  /* A tablet and up: a wide card. The panel at the top right, cut at its lower left corner; the arrow disc at
     the top left; the pill, the name and the line along the bottom. */
  @media (min-width: 640px) {
    .card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      grid-template-rows: auto 1fr auto;
      grid-template-areas: "go art" ". art" "text text";
      align-items: start;
      gap: var(--space-4) var(--space-4);
      padding: var(--space-4) var(--space-4) var(--space-5) var(--space-5);
      border-radius: 32px;
    }
    .go {
      grid-area: go;
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      margin-top: var(--space-1);
      border-radius: 50%;
      background: var(--raised);
      color: var(--ink);
      transition: background var(--t-ui), color var(--t-ui), transform var(--t-ui) var(--ease);
    }
    .card:hover .go { background: var(--action); color: var(--on-action); transform: translate(2px, -2px); }
    .art { aspect-ratio: 6 / 5; padding: var(--space-3) var(--space-4); border-radius: 22px; }
    .text { gap: var(--space-2); padding-top: var(--space-1); }
    .what { max-width: 36ch; }
    .name { font-size: clamp(1.625rem, 1.3rem + 0.8vw, 2rem); }
    .card:focus-visible { border-radius: 32px; }
    /* Turned over: the text above, the panel at the lower right cut at its upper left, the disc below left. */
    .flip-2 .card {
      grid-template-rows: auto 1fr auto;
      grid-template-areas: "text text" ". art" "go art";
      padding-top: var(--space-5);
    }
    .flip-2 .art { clip-path: polygon(34% 0, 100% 0, 100% 100%, 0 100%, 0 34%); }
    .flip-2 .go { align-self: end; margin: 0 0 var(--space-1); }
  }
  @media (min-width: 1024px) {
    .flip-2 .card { grid-template-areas: "go art" ". art" "text text"; padding-top: var(--space-4); }
    .flip-2 .art { clip-path: polygon(0 0, 100% 0, 100% 100%, 34% 100%, 0 66%); }
    .flip-2 .go { align-self: start; margin: var(--space-1) 0 0; }
    .flip-3 .card { grid-template-areas: "text text" ". art" "go art"; padding-top: var(--space-5); }
    .flip-3 .art { clip-path: polygon(34% 0, 100% 0, 100% 100%, 0 100%, 0 34%); }
    .flip-3 .go { align-self: end; margin: 0 0 var(--space-1); }
  }
</style>
