---
// "Qual é o seu objetivo?" on the Home (Home V1): the six paths as a compact grid of tiles. Each: the path
// in the serif, one line of what it holds, and what it really holds today, counted from the published
// catalogue at build time (objectiveFacts), never typed; a path in preparation says so instead. The whole
// tile is the link. /materias/ keeps its editorial index (ObjectiveList.astro).
import { objectiveFacts } from '../lib/learning-library';
import { routes } from '../lib/routes';
import { superiorCopyFor } from '../lib/superior-copy';
import { OBJECTIVES, PATH_ORDER, PREPARING_PATHS } from '../lib/taxonomy';
import { pt as t } from '../i18n/pt';

const o = t.home.objectives;
const superior = superiorCopyFor();
---
<ul class="paths" role="list">
  {PATH_ORDER.map((id) => {
    const facts = objectiveFacts(id);
    const preparing = PREPARING_PATHS.includes(id);
    return (
      <li>
        <a href={routes.objective(id)} data-path-count={preparing ? undefined : facts.resources} class:list={[preparing && 'preparing']}>
          <span class="name">{OBJECTIVES[id].label}</span>
          <span class="what">{id === 'ensino-superior' ? superior.objective : o.items[id]}</span>
          <span class="facts">{preparing ? <span class="tag">{t.preparing.label}</span> : o.facts(facts.resources, facts.tracks)}<span class="arrow" aria-hidden="true">→</span></span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .paths { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  @media (min-width: 560px) { .paths { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .paths { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); } }
  a {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--raised);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--t-ui), background var(--t-ui);
  }
  a:hover { border-color: var(--action); background: var(--paper); }
  .name { font-family: var(--serif); font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem); font-weight: 460; line-height: 1.1; letter-spacing: -0.015em; transition: color var(--t-ui); }
  a:hover .name { color: var(--action); }
  .what { font-size: var(--fs-small); line-height: 1.45; color: var(--muted); }
  .facts { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-2); padding-top: var(--space-3); border-top: 1px solid var(--rule); font-size: 0.8125rem; font-weight: 560; color: var(--ink); }
  .tag { font-size: 0.6875rem; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; color: var(--action); }
  .arrow { color: var(--muted); transition: transform var(--t-ui) var(--ease), color var(--t-ui); }
  a:hover .arrow { color: var(--action); transform: translateX(3px); }
  /* On a phone, a tile is a row: the description shortens to what the path is. */
  @media (max-width: 559px) { a { padding: var(--space-4); } }
</style>
