---
// "Escolha seu caminho" on the Home (V2): the six paths as expressive cards. Each: a soft ground of its own,
// an original illustration (PathArt) in a panel of the deeper tone, the path in the serif, one line of what it
// holds, and what it really holds today, counted from the published catalogue at build time (objectiveFacts),
// never typed; a path in preparation says so instead. The whole card is the link. The panels alternate above
// and below the text (a checkerboard on a grid of three, then of two), so six cards never read as six
// identical boxes; on a phone a card is a compact row. /materias/ keeps its editorial index (ObjectiveList.astro).
import PathArt from './PathArt.astro';
import ArrowTopRightIcon from './icons/radix/ArrowTopRightIcon.astro';
import { objectiveFacts } from '../lib/learning-library';
import { routes } from '../lib/routes';
import { superiorCopyFor } from '../lib/superior-copy';
import { OBJECTIVES, PATH_ORDER, PREPARING_PATHS, type PathId } from '../lib/taxonomy';
import { pt as t } from '../i18n/pt';

const o = t.home.objectives;
const superior = superiorCopyFor();
/** The soft ground of each path: a colour, never a meaning. */
const TONE: Record<PathId, string> = {
  'ensino-fundamental': 'peach',
  'ensino-medio': 'sky',
  vestibulares: 'blush',
  'ensino-superior': 'cream',
  tecnologia: 'sage',
  'pre-militar': 'sand',
};
---
<ul class="paths" role="list">
  {PATH_ORDER.map((id, i) => {
    const facts = objectiveFacts(id);
    const preparing = PREPARING_PATHS.includes(id);
    // The panel goes under the text on a checkerboard: on two columns, cards 2-3 of every four; on three,
    // where row and column differ in parity.
    const under2 = i % 4 === 1 || i % 4 === 2;
    const under3 = (Math.floor(i / 3) + (i % 3)) % 2 === 1;
    return (
      <li class:list={[under2 && 'under-2', under3 && 'under-3']}>
        <a href={routes.objective(id)} data-path-count={preparing ? undefined : facts.resources} class:list={['card', `tone-${TONE[id]}`, preparing && 'preparing']}>
          <span class="art"><PathArt path={id} /></span>
          <span class="text">
            <span class="name">{OBJECTIVES[id].label}</span>
            <span class="what">{id === 'ensino-superior' ? superior.objective : o.items[id]}</span>
            <span class="facts">{preparing ? <span class="tag">{t.preparing.label}</span> : o.facts(facts.resources, facts.tracks)}</span>
          </span>
          <span class="go" aria-hidden="true"><ArrowTopRightIcon width={18} height={18} /></span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .paths { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  @media (min-width: 640px) { .paths { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); } }
  @media (min-width: 1024px) { .paths { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); } }

  .tone-peach { --ground: var(--peach); --deep: var(--peach-deep); }
  .tone-sky { --ground: var(--sky); --deep: var(--sky-deep); }
  .tone-blush { --ground: var(--blush); --deep: var(--blush-deep); }
  .tone-cream { --ground: var(--cream); --deep: var(--cream-deep); }
  .tone-sage { --ground: var(--sage); --deep: var(--sage-deep); }
  .tone-sand { --ground: var(--tint-sand); --deep: var(--sand-deep); }

  /* A phone: a compact row, the text beside a small panel. */
  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 88px;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-4);
    border-radius: 22px;
    background: var(--ground);
    color: var(--ink);
    text-decoration: none;
    transition: transform var(--t-ui) var(--ease), box-shadow var(--t-ui) var(--ease);
  }
  .art { order: 2; display: block; aspect-ratio: 1; padding: 8px; border-radius: 16px 16px 16px 34px; background: var(--deep); overflow: hidden; }
  .art :global(.path-art) { transition: transform 400ms var(--ease); }
  .text { display: grid; gap: var(--space-1); min-width: 0; }
  .name { font-family: var(--serif); font-size: 1.375rem; font-weight: 460; line-height: 1.1; letter-spacing: -0.015em; }
  .what { font-size: var(--fs-small); line-height: 1.45; color: var(--muted); }
  .facts { margin-top: var(--space-1); font-size: 0.8125rem; font-weight: 600; color: var(--ink); }
  .tag { font-size: 0.6875rem; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; color: var(--action); }
  .go { display: none; }

  .card:hover { box-shadow: 0 18px 36px -24px rgb(29 33 37 / 0.45); transform: translateY(-2px); }
  .card:hover .art :global(.path-art) { transform: scale(1.04); }
  .card:hover .name { color: var(--action); }
  .card:focus-visible { outline: 2px solid var(--action); outline-offset: 3px; border-radius: 22px; }

  /* A tablet and up: a tall card, the panel wide, the arrow in a white disc at the top corner. */
  @media (min-width: 640px) {
    .card { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; align-items: stretch; gap: var(--space-5); padding: var(--space-4) var(--space-4) var(--space-5); border-radius: 26px; }
    .art { order: 0; aspect-ratio: 16 / 10; padding: var(--space-4) var(--space-6); border-radius: 18px 18px 18px 56px; }
    .text { align-content: start; gap: var(--space-2); padding-inline: var(--space-2); }
    .name { font-size: clamp(1.5rem, 1.25rem + 0.7vw, 1.875rem); padding-right: 2.75rem; }
    .facts { margin-top: var(--space-2); }
    .go {
      position: absolute;
      top: var(--space-5);
      right: var(--space-5);
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--raised);
      color: var(--ink);
      transition: background var(--t-ui), color var(--t-ui), transform var(--t-ui) var(--ease);
    }
    .card:hover .go { background: var(--action); color: var(--on-action); transform: translate(2px, -2px); }
  }
  /* The panel under the text, on a checkerboard of two columns, then of three. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .under-2 .art { order: 2; border-radius: 18px 56px 18px 18px; }
    .under-2 .card { grid-template-rows: 1fr auto; padding-top: var(--space-5); }
  }
  @media (min-width: 1024px) {
    .under-3 .art { order: 2; border-radius: 18px 56px 18px 18px; }
    .under-3 .card { grid-template-rows: 1fr auto; padding-top: var(--space-5); }
  }
</style>
