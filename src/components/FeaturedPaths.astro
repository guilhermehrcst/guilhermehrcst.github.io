---
// "Comece por um caminho pronto." (Home V2: compact, the steps on a rail): at most three ready paths, each real and complete. The ENEM and UERJ
// guides, with their own sections as steps (resolveGuide, the same data as their pages), and the first
// technology track, with its courses in order (resourcesByIds fails the build on an unknown id).
// Nothing is filled in for the design: a step is a section or a course that exists today.
import { resolveGuide } from '../lib/exam-guides';
import { resourcesByIds } from '../lib/learning-library';
import { publishedResources } from '../lib/learning-resources';
import { routes } from '../lib/routes';
import { publishedTracks } from '../lib/tech-tracks';
import { pt as t } from '../i18n/pt';

const f = t.home.tracks;
const g = t.guides;
const [track] = publishedTracks();
if (!track) throw new Error('FeaturedPaths: no published technology track');

const paths = [
  {
    id: 'enem',
    kind: f.kinds.guide,
    title: f.titles.enem,
    why: f.why.enem,
    steps: resolveGuide('enem').map((section) => g.enem[section.id as keyof typeof g.enem].title),
    href: routes.objective('enem'),
    link: f.links.enem,
    tone: 'brand',
  },
  {
    id: 'uerj',
    kind: f.kinds.guide,
    title: f.titles.uerj,
    why: f.why.uerj,
    steps: resolveGuide('uerj').map((section) => g.uerj[section.id as keyof typeof g.uerj].title),
    href: routes.objective('uerj'),
    link: f.links.uerj,
    tone: 'sand',
  },
  {
    id: track.id,
    kind: f.kinds.track,
    title: track.label,
    why: track.why,
    steps: resourcesByIds(publishedResources, track.resourceIds).map((r) => r.title),
    href: `${routes.objective('tecnologia')}#${track.id}`,
    link: f.links.track,
    tone: 'ink',
    noTranslate: true,
  },
];
const SHOWN = 3;
---
<div class="paths">
  {paths.map((path) => (
    <article class:list={['path', `tone-${path.tone}`]} data-featured={path.id} aria-labelledby={`trilha-${path.id}`}>
      <p class="kind">{path.kind} · {f.steps(path.steps.length)}</p>
      <h3 id={`trilha-${path.id}`}>{path.title}</h3>
      <p class="why">{path.why}</p>
      <ol class="steps" role="list">
        {path.steps.slice(0, SHOWN).map((step, i) => (
          <li><span class="n" aria-hidden="true">{i + 1}</span><span translate={path.noTranslate ? 'no' : undefined}>{step}</span></li>
        ))}
      </ol>
      {path.steps.length > SHOWN && <p class="more">{f.more(path.steps.length - SHOWN)}</p>}
      <a href={path.href}>{path.link}{' '}<span aria-hidden="true">→</span></a>
    </article>
  ))}
</div>

<style>
  .paths { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  @media (min-width: 900px) { .paths { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* A ready path: a paper card with the kind, the title, one line of why, and its first steps on a rail. */
  .path {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto auto;
    padding: var(--space-5);
    background: var(--raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    transition: border-color var(--t-ui), box-shadow var(--t-ui);
  }
  .path:hover { border-color: var(--rule-strong); box-shadow: 0 16px 32px -26px rgb(29 33 37 / 0.4); }
  .tone-brand { --dot: var(--brand); }
  .tone-sand { --dot: var(--cream-deep); }
  .tone-ink { --dot: var(--sage-deep); }
  .kind { display: flex; align-items: center; gap: var(--space-2); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .kind::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--dot); }
  h3 { margin-top: var(--space-2); font-family: var(--serif); font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.625rem); font-weight: 460; line-height: 1.1; letter-spacing: -0.015em; }
  .why { margin-top: var(--space-2); font-size: var(--fs-small); color: var(--muted); }
  .steps { position: relative; display: grid; gap: var(--space-2); margin-top: var(--space-4); align-self: start; }
  .steps::before { content: ''; position: absolute; left: 0.6875rem; top: 0.5rem; bottom: 0.5rem; width: 1px; background: var(--rule-strong); }
  .steps li { position: relative; display: flex; align-items: baseline; gap: var(--space-3); font-size: 0.9375rem; line-height: 1.4; }
  .n { flex: none; display: inline-grid; place-items: center; width: 1.375rem; height: 1.375rem; border: 1px solid var(--rule-strong); border-radius: 50%; background: var(--raised); font-size: 0.6875rem; font-weight: 650; font-variant-numeric: tabular-nums; color: var(--ink); }
  .more { margin-top: var(--space-2); padding-left: calc(1.375rem + var(--space-3)); font-size: 0.8125rem; color: var(--muted); }
  .path > a { display: inline-flex; align-items: center; gap: 0.35em; min-height: 44px; margin-top: var(--space-3); font-weight: 560; }
  .path > a span { transition: transform var(--t-ui) var(--ease); }
  .path > a:hover span { transform: translateX(3px); }
</style>
