---
import Label from './Label.astro';
import ContactIcon from './ContactIcon.astro';
import { dicts } from '../i18n/routes';
import type { Lang } from '../i18n/types';

interface Props { lang: Lang }
const t = dicts[Astro.props.lang].contact;
---
<section class="contact" id="contact" aria-labelledby="contact-heading">
  <div class="grid">
    <Label text={t.label} class="c-label" />
    <h2 id="contact-heading" class="sr-only">{t.heading}</h2>
  </div>
  <ul>
    {t.items.map((c) => (
      <li>
        <a class="row grid" href={c.href}>
          <span class="meta c-k">{c.label}</span>
          <span class="c-v">
            <span class="c-i"><ContactIcon name={c.icon} /></span>
            <span class="c-t">{c.value}</span>
          </span>
          <span class="c-a" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4.5 19.5 19.5 4.5M8.5 4.5h11v11" /></svg>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .contact { padding-block: calc(var(--space-section) * 0.4) var(--space-section); }
  .c-label { grid-column: 1 / -1; margin-bottom: clamp(24px, 3vw, 40px); }
  li { border-top: 1px solid var(--rule); }
  li:last-child { border-bottom: 1px solid var(--rule); }
  .row {
    align-items: baseline;
    padding-block: clamp(14px, 1.8vw, 26px);
    text-decoration: none;
  }
  .c-k { grid-column: 1 / span 3; color: var(--muted); }
  .c-v {
    grid-column: 4 / span 8;
    display: flex;
    align-items: baseline;
    gap: clamp(14px, 1.5vw, 24px);
    font-size: clamp(1.5rem, 3.1vw, 3.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    transition: color var(--t-fast) linear;
  }
  /* Fixed slot: every row's text starts at the same x, whatever the glyph. */
  /* Only the text takes part in baseline alignment, so the row keeps exactly the
     geometry it had before the icons; the icon is centred on the text line. */
  .c-i { flex: none; align-self: center; width: 24px; height: 24px; display: grid; place-items: center; }
  /* Fit the longest side to the slot; Gmail is wider than tall, the others square. */
  .c-i :global(.ci) { max-width: 100%; max-height: 100%; width: auto; height: auto; }
  .c-t { min-width: 0; align-self: baseline; overflow-wrap: anywhere; }
  /* External-link arrow: an inline SVG, never a glyph (iOS and Safari substitute an emoji
     for U+2197). Quiet at rest, blue and nudged 2px only on hover and keyboard focus.
     It stays an ordinary line box with the old glyph's font-size and line-height, so it keeps
     taking part in the row's baseline alignment and the row geometry is unchanged. */
  .c-a {
    --t-arrow: 180ms;
    grid-column: 12;
    justify-self: end;
    font-size: clamp(1.25rem, 2vw, 2rem);
    color: var(--ink);
    opacity: 0.5;
    transition: color var(--t-arrow) var(--ease), opacity var(--t-arrow) var(--ease);
  }
  .c-a svg {
    display: inline-block;
    vertical-align: middle;
    position: relative;
    top: -0.2em; /* the x-height middle sits below the line box centre; lift the arrow onto it */
    width: 20px;
    height: 20px;
    max-width: none; /* the global svg reset caps width at the container, which would squash it */
    /* The drawn arrow ends ~3px inside its box; pull it out so its ink meets the grid edge. */
    margin-right: -3.1px;
    transition: transform var(--t-arrow) var(--ease);
  }
  .row:hover .c-v, .row:focus-visible .c-v { color: var(--signal); }
  .row:hover .c-a, .row:focus-visible .c-a { color: var(--signal); opacity: 1; }
  .row:hover .c-a svg, .row:focus-visible .c-a svg { transform: translate(2px, -2px); }
  /* The row spans the viewport edge to edge; keep the focus ring inside it. */
  .row:focus-visible { outline-offset: -2px; }
  @media (max-width: 1024px) {
    .c-k { grid-column: 1 / span 2; }
    .c-v { grid-column: 3 / span 3; }
    .c-a { grid-column: 6; }
  }
  @media (max-width: 640px) {
    .c-k { grid-column: 1 / span 3; grid-row: 1; margin-bottom: 8px; }
    .c-a { grid-column: 4; grid-row: 1; font-size: 1.125rem; }
    /* On mobile the arrow shares a line with the small mono label, so it centres on that instead. */
    .c-a svg { width: 18px; height: 18px; margin-right: -2.8px; top: 0.07em; }
    .c-v { grid-column: 1 / -1; grid-row: 2; gap: 12px; font-size: clamp(1.25rem, 6vw, 1.75rem); }
    .c-i { width: 20px; height: 20px; }
    .c-t { overflow-wrap: normal; }
  }
</style>
