---
// "Qual é o seu objetivo?": the five ways in, in the Home's order (spec §5.2, item 2). An editorial index:
// a number, the objective in the serif, one line of what the student will find, and what it really holds
// today (counted from the catalogue at build time, never typed).
import { objectiveFacts } from '../lib/learning-library';
import { routes } from '../lib/routes';
import { OBJECTIVES, PATH_ORDER, PREPARING_PATHS } from '../lib/taxonomy';
import { pt as t } from '../i18n/pt';

const o = t.home.objectives;
---
<ol class="objectives" role="list">
  {PATH_ORDER.map((id, i) => {
    const facts = objectiveFacts(id);
    return (
      <li>
        <a href={routes.objective(id)}>
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="name">{OBJECTIVES[id].label}</span>
          <span class="what">{o.items[id]}</span>
          <span class="facts">{PREPARING_PATHS.includes(id) ? t.preparing.label : o.facts(facts.resources, facts.tracks)}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .objectives { border-bottom: 1px solid var(--rule-strong); }
  li { border-top: 1px solid var(--rule-strong); }
  li + li { border-top-color: var(--rule); }
  a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    grid-template-areas:
      'num name arrow'
      '.   what arrow'
      '.   facts arrow';
    align-items: baseline;
    column-gap: var(--space-4);
    padding-block: var(--space-5);
    text-decoration: none;
    color: var(--ink);
    transition: background var(--t-ui);
  }
  .num { grid-area: num; font-size: var(--fs-small); font-variant-numeric: tabular-nums; color: var(--muted); }
  .name {
    grid-area: name;
    font-family: var(--serif);
    font-size: var(--fs-h2);
    font-weight: 460;
    letter-spacing: -0.02em;
    line-height: 1.1;
    transition: color var(--t-ui);
  }
  .what { grid-area: what; margin-top: var(--space-2); max-width: 48ch; color: var(--muted); }
  .facts { grid-area: facts; margin-top: var(--space-2); font-size: var(--fs-small); font-weight: 500; color: var(--ink); }
  .arrow {
    grid-area: arrow;
    align-self: center;
    font-size: var(--fs-h3);
    color: var(--muted);
    transition: transform var(--t-ui) var(--ease), color var(--t-ui);
  }
  a:hover .name, a:focus-visible .name { color: var(--action); }
  a:hover .arrow, a:focus-visible .arrow { color: var(--action); transform: translateX(4px); }

  @media (min-width: 900px) {
    a {
      grid-template-columns: 3rem minmax(0, 5fr) minmax(0, 5fr) 10rem 2rem;
      align-items: center;
      grid-template-areas: 'num name what facts arrow';
      padding-block: var(--space-6);
      padding-inline: var(--space-2);
    }
    .what, .facts { margin-top: 0; }
    /* One line per name: the longest, "Ensino Fundamental", sets the size. */
    .name { font-size: min(var(--fs-h2), 2.5rem, 3vw); white-space: nowrap; }
    .facts { text-align: right; white-space: nowrap; color: var(--muted); }
    a:hover { background: var(--surface); }
  }
</style>
