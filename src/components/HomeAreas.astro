---
// "Explore por área" on the Home (Home V1): the six areas of the taxonomy as a compact grid, each with its
// subjects as small links to their real pages, in order. /materias/ keeps its full list (AreaList.astro).
// verify-dist reads each [data-area] element: no nested div inside it.
import { routes } from '../lib/routes';
import { AREA_ORDER, AREAS, SUBJECTS, subjectsOf } from '../lib/taxonomy';

const areas = AREA_ORDER.map((id) => ({ id, label: AREAS[id].label, subjects: subjectsOf(id) }));
---
<ul class="areas" role="list">
  {areas.map((area) => (
    <li>
      <div class="area" data-area={area.id}>
        <h3 class="name">{area.label}</h3>
        <ul class="subjects" role="list">
          {area.subjects.map((id) => <li><a href={routes.subject(id)}>{SUBJECTS[id].label}</a></li>)}
        </ul>
      </div>
    </li>
  ))}
</ul>

<style>
  .areas { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  @media (min-width: 560px) { .areas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .areas { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); } }
  .area { display: grid; align-content: start; gap: var(--space-3); height: 100%; padding: var(--space-4) var(--space-5) var(--space-5); border-radius: var(--radius-lg); background: var(--surface); }
  .name { font-family: var(--serif); font-size: 1.375rem; font-weight: 460; letter-spacing: -0.01em; }
  .subjects { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .subjects a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-4);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--raised);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--t-ui), color var(--t-ui);
  }
  .subjects a:hover { border-color: var(--action); color: var(--action); }
</style>
