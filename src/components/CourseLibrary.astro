---
// The course grid of /cursos/ (V0.6): path filters, then every published course as a card. The filters are
// native radio buttons and the grid answers them in CSS (:has), so they work by touch, mouse and keyboard
// with no JavaScript. Where :has is not supported, every course stays visible: the safe state. A filter is
// offered only for a path that holds courses, so none comes back empty.
import CourseCard from './CourseCard.astro';
import { courseCards, courseFilterPaths } from '../lib/course-library';
import { OBJECTIVES } from '../lib/taxonomy';
import { pt as t } from '../i18n/pt';

const cards = courseCards();
const paths = courseFilterPaths(cards);
const c = t.courseLibrary;
const count = (path: string) => cards.filter((card) => (card.paths as string[]).includes(path)).length;
---
{cards.length === 0 ? (
  <p class="wrap empty" data-library-empty>{c.empty}</p>
) : (
  <section class="wrap library" aria-labelledby="catalogo-title" data-course-library>
    <h2 id="catalogo-title" class="sr-only">{c.catalogue}</h2>
    <fieldset class="filters" data-course-filters>
      <legend class="sr-only">{c.filterLegend}</legend>
      <span class="chip">
        <input type="radio" name="caminho" id="caminho-todos" value="todos" checked />
        <label for="caminho-todos">{c.all} <span class="n">{cards.length}</span></label>
      </span>
      {paths.map((path) => (
        <span class="chip">
          <input type="radio" name="caminho" id={`caminho-${path}`} value={path} />
          <label for={`caminho-${path}`}>{OBJECTIVES[path].label} <span class="n">{count(path)}</span></label>
        </span>
      ))}
    </fieldset>
    <ul class="grid" role="list" data-resource-list data-course-grid>
      {cards.map((card, i) => <CourseCard card={card} eager={i < 3} />)}
    </ul>
  </section>
)}

<style>
  .library { padding-bottom: var(--space-8); }
  .empty { padding-block: var(--space-6) var(--space-8); color: var(--muted); }

  /* The filters: a row of chips that scrolls sideways on a phone, wraps from a tablet up. */
  .filters {
    display: flex;
    gap: var(--space-2);
    margin: 0 calc(-1 * var(--gutter)) var(--space-6);
    padding: 2px var(--gutter) var(--space-2);
    min-width: 0;
    border: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .filters::-webkit-scrollbar { display: none; }
  @media (min-width: 600px) { .filters { flex-wrap: wrap; overflow: visible; margin-inline: 0; padding-inline: 0; } }
  .chip { position: relative; flex: none; }
  /* The radio stays in the accessibility tree and takes focus; its label is the chip. */
  .chip input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .chip label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-4);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--raised);
    font-size: 0.9375rem;
    font-weight: 560;
    color: var(--ink);
    white-space: nowrap;
    transition: background var(--t-ui), color var(--t-ui), border-color var(--t-ui);
  }
  .chip label .n { font-weight: 500; color: var(--muted); font-variant-numeric: tabular-nums; }
  .chip input:hover + label { border-color: var(--ink); }
  .chip input:checked + label { background: var(--brand); border-color: var(--brand); color: var(--on-brand); }
  .chip input:checked + label .n { color: var(--on-brand-muted); }
  .chip input:focus-visible + label { outline: 2px solid var(--action); outline-offset: 3px; }

  /* The grid: one column on a phone, two on a tablet, three on a desktop. */
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6) var(--space-5); }
  @media (min-width: 600px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* A chosen path hides the courses that do not serve it. */
  .library:has(#caminho-ensino-fundamental:checked) .grid > :global(li:not([data-paths~='ensino-fundamental'])),
  .library:has(#caminho-ensino-medio:checked) .grid > :global(li:not([data-paths~='ensino-medio'])),
  .library:has(#caminho-vestibulares:checked) .grid > :global(li:not([data-paths~='vestibulares'])),
  .library:has(#caminho-pre-militar:checked) .grid > :global(li:not([data-paths~='pre-militar'])),
  .library:has(#caminho-ensino-superior:checked) .grid > :global(li:not([data-paths~='ensino-superior'])),
  .library:has(#caminho-tecnologia:checked) .grid > :global(li:not([data-paths~='tecnologia'])) { display: none; }
</style>
