---
// The course grid of /cursos/ (V0.7, the video library; Global Navigation V1): a row of path chips under the
// header, then every published course as a video-style card. Each chip is a link to a shareable URL, the
// same the header's menus use (src/lib/global-nav.ts): the path in the query, the view in the fragment. The
// view is an element of this page, and the grid answers it in CSS (:target with :has): no JavaScript, no
// page per path. The view titles itself and, for a path with no course yet, says so. Where :has is not
// supported, every course stays visible and no view shows: the safe state.
import CourseCard from './CourseCard.astro';
import { COURSE_FILTER_ORDER, courseCards } from '../lib/course-library';
import { libraryViews, viewHref } from '../lib/global-nav';
import { routes } from '../lib/routes';
import { OBJECTIVES } from '../lib/taxonomy';
import { pt as t } from '../i18n/pt';

const cards = courseCards();
const views = libraryViews('cursos');
const c = t.courseLibrary;
---
{cards.length === 0 ? (
  <p class="none" data-library-empty>{c.empty}</p>
) : (
  <section class="library" aria-labelledby="catalogo-title" data-course-library>
    <h2 id="catalogo-title" class="sr-only">{c.catalogue}</h2>
    <nav class="filters" aria-label={c.filterLegend} data-course-filters>
      <ul role="list">
        <li><a class="chip" href={routes.courses} data-filter="tudo"><span>{c.all}</span></a></li>
        {COURSE_FILTER_ORDER.map((path) => (
          <li><a class="chip" href={viewHref('cursos', path)} data-filter={path} aria-label={`${t.nav.types.cursos.label} ${t.nav.of(OBJECTIVES[path].label)}`}><span>{OBJECTIVES[path].label}</span></a></li>
        ))}
      </ul>
    </nav>
    {views.map((view) => (
      <div class="view" id={view.id} data-view-path={view.path} data-view-type={view.type}>
        <h3 class="view-title">{c.view(OBJECTIVES[view.path].label, view.count)}</h3>
        {view.count === 0 && <p class="empty" data-empty-for={view.path}>{c.emptyPath(OBJECTIVES[view.path].label)}</p>}
      </div>
    ))}
    <ul class="grid" role="list" data-resource-list data-course-grid>
      {cards.map((card, i) => <CourseCard card={card} eager={i < 3} />)}
    </ul>
  </section>
)}

<style>
  .library { --side: var(--library-side, 12px); padding: 0 var(--side) var(--space-7); }
  .none { padding: var(--space-6) 16px; color: var(--muted); }

  /* The chips: one row under the header, sticky with it, scrolling sideways when it overflows. */
  .filters {
    position: sticky;
    top: 65px;
    z-index: 20;
    display: flex;
    gap: 10px;
    min-width: 0;
    margin: 0 calc(-1 * var(--side)) 0;
    padding: 10px var(--side) 12px;
    border: 0;
    background: var(--paper);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .filters::-webkit-scrollbar { display: none; }
  .filters ul { display: flex; gap: 10px; }
  .filters li { flex: none; }
  /* The link is the target: 44px tall for touch, around a 30px capsule. */
  .chip { display: flex; align-items: center; min-height: 44px; margin-block: -7px; text-decoration: none; }
  .chip span {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding-inline: 11px;
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background var(--t-ui), color var(--t-ui);
  }
  .chip:hover span { background: var(--tint-sand); }
  .chip:focus-visible { outline: none; }
  .chip:focus-visible span { outline: 2px solid var(--action); outline-offset: 2px; }

  /* The grid: the thumbnail spans its column; 1 column on a phone, 2 on a narrow tablet or an iPad held
     upright, 3 on an iPad held sideways and a laptop, 4 on a large desktop. */
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px 10px; padding-top: 4px; }
  @media (min-width: 560px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 10px; } }
  @media (min-width: 1280px) { .grid { gap: 36px 16px; } }
  @media (min-width: 900px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1440px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  /* A view: its title under the chips, clear of the sticky header and chips when the page opens on it. */
  .view { display: none; scroll-margin-top: 140px; padding: var(--space-3) 0 var(--space-4); }
  .view-title { font-size: 1rem; font-weight: 650; line-height: 1.3; }
  .empty { max-width: var(--measure); padding-block: var(--space-4) var(--space-6); color: var(--muted); }

  /* The chosen chip: "Tudo" without a view, else the view's path. A view hides the courses that do not serve
     its path. Only where :has exists; elsewhere the whole library shows and no view claims otherwise. */
  @supports selector(:has(*)) {
    .view:target { display: block; }
    .library:not(:has(.view:target)) .chip[data-filter='tudo'] span,
    .library:has(#cursos-ensino-fundamental:target) .chip[data-filter='ensino-fundamental'] span,
    .library:has(#cursos-ensino-medio:target) .chip[data-filter='ensino-medio'] span,
    .library:has(#cursos-vestibulares:target) .chip[data-filter='vestibulares'] span,
    .library:has(#cursos-ensino-superior:target) .chip[data-filter='ensino-superior'] span,
    .library:has(#cursos-tecnologia:target) .chip[data-filter='tecnologia'] span,
    .library:has(#cursos-pre-militar:target) .chip[data-filter='pre-militar'] span { background: var(--brand); color: var(--on-brand); }
    .library:has(#cursos-ensino-fundamental:target) .grid > :global(li:not([data-paths~='ensino-fundamental'])),
    .library:has(#cursos-ensino-medio:target) .grid > :global(li:not([data-paths~='ensino-medio'])),
    .library:has(#cursos-vestibulares:target) .grid > :global(li:not([data-paths~='vestibulares'])),
    .library:has(#cursos-ensino-superior:target) .grid > :global(li:not([data-paths~='ensino-superior'])),
    .library:has(#cursos-tecnologia:target) .grid > :global(li:not([data-paths~='tecnologia'])),
    .library:has(#cursos-pre-militar:target) .grid > :global(li:not([data-paths~='pre-militar'])) { display: none; }
  }
</style>
