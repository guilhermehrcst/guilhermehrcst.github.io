---
// A list of free resources. One column on a phone, two from a tablet up: a reading list, not a grid
// of cards.
import ResourceItem from './ResourceItem.astro';
import type { PublishedLearningResource } from '../lib/learning-resources';

/** anchored: the ids this list anchors (#recurso-<id>), from anchorPlan on the resources' home page. */
interface Props { resources: readonly PublishedLearningResource[]; headingLevel?: 2 | 3 | 4; compact?: boolean; anchored?: ReadonlySet<string> | undefined }
const { resources, headingLevel = 3, compact = false, anchored } = Astro.props;
---
<ul class="resources" role="list" data-resource-list>
  {resources.map((resource) => <ResourceItem resource={resource} headingLevel={headingLevel} compact={compact} anchor={anchored?.has(resource.id) ?? false} />)}
</ul>

<style>
  .resources { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: var(--space-7); }
  @media (min-width: 768px) { .resources { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
