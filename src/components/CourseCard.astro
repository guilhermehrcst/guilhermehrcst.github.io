---
// One course of the library (V0.6), in the manner of a video grid: the 16:9 thumbnail leads, then the title
// (up to three lines), who offers it, and one line of verified facts: its paths, its format, its language
// when not Portuguese, its duration when the source states one. The whole card is one link, the title's
// (stretched over the card): to the course's own page when it has a presentation, else to its source, in a
// new tab. The same item contract as every resource list (verify-dist): data-resource-id, one link,
// the official title untranslated.
import CourseThumb from './CourseThumb.astro';
import ExternalLinkIcon from './icons/radix/ExternalLinkIcon.astro';
import type { CourseCardData } from '../lib/course-library';
import { presentationOf } from '../lib/course-presentations';
import { routes } from '../lib/routes';
import { OBJECTIVES } from '../lib/taxonomy';
import { pt as t } from '../i18n/pt';

interface Props { card: CourseCardData; headingLevel?: 2 | 3; eager?: boolean }
const { card, headingLevel = 3, eager = false } = Astro.props;
const { resource: r } = card;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const l = t.resource;
const page = presentationOf(r.id) ? routes.course(r.id) : null;
const facts = [
  card.paths.map((path) => OBJECTIVES[path].label).join(', '),
  l.formats[r.format],
  r.language === 'pt' ? null : l.languages[r.language],
  r.duration ? `${r.duration.value} ${l.units[r.duration.unit]}` : null,
].filter((fact): fact is string => Boolean(fact));
---
<li class="course" data-resource-id={r.id} data-format={r.format} data-subject={r.subject} data-paths={r.paths.join(' ')}>
  <CourseThumb resource={r} label={card.thumbLabel} eager={eager} />
  <div class="text">
    <Heading class="title">
      {page ? (
        <a href={page}><span translate="no">{r.title}</span></a>
      ) : (
        <a href={r.url} target="_blank" rel="noopener noreferrer">
          <span translate="no">{r.title}</span><ExternalLinkIcon class="out" /><span class="sr-only"> ({l.newTab})</span>
        </a>
      )}
    </Heading>
    <p class="by" translate="no">{r.provider}</p>
    <p class="facts">{facts.join(' · ')}</p>
  </div>
</li>

<style>
  .course { position: relative; display: grid; align-content: start; gap: var(--space-3); }
  .course :global(.thumb) { transition: transform var(--t-ui) var(--ease), box-shadow var(--t-ui) var(--ease); }
  .course:hover :global(.thumb) { transform: translateY(-2px); box-shadow: 0 14px 30px -22px rgb(29 33 37 / 0.45); }
  @media (prefers-reduced-motion: reduce) { .course:hover :global(.thumb) { transform: none; } }
  .text { display: grid; gap: 4px; padding-inline: 2px; }
  .title {
    font-family: var(--sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .title a { color: var(--ink); text-decoration: none; }
  /* The title's link covers the card: thumbnail and text are one target. */
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius-lg); }
  .title a:focus-visible { outline: none; }
  .course:has(a:focus-visible) { outline: 2px solid var(--action); outline-offset: 6px; border-radius: var(--radius-lg); }
  .course:hover .title a { color: var(--action); }
  .title :global(.out) { display: inline; width: 0.8em; height: 0.8em; margin-left: 0.3em; vertical-align: -0.02em; color: var(--muted); }
  .by { font-size: var(--fs-small); font-weight: 500; color: var(--ink); opacity: 0.86; }
  .facts { font-size: var(--fs-small); color: var(--muted); }
</style>
