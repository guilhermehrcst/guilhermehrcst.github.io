---
// One course in the catalogue grid. Not a floating card: a cell of the grid, sharing its hairlines
// with its neighbours. Two variants:
//   feature  curator's pick: a typographic plate (the course's short name, set large), then the facts.
//            When the course declares an image (lib/courses.ts) the cell is composed around it: the
//            image sits in the grid, touching its hairlines, and the plate becomes the cell's head.
//            `layout` says how (opening, media-right, tile, half, tall, band); phone and tablet
//            re-compose each one.
//   compact  the facts only
// The call to action is a solid blue button inset in the cell's foot (the one primary action of
// the cell): it opens the institution's own page in a new tab.
import { Picture } from 'astro:assets';
import CourseProvider from './CourseProvider.astro';
import ExternalLinkIcon from './icons/radix/ExternalLinkIcon.astro';
import type { Course, CourseImageLayout } from '../lib/courses';
import type { CoursesPage } from '../i18n/types';

interface Props {
  course: Course & { url: string };
  t: CoursesPage;
  /** Position in the catalogue, shown on the plate. */
  n: number;
  /** Optional anchor id (the nav's "Data" stop lands on the first data course). */
  anchor?: string | undefined;
  /** The cell spans the whole row: plate and body sit side by side instead of stacked. */
  wide?: boolean;
  style?: string;
}

const { course: c, t, n, anchor, wide = false, style } = Astro.props;
const facts: [string, string][] = [
  [t.labels.category, t.categories[c.category]],
  [t.labels.level, t.levels[c.level]],
  [t.labels.language, t.languages[c.language]],
];
if (c.duration) facts.push([t.labels.duration, `${c.duration.value} ${c.duration.unit === 'hours' ? t.units.hours : t.units.weeks}`]);
if (c.certificate) facts.push([t.labels.certificate, t.certificates[c.certificate]]);
const titleId = `course-${c.id}`;

const img = c.curated?.image;
// Sizes the browser picks from, per layout: the cell's share of the window at each width.
const sizes: Record<CourseImageLayout, string> = {
  opening: '(min-width: 1025px) calc(100vw - 72px), 100vw',
  'media-right': '(min-width: 1025px) 38vw, (min-width: 641px) 56vw, 100vw',
  tile: '(min-width: 1025px) 40vw, 100vw',
  half: '(min-width: 1025px) 64vw, 100vw',
  tall: '(min-width: 1025px) 32vw, (min-width: 641px) 40vw, 100vw',
  band: '(min-width: 1025px) 62vw, 100vw',
};
// Never upscale: the supplied files are the largest we have, so the last width is the file's own.
const widths = img ? [...[480, 768, 1152].filter((w) => w < img.src.width), img.src.width] : [];
const mediaStyle = img ? `${img.ratio ? `--ar: ${img.ratio}; ` : ''}--pos: ${img.position ?? '50% 50%'}` : undefined;
---
<li class:list={['cc rv', c.curated ? 'cc-f' : 'cc-c', wide && !img && 'is-wide', img && ['has-img', `lay-${img.layout}`, `k-${img.kind}`]]} id={anchor} style={style} data-reveal>
  {img && (
    <figure class="media" style={mediaStyle}>
      <Picture
        src={img.src}
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        quality={85}
        widths={widths}
        sizes={sizes[img.layout]}
        alt={t.imageAlts[img.alt]}
        loading={img.priority ? 'eager' : 'lazy'}
        decoding="async"
      />
    </figure>
  )}
  {c.curated && (
    <div class="plate" aria-hidden="true">
      <p class="meta pl-top"><span class="pl-pick"><span class="slash">/</span>{t.labels.curated}</span><span>{String(n).padStart(2, '0')}</span></p>
      <p class="pl-mark" style={`--len: ${[...c.curated.plate].length}`}>{c.curated.plate}<span class="slash">/</span></p>
    </div>
  )}
  <div class="cc-body">
    <p class="meta cc-top">
      <CourseProvider name={c.institution} />
      {c.curated && <span class="sr-only">{t.labels.curated}</span>}
    </p>
    <h3 class="cc-title" id={titleId}>{c.title}</h3>
    <dl class="cc-facts">
      {facts.map(([k, v]) => (
        <div><dt class="meta">{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
  </div>
  <a class="cc-cta" href={c.url} target="_blank" rel="noopener noreferrer">
    <span>{t.labels.cta}<span class="sr-only">: {c.title} ({t.labels.newTab})</span></span>
    <ExternalLinkIcon />
  </a>
</li>

<style>
  /* A cell. Its right and bottom hairlines are drawn by an overlay one pixel outside the cell, so
     neighbouring cells share a single line and no plate or band can paint over it. No radius, no
     shadow, no fill. */
  .cc {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .cc::after {
    content: '';
    position: absolute;
    inset: 0 -1px -1px 0;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    pointer-events: none;
    z-index: 1;
  }

  /* Plate: the course's short name set large on a pale ground, scaled to the cell's width
     (container units), with the site's blue slash. No image, nothing borrowed. */
  .plate {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-md);
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }
  .pl-top { display: flex; justify-content: space-between; gap: var(--space-sm); color: var(--muted); }
  .pl-pick { display: inline-flex; gap: 0.5em; color: var(--ink); }
  .pl-mark {
    font-size: min(var(--fs-sec, 4.5rem) * 0.9, calc(88cqi / (var(--len) * 0.6 + 0.5)));
    font-weight: var(--display-wght);
    line-height: 0.86;
    letter-spacing: -0.035em;
    font-variation-settings: var(--display-opsz);
    white-space: nowrap;
    margin-left: -0.04em;
  }
  .pl-mark .slash { margin-left: 0.04em; }
  .cc:hover .pl-mark .slash { transform: translateX(0.08em); }

  .cc-body { flex: 1 1 auto; display: flex; flex-direction: column; gap: var(--space-sm); padding: var(--space-md) var(--space-md) var(--space-lg); }
  .cc-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px var(--space-sm); }
  .cc-title { font-size: clamp(1.125rem, 1.35vw, 1.3125rem); font-weight: 600; line-height: 1.25; letter-spacing: -0.008em; text-wrap: balance; }
  .cc-f .cc-title { font-size: var(--fs-lead); line-height: 1.2; }
  .cc-facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); gap: var(--space-sm) var(--space-md); margin-top: auto; padding-top: var(--space-sm); }
  .cc-facts dt { color: var(--muted); margin-bottom: 2px; }
  .cc-facts dd { margin: 0; font-size: var(--fs-meta-l); line-height: 1.35; }

  /* The call to action closes the cell: a solid button in the action blue, inset to the cell's own
     padding (the same on both sides and below, so it reads as part of the cell and not as a piece
     added to it). One height and one size for every cell, text on the left, Radix's external-link
     icon on the right, white text (6.4:1). Small radius, no shadow, no gradient. */
  .cc-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: 48px;
    margin: 0 var(--space-md) var(--space-md);
    padding-inline: var(--space-md);
    border-radius: 3px;
    background: var(--action);
    color: var(--action-ink);
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: -0.005em;
    text-decoration: none;
    transition: background-color var(--t-fast) var(--ease);
  }
  .cc-cta > :global(svg) { flex: none; width: 16px; height: 16px; transition: transform var(--t-ui) var(--ease); }
  .cc-cta:hover, .cc-cta:focus-visible { background: var(--action-hover); }
  .cc-cta:hover > :global(svg), .cc-cta:focus-visible > :global(svg) { transform: translate(1.5px, -1.5px); }
  .cc-cta:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .cc-c .cc-body { padding-bottom: var(--space-md); }
  @media (forced-colors: active) {
    .cc-cta { border: 1px solid ButtonText; }
  }

  /* A cell alone on its row: plate (or title) and facts side by side; the band stays at the bottom. */
  .is-wide { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .is-wide .plate { grid-row: 1 / span 2; border-bottom: 0; border-right: 1px solid var(--rule); aspect-ratio: auto; min-height: 260px; }
  .is-wide .cc-body, .is-wide .cc-cta { grid-column: 2; }
  .cc-c.is-wide { grid-template-columns: minmax(0, 1fr); }
  .cc-c.is-wide .cc-body, .cc-c.is-wide .cc-cta { grid-column: 1; }
  @media (min-width: 641px) {
    .cc-c.is-wide .cc-body { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--space-lg); align-items: end; }
    .cc-c.is-wide .cc-top { grid-column: 1 / -1; }
    .cc-c.is-wide .cc-title { grid-column: 1; }
    .cc-c.is-wide .cc-facts { grid-column: 2; margin-top: 0; padding-top: 0; }
  }

  /* Tablet: a feature runs the full row, so its plate sits beside the facts (as .is-wide). */
  @media (min-width: 641px) and (max-width: 1024px) {
    .cc-f { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .cc-f .plate { grid-row: 1 / span 2; border-bottom: 0; border-right: 1px solid var(--rule); aspect-ratio: auto; min-height: 260px; }
    .cc-f .cc-body, .cc-f .cc-cta { grid-column: 2; }
  }

  @media (max-width: 640px) {
    .is-wide { display: flex; }
    .is-wide .plate { border-right: 0; border-bottom: 1px solid var(--rule); aspect-ratio: 16 / 9; min-height: 0; }
    .plate { aspect-ratio: 16 / 9; }
  }

  /* ---- Cells with an image ------------------------------------------------------------------
     The grid is drawn around the image: it fills its area edge to edge, so it touches the cell's
     hairlines (no frame, no radius, no shadow). The plate stays, as the head of the text: the
     label above and the short name set large. Desktop first; tablet and phone re-compose below. */
  .has-img {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas: 'media' 'plate' 'body' 'cta';
  }
  /* justify-self and min-width: an item with an aspect-ratio and an auto width otherwise derives its width from a stretched height and spills into the next cell. */
  .has-img .media { grid-area: media; justify-self: stretch; min-width: 0; position: relative; margin: 0; overflow: hidden; background: var(--surface); border-bottom: 1px solid var(--rule); aspect-ratio: var(--ar, var(--ar-photo, 3 / 2)); }
  .has-img .media :global(picture) { position: absolute; inset: 0; display: block; }
  .has-img .media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos, 50% 50%); }
  .has-img .plate { grid-area: plate; aspect-ratio: auto; min-height: 0; background: none; border-bottom: 0; padding: var(--space-md) var(--space-md) 0; gap: var(--space-md); }
  .has-img .cc-body { grid-area: body; padding-top: var(--space-sm); }
  .has-img .cc-cta { grid-area: cta; }

  /* Photographs lean in a hair on hover (never the graphics, which carry their own text). */
  .k-photo .media :global(img) { transition: transform 600ms var(--ease); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .k-photo:hover .media :global(img) { transform: scale(1.015); }
  }

  /* opening: the whole row. A wide frame, then the plate (its mark at display size) beside the facts. */
  .lay-opening { --ar-photo: 2.4; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); grid-template-rows: auto 1fr auto; grid-template-areas: 'media media' 'plate body' 'plate cta'; }
  .lay-opening .plate { border-right: 1px solid var(--rule); padding: var(--space-lg); }
  .lay-opening .pl-mark { font-size: min(var(--fs-display-l), calc(88cqi / (var(--len) * 0.6 + 0.5))); }
  .lay-opening .cc-body { padding: var(--space-lg) var(--space-md) var(--space-lg); }

  /* media-right: text on the left, a tall frame filling the right (the photo is cropped to the row). */
  .lay-media-right { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-rows: auto 1fr auto; grid-template-areas: 'plate media' 'body media' 'cta media'; }
  .lay-media-right .media { aspect-ratio: auto; border-bottom: 0; border-left: 1px solid var(--rule); min-height: 340px; }

  /* tile: a third of a row. The graphic's own frame on top, the text under it. */
  .lay-tile .media { align-self: start; }

  /* half: two thirds of a row. The photo takes whatever height the row has, never less than 3:2. */
  .lay-half { --ar-photo: 1.5; grid-template-columns: minmax(0, 4fr) minmax(0, 5fr); grid-template-rows: minmax(auto, 1fr) auto auto; grid-template-areas: 'media media' 'plate body' 'plate cta'; }
  .lay-half .plate { border-right: 1px solid var(--rule); }
  .lay-half .media { align-self: stretch; } /* an aspect-ratio item does not stretch by default: this one takes the row's height */

  /* tall: a third of a row. The portrait poster, whole, then the text. */
  .lay-tall .media { align-self: start; }

  /* band: the whole row. The graphic on the left, the text beside it. */
  .lay-band { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); grid-template-rows: auto 1fr auto; grid-template-areas: 'media plate' 'media body' 'media cta'; }
  .lay-band .media { align-self: start; border-bottom: 0; border-right: 1px solid var(--rule); }

  /* Tablet: every cell runs the full row; the composition changes with the width. */
  @media (min-width: 641px) and (max-width: 1024px) {
    .lay-opening, .lay-half { --ar-photo: 2; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-rows: auto 1fr auto; grid-template-areas: 'media media' 'plate body' 'plate cta'; }
    .lay-half { grid-template-rows: auto auto auto; }
    .cc-f.lay-media-right { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .cc-f.lay-media-right .media { min-height: 300px; }
    /* The text columns are narrow here: two facts per line, not one under another. */
    .has-img .cc-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* tile and band: the graphic keeps its frame, so on a tablet it runs the width and the plate sits beside the facts. */
    .lay-tile, .lay-band { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-rows: auto 1fr auto; grid-template-areas: 'media media' 'plate body' 'plate cta'; }
    .lay-tile .media, .lay-band .media { border-right: 0; border-bottom: 1px solid var(--rule); }
    .lay-tile .plate, .lay-band .plate { border-right: 1px solid var(--rule); }
    /* tall: the poster beside the text, whole. */
    .lay-tall { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); grid-template-rows: auto 1fr auto; grid-template-areas: 'plate plate' 'media body' 'media cta'; }
    .lay-tall .plate { border-bottom: 1px solid var(--rule); padding-bottom: var(--space-md); }
    .lay-tall .media { border-bottom: 0; border-right: 1px solid var(--rule); }
  }

  /* Phone: one column. The image first, at its own proportion, then the plate, the facts, the action. */
  @media (max-width: 640px) {
    .has-img, .lay-opening, .lay-media-right, .lay-tile, .lay-half, .lay-tall, .lay-band {
      --ar-photo: 3 / 2;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto 1fr auto;
      grid-template-areas: 'media' 'plate' 'body' 'cta';
    }
    .has-img .media { aspect-ratio: var(--ar, 3 / 2); min-height: 0; border-left: 0; border-right: 0; border-bottom: 1px solid var(--rule); align-self: start; }
    .has-img .plate { border-right: 0; padding: var(--space-md) var(--space-md) 0; }
    .has-img .cc-body { padding: var(--space-sm) var(--space-md) var(--space-md); }
    .lay-opening .pl-mark { font-size: min(var(--fs-sec), calc(88cqi / (var(--len) * 0.6 + 0.5))); }
  }
</style>
