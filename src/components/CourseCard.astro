---
// One course of the video library (V0.7), laid out like a video in a grid: the 16:9 thumbnail across the
// column, then the institution's round avatar beside the title (two lines at most), the institution, and
// one line of verified facts (its paths, its format, its language when not Portuguese). No container around
// it, no view count, date, rating or invented duration. The whole card is one link, the title's stretched
// over the card: to the course's own page when it has a presentation, else to its source in a new tab.
import CourseThumb from './CourseThumb.astro';
import CourseAvatar from './CourseAvatar.astro';
import type { CourseCardData } from '../lib/course-library';
import { presentationOf } from '../lib/course-presentations';
import { routes } from '../lib/routes';
import { OBJECTIVES } from '../lib/taxonomy';
import { pt as t } from '../i18n/pt';

interface Props { card: CourseCardData; headingLevel?: 2 | 3; eager?: boolean }
const { card, headingLevel = 3, eager = false } = Astro.props;
const { resource: r } = card;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const l = t.resource;
const page = presentationOf(r.id) ? routes.course(r.id) : null;
const facts = [
  card.paths.map((path) => OBJECTIVES[path].label).join(', '),
  l.formats[r.format],
  r.language === 'pt' ? null : l.languages[r.language],
].filter((fact): fact is string => Boolean(fact));
---
<li class="course" data-resource-id={r.id} data-format={r.format} data-subject={r.subject} data-paths={r.paths.join(' ')}>
  <CourseThumb resource={r} label={card.thumbLabel} eager={eager} />
  <div class="details">
    <CourseAvatar provider={r.provider} />
    <div class="text">
      <Heading class="title">
        {page ? (
          <a href={page}><span translate="no">{r.title}</span></a>
        ) : (
          <a href={r.url} target="_blank" rel="noopener noreferrer"><span translate="no">{r.title}</span><span class="sr-only"> ({l.newTab})</span></a>
        )}
      </Heading>
      <p class="by" translate="no">{r.provider}</p>
      <p class="facts">{facts.join(' · ')}</p>
    </div>
  </div>
</li>

<style>
  .course { position: relative; display: grid; align-content: start; gap: 10px; }
  .details { display: flex; align-items: flex-start; gap: 10px; }
  .text { display: grid; min-width: 0; gap: 2px; }
  .title {
    margin-bottom: 2px;
    font-family: var(--sans);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: 0;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .title a { color: inherit; text-decoration: none; }
  /* The title's link covers the card: thumbnail and text are one target. */
  .title a::after { content: ''; position: absolute; inset: -5px; border-radius: 13px; }
  .title a:focus-visible { outline: none; }
  .course:has(a:focus-visible) { outline: 2px solid var(--action); outline-offset: 5px; border-radius: 13px; }
  .by, .facts { font-size: 0.8125rem; line-height: 1.4; color: var(--muted); }
  .course:hover .title { color: var(--action); }
  .course:hover .by { color: var(--ink); }
</style>
