---
// Brand and the five entry points (spec §6.5). Plain links: no menu button, no JavaScript. On a phone
// the items wrap under the brand; the page never scrolls sideways.
import { HEADER_NAV, routes } from '../lib/routes';
import { pt as t } from '../i18n/pt';

const path = Astro.url.pathname;
const isCurrent = (href: string) => href === path || (href === routes.subjectIndex && path.startsWith(routes.subjectIndex));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={routes.home} aria-label={t.nav.home}>
      <!-- Temporary typographic signature: the official Academy symbol (the red book) is pending. -->
      <span class="sig-a">Pexis</span><span class="sig-b">Academy</span>
    </a>
    <nav aria-label={t.nav.label}>
      <ul role="list">
        {HEADER_NAV.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  /* On a phone the header wraps to more than one row: it scrolls away instead of covering the page. */
  @media (max-width: 639px) { .site-header { position: static; } }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-6);
    row-gap: var(--space-1);
    padding-block: var(--space-3);
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.32em;
    min-height: 44px;
    padding-top: 0.35em;
    font-family: var(--serif);
    font-size: 1.375rem;
    letter-spacing: -0.015em;
    text-decoration: none;
    color: var(--ink);
  }
  .sig-a { font-weight: 640; }
  .sig-b { font-weight: 380; color: var(--muted); }
  .brand:hover .sig-b { color: var(--action); }

  ul { display: flex; flex-wrap: wrap; gap: 0 var(--space-1); margin-inline: calc(-1 * var(--space-2)); }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-2);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }
  nav a { border-radius: var(--radius); transition: background var(--t-ui), color var(--t-ui); }
  nav a:hover { color: var(--ink); background: var(--surface); }
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--action);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
</style>
