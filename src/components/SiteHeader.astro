---
// Brand and the five entry points (spec §6.5). Plain links: no menu button, no JavaScript. On a phone
// the items wrap under the brand; the page never scrolls sideways.
// The brand is the official Pexis Academy lockup, white as supplied, on a plate of the brand red that
// hangs from the top edge (src/assets/brand, scripts/brand-assets.mjs). The artwork is never redrawn: it
// is shown whole, 46px tall, the smallest size at which "ACADEMY" keeps 6px letters (13.1% of the art).
import { Image } from 'astro:assets';
import lockup from '../assets/brand/lockup-white.png';
import { HEADER_NAV, routes } from '../lib/routes';
import { pt as t } from '../i18n/pt';

const path = Astro.url.pathname;
const isCurrent = (href: string) => href === path || (href === routes.subjectIndex && path.startsWith(routes.subjectIndex));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={routes.home} aria-label={t.nav.home} data-brand>
      <Image src={lockup} alt="" height={46} densities={[1, 2, 3]} format="png" loading="eager" fetchpriority="high" />
    </a>
    <nav aria-label={t.nav.label}>
      <ul role="list">
        {HEADER_NAV.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  /* On a phone the header wraps to more than one row: it scrolls away instead of covering the page. */
  @media (max-width: 639px) { .site-header { position: static; } }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-6);
    row-gap: var(--space-1);
  }
  /* The plate: the brand red, flush with the top of the page and the header's bottom rule. */
  .brand {
    display: block;
    flex: none;
    /* Clear space around the artwork: a fifth of its height above and below, more at the sides. */
    padding: 10px 20px;
    background: var(--brand);
    line-height: 0;
  }
  .brand :global(img) { display: block; width: auto; height: 46px; }
  .brand:focus-visible { outline-offset: -4px; outline-color: var(--on-action); }

  ul { display: flex; flex-wrap: wrap; gap: 0 var(--space-1); margin-inline: calc(-1 * var(--space-2)); }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-2);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }
  nav a { border-radius: var(--radius); transition: background var(--t-ui), color var(--t-ui); }
  nav a:hover { color: var(--ink); background: var(--surface); }
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--action);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  /* Phone: the five items on one row under the plate (down to 360px), each still 44px tall.
     After the base rules: same specificity, so order decides. */
  @media (max-width: 639px) {
    nav { width: 100%; padding-block: var(--space-1); }
    ul { gap: 0; margin-inline: -6px; }
    nav a { padding-inline: 6px; font-size: 0.875rem; }
  }
</style>
