---
// The institutional header (V0.5): the brand wine, the official lockup in white, and four places:
// Cursos and Materiais (the two libraries), the "Explorar" menu with the six paths, and search, as a
// magnifying glass with its name for assistive tech. From 720px (iPad and up) all four sit on one line.
// Below 720px: search and one "Menu" button, whose sheet holds Cursos, Materiais and "Explorar caminhos"
// (the six paths). Every menu is a native <details>: keyboard operable and complete without JavaScript
// (this page ships none). The cost, accepted: a menu closes by its own button, by choosing a link, or by
// Tab leaving it open behind; not by Escape or a click outside.
// The lockup is the official artwork (src/assets/brand), 46px tall: the smallest size at which "ACADEMY"
// keeps 6px letters.
import { Image } from 'astro:assets';
import lockup from '../assets/brand/lockup-white.png';
import MagnifyingGlassIcon from './icons/radix/MagnifyingGlassIcon.astro';
import { EXPLORE_MENU, HEADER_NAV, routes, sectionOf } from '../lib/routes';
import { objectiveSummaryFor } from '../lib/superior-copy';
import { PREPARING_PATHS } from '../lib/taxonomy';
import { pt as t } from '../i18n/pt';

const path = Astro.url.pathname;
const section = sectionOf(path);
const current = (href: string) => (href === path ? 'page' : undefined);
const items = EXPLORE_MENU.items.map((item) => ({
  ...item,
  what: objectiveSummaryFor(item.id),
  preparing: PREPARING_PATHS.includes(item.id),
}));
const inSection = (href: string) => sectionOf(href) === section && section !== null;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={routes.home} aria-label={t.nav.home} aria-current={current(routes.home)} data-brand>
      <Image src={lockup} alt="" height={46} densities={[1, 2, 3]} format="png" loading="eager" fetchpriority="high" />
    </a>

    <!-- From 720px: the four places on one line. -->
    <nav class="desktop" aria-label={t.nav.label}>
      <ul role="list" class="top">
        {HEADER_NAV.map((item) => (
          <li><a class:list={['link', inSection(item.href) && 'in-section']} href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
        ))}
        <li>
          <details class="explore" data-menu="explorar">
            <summary class:list={[section === 'explorar' && 'in-section']}>{EXPLORE_MENU.label}<span class="chev" aria-hidden="true"></span></summary>
            <div class="panel">
              <p class="panel-label">{t.nav.choose}</p>
              <ul role="list" class="paths">
                {items.map((item) => (
                  <li>
                    <a href={item.href} aria-current={current(item.href)}>
                      <span class="name"><span class="label">{item.label}</span>{item.preparing && <span class="tag">{t.preparing.label}</span>}</span>
                      <span class="what">{item.what}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        </li>
        <li>
          <a class:list={['link', 'search', section === 'buscar' && 'in-section']} href={routes.search} aria-current={current(routes.search)} data-search-link>
            <MagnifyingGlassIcon width={20} height={20} /><span class="sr-only">{t.nav.search}</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Below 720px: search, then one button for the rest. -->
    <div class="compact">
      <a class:list={['link', 'search', section === 'buscar' && 'in-section']} href={routes.search} aria-current={current(routes.search)} data-search-link>
        <MagnifyingGlassIcon width={20} height={20} /><span class="sr-only">{t.nav.search}</span>
      </a>
      <details class="mobile" data-menu="mobile">
        <summary><span class="burger" aria-hidden="true"><i></i><i></i></span>{t.nav.menu}</summary>
        <nav class="sheet" aria-label={t.nav.mobile}>
          <p class="panel-label">{t.nav.mobile}</p>
          <ul role="list" class="sheet-list">
            {HEADER_NAV.map((item) => (
              <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
            ))}
            <li>
              <details class="sheet-explore" data-menu="mobile-explorar">
                <summary class:list={[section === 'explorar' && 'in-section']}>{t.nav.explorePaths}<span class="chev" aria-hidden="true"></span></summary>
                <ul role="list" class="sheet-paths">
                  {items.map((item) => (
                    <li><a href={item.href} aria-current={current(item.href)}>{item.label}{item.preparing && <span class="tag">{t.preparing.label}</span>}</a></li>
                  ))}
                </ul>
              </details>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--brand);
    color: var(--on-brand);
    border-bottom: 1px solid var(--brand-deep);
  }
  .bar { position: relative; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 64px; }
  .brand { display: block; flex: none; padding-block: 9px; line-height: 0; }
  .brand :global(img) { display: block; width: auto; height: 46px; }

  /* Focus on the wine: the outline is white. */
  .site-header :global(:focus-visible) { outline-color: var(--on-brand); }

  /* One line from 720px (iPad portrait and up); below it, search and the Menu button. */
  .desktop { display: none; }
  .compact { display: flex; align-items: center; gap: var(--space-2); }
  @media (min-width: 720px) { .desktop { display: block; } .compact { display: none; } }
  .top { display: flex; align-items: center; gap: var(--space-1); }
  .link, .explore > summary, .mobile > summary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-3);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--on-brand-muted);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    transition: background var(--t-ui), color var(--t-ui);
  }
  summary::-webkit-details-marker { display: none; }
  .link:hover, .explore > summary:hover, .explore[open] > summary { background: var(--brand-deep); color: var(--on-brand); }
  /* Search: a square 44px target around the glass. */
  .search { justify-content: center; min-width: 44px; padding-inline: 0; }
  .search :global(svg) { display: block; }
  /* The current page and its section: white, with a hairline under it. */
  .link[aria-current='page'], .in-section { color: var(--on-brand); }
  .link[aria-current='page']::after, .link.in-section::after, .explore > summary.in-section::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 6px;
    height: 2px;
    background: var(--on-brand);
  }
  .search[aria-current='page']::after, .search.in-section::after { left: 12px; right: 12px; }
  .chev { width: 7px; height: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform var(--t-ui) var(--ease); }
  details[open] > summary > .chev { transform: translateY(2px) rotate(-135deg); }

  /* The Explorar panel: paper under the wine, the six paths with one line each. */
  /* The panel hangs from the header bar, aligned with the content's right edge: it never leaves the page. */
  .panel {
    position: absolute;
    top: calc(100% + 8px);
    right: var(--gutter);
    width: min(40rem, calc(100vw - 2 * var(--gutter)));
    padding: var(--space-5);
    background: var(--raised);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-panel);
  }
  .panel-label { margin-bottom: var(--space-2); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .paths { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-1) var(--space-4); }
  .paths a { display: grid; gap: 2px; min-height: 44px; padding: var(--space-3); border-radius: var(--radius); color: var(--ink); text-decoration: none; transition: background var(--t-ui); }
  .paths a:hover { background: var(--surface); }
  .paths a:hover .name { color: var(--action); }
  .paths a[aria-current='page'] { background: var(--tint-brand); }
  .name { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-2); font-family: var(--serif); font-size: 1.1875rem; line-height: 1.2; }
  .name .label { white-space: nowrap; }
  .what { font-size: 0.8125rem; line-height: 1.4; color: var(--muted); }
  .tag { font-family: var(--sans); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--action); }
  .site-header .panel :global(:focus-visible) { outline-color: var(--action); }

  /* Mobile: search and one button that opens a sheet under the header. */
  .mobile > summary { color: var(--on-brand); padding-inline: var(--space-3) var(--space-4); border: 1px solid var(--brand-line); }
  .mobile > summary:hover, .mobile[open] > summary { background: var(--brand-deep); }
  .burger { display: grid; gap: 5px; width: 18px; }
  .burger i { display: block; height: 1.5px; background: currentColor; transition: transform var(--t-ui) var(--ease); }
  .mobile[open] .burger i:first-child { transform: translateY(3.25px) rotate(45deg); }
  .mobile[open] .burger i:last-child { transform: translateY(-3.25px) rotate(-45deg); }
  .sheet {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100dvh - 64px);
    overflow-y: auto;
    padding: var(--space-5) var(--gutter) var(--space-6);
    background: var(--raised);
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    box-shadow: var(--shadow-panel);
  }
  .sheet-list { display: grid; border-top: 1px solid var(--rule); }
  .sheet-list > li { border-bottom: 1px solid var(--rule); }
  .sheet-list > li > a, .sheet-explore > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 52px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--serif);
    font-size: 1.25rem;
    cursor: pointer;
    list-style: none;
  }
  .sheet-list a[aria-current='page'], .sheet-explore > summary.in-section { color: var(--action); }
  .sheet-explore > summary .chev { margin-right: var(--space-2); }
  .sheet-paths { display: grid; padding: 0 0 var(--space-3) var(--space-4); border-left: 2px solid var(--rule); margin-bottom: var(--space-3); }
  .sheet-paths a { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); min-height: 44px; color: var(--ink); text-decoration: none; font-size: 1.0625rem; }
  .sheet-paths a:hover, .sheet-list > li > a:hover, .sheet-explore > summary:hover { color: var(--action); }
  .sheet-paths a[aria-current='page'] { color: var(--action); font-weight: 560; }
  .site-header .sheet :global(:focus-visible) { outline-color: var(--action); }
</style>
