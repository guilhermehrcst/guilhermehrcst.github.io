---
// The art of a path card on the Home (V2.2): six original compositions, made for the Academy, one art
// direction. No photograph, no person, no third-party artwork, nothing loaded or linked. Each is a small still
// life of what the path is about, cut from paper on the path's own deep tone: a soft disc of its pale tone
// behind, objects in paper white and ink with a flat offset shadow, the brand wine as the one accent, and the
// other pastel tones as supporting colours. The objects overlap and sit off the centre, so each reads as a
// scene, not as an icon in a box.
//   Fundamental: a notebook with "Aa", a pencil, alphabet blocks.   Médio: a stack of books, a flask, a graph.
//   Pré-Militar: a checklist on a clipboard, a stopwatch, rising chevrons.   Vestibular: an answer sheet, the
//   exam booklet, a pencil, a tick.   Superior: a columned facade, books and a mortarboard.
//   Tecnologia: a code window, a wireframe, a cursor.
// The drawing is wider than the panel is tall (400 x 220) and is cropped to fit (slice): the main objects stay
// in the middle 180 units, so the same drawing serves the wide panel of a desktop card and the narrow one of a
// phone. Decorative: the card's name says what it is. Colours are tokens only (src/styles/global.css).
import type { PathId } from '../lib/taxonomy';

interface Props { path: PathId }
const { path } = Astro.props;

/** A four-pointed sparkle centred on (x, y). */
const spark = (x: number, y: number, r: number): string =>
  `M${x} ${y - r} L${x + r * 0.28} ${y - r * 0.28} L${x + r} ${y} L${x + r * 0.28} ${y + r * 0.28} L${x} ${y + r} L${x - r * 0.28} ${y + r * 0.28} L${x - r} ${y} L${x - r * 0.28} ${y - r * 0.28} Z`;
/** Each scene is centred in the panel by one rule: its main objects are drawn around the x of FOCUS[path], and
 *  this group moves that x to the middle (200) and scales the scene, so the still life sits inside the panel with
 *  air around it. Props beyond the main objects fill the sides of a wide panel; a narrow one (a phone) crops
 *  them. The disc and the dots behind it do not move. */
const FOCUS: Record<PathId, number> = {
  'ensino-fundamental': 232,
  'ensino-medio': 224,
  'pre-militar': 228,
  vestibulares: 216,
  'ensino-superior': 200,
  tecnologia: 214,
};
const scene = `translate(200 112) scale(0.93) translate(${-FOCUS[path]} -118)`;
const dots = [0, 1, 2, 3, 4, 5].flatMap((col) => [0, 1, 2].map((row) => [22 + col * 13, 26 + row * 13] as const));
const ticks = Array.from({ length: 12 }, (_, i) => i);
