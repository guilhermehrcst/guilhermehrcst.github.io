<style>
  .path-art { display: block; width: 100%; height: 100%; }
  /* A narrow panel (a phone card, where the art sits beside the words) shows the same scene smaller, so the whole
     still life fits and nothing is cut at its sides. */
  .zoom { transform-origin: 200px 112px; }
  @media (min-width: 360px) and (max-width: 639px) { .zoom { transform: scale(0.76); } }
  /* The palette of the drawing: the path's own tones (--ground the pale one, --deep the deep one, set by the
     card), paper white, ink and the wine. Supporting colours are the other pastel tones, never new colours. */
  .g { fill: var(--ground); }
  .d { fill: var(--deep); }
  .p { fill: var(--raised); }
  .k { fill: var(--ink); }
  .a { fill: var(--brand); }
  .soft { opacity: 0.7; }
  .dim { opacity: 0.32; }
  .sh { fill: var(--ink); opacity: 0.14; }
  .dot { fill: var(--raised); opacity: 0.55; }
  .ring { fill: none; stroke: var(--raised); stroke-width: 1.6; opacity: 0.5; }
  .orbit { fill: none; stroke: var(--raised); stroke-width: 1.6; opacity: 0.6; }
  .rule { fill: none; stroke: var(--ground); stroke-width: 2.4; stroke-linecap: round; }
  .rule-p { fill: none; stroke: var(--ground); stroke-width: 2.4; stroke-linecap: round; opacity: 0.9; }
  .axis { fill: none; stroke: var(--ink); stroke-width: 2.4; stroke-linecap: round; }
  .curve { fill: none; stroke: var(--brand); stroke-width: 3.2; stroke-linecap: round; }
  .flute { fill: none; stroke: var(--ground); stroke-width: 2; stroke-linecap: round; }
  .sep { fill: none; stroke: var(--raised); stroke-width: 1.4; opacity: 0.22; }
  .trace { fill: none; stroke: var(--raised); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; opacity: 0.7; }
  .node { fill: var(--raised); }
  .tick { fill: none; stroke: var(--raised); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .box { fill: none; stroke: var(--ink); stroke-width: 2.2; }
  .bub { fill: none; stroke: var(--deep); stroke-width: 2; }
  .wedge { fill: var(--brand); opacity: 0.2; }
  .ringk { fill: none; stroke: var(--ink); stroke-width: 3; }
  .tk { fill: none; stroke: var(--ink); stroke-width: 2.2; stroke-linecap: round; }
  .hand { fill: none; stroke: var(--brand); stroke-width: 4; stroke-linecap: round; }
  .chev-k, .chev-a { fill: none; stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
  .chev-k { stroke: var(--ink); }
  .chev-a { stroke: var(--brand); }
