---
import { dicts, routes } from '../i18n/routes';
import type { Lang, PageId } from '../i18n/types';

interface Props { lang: Lang; page: PageId }
const { lang, page } = Astro.props;
const t = dicts[lang];
const items: { id: PageId; text: string }[] = [
  { id: 'home', text: t.nav.home },
  { id: 'resume', text: t.nav.resume },
  { id: 'courses', text: t.nav.courses },
];
// Current language first: EN / PT on English pages, PT / EN on Portuguese ones.
const langs: Lang[] = lang === 'en' ? ['en', 'pt'] : ['pt', 'en'];
---
<header class="site-header" id="top">
  <div class="bar grid">
    <a class="name" href={routes.home[lang]}>Guilherme Henrique</a>
    <nav class="nav" aria-label={t.nav.label}>
      <ul>
        {items.map((it) => (
          <li>
            <a href={routes[it.id][lang]} aria-current={it.id === page ? 'page' : undefined}>
              {it.text}<span class="slash" aria-hidden="true">/</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="lang" aria-label={t.nav.language}>
      {langs.map((l, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true">/</span>}
          <a
            href={routes[page][l]}
            lang={l === 'en' ? 'en' : 'pt-BR'}
            hreflang={l === 'en' ? 'en' : 'pt-BR'}
            aria-current={l === lang ? 'true' : undefined}
          >
            <span aria-hidden="true">{l.toUpperCase()}</span>
            <span class="sr-only">{l === 'en' ? 'English' : 'Português'}</span>
          </a>
        </>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    /* Entrance: discreet, after the name has started rising. */
    view-transition-name: site-header;
  }
  .bar {
    height: var(--header-h);
    align-items: stretch;
  }
  .bar a {
    text-decoration: none;
    display: flex;
    align-items: center;
  }
  .name {
    grid-column: 1 / span 3;
    font-weight: 650;
    letter-spacing: 0.005em;
  }
  .nav { grid-column: 5 / span 6; }
  .nav ul { display: flex; height: 100%; }
  .nav li { flex: 1 1 0; border-left: 1px solid var(--rule); }
  .nav li:last-child { border-right: 1px solid var(--rule); }
  .nav a {
    height: 100%;
    padding-inline: 12px;
    color: var(--muted);
    transition: color var(--t-fast) linear;
  }
  .nav a:hover, .nav a[aria-current='page'] { color: var(--ink); }
  .slash { transition: color var(--t-fast) linear; }
  .nav a[aria-current='page'] .slash { color: var(--signal); }

  .lang {
    grid-column: 11 / span 2;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .lang a { color: var(--muted); min-width: 24px; justify-content: center; height: 100%; }
  .lang a:hover, .lang a[aria-current='true'] { color: var(--ink); }
  .lang .sep { color: var(--rule); }

  :global(.motion) .site-header .bar > * { opacity: 0; transition: opacity var(--t-medium) linear 450ms; }
  :global(.motion.loaded) .site-header .bar > * { opacity: 1; }

  @media (max-width: 1024px) {
    .name { grid-column: 1 / span 2; }
    .nav { grid-column: 3 / span 3; }
    .lang { grid-column: 6 / span 1; }
  }

  /* Mobile: no hamburger. Three destinations fit as a second typographic row. */
  @media (max-width: 640px) {
    .bar { grid-template-rows: 1fr 1fr; row-gap: 0; }
    .name { grid-column: 1 / span 3; grid-row: 1; }
    .lang { grid-column: 4 / span 1; grid-row: 1; }
    .nav {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-inline: calc(var(--margin) * -1);
      border-top: 1px solid var(--rule);
    }
    .nav li:first-child { border-left: 0; }
    .nav li:last-child { border-right: 0; }
    .nav a { padding-inline: var(--margin); }
    .nav li + li a { padding-inline: 12px; }
  }
</style>
