---
// The cut between paper and the Lume module. Server-rendered as a static
// ordered dither (the no-JS and reduced-motion picture); the canvas, when
// available, redraws the same function with progress driven by scroll.
import { bandCell, BAND_ROWS, BAND_STATIC_P, INK, SIGNAL } from '../lib/dither';

const COLS = 64;
const ink: string[] = [];
const sig: string[] = [];
for (let y = 0; y < BAND_ROWS; y++)
  for (let x = 0; x < COLS; x++) {
    const c = bandCell(x, y, BAND_STATIC_P);
    if (c === INK) ink.push(`M${x} ${y}h1v1h-1z`);
    else if (c === SIGNAL) sig.push(`M${x} ${y}h1v1h-1z`);
  }
---
<div class="band" aria-hidden="true" data-band>
  <svg class="band-svg" viewBox={`0 0 ${COLS} ${BAND_ROWS}`} preserveAspectRatio="none" shape-rendering="crispEdges">
    <path d={ink.join('')} style="fill: var(--void)" />
    <path d={sig.join('')} style="fill: var(--signal)" />
  </svg>
  <canvas class="band-canvas"></canvas>
</div>

<style>
  .band { position: relative; aspect-ratio: 64 / 8; background: var(--paper); }
  .band-svg, .band-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .band-canvas { display: none; }
  .band.is-live .band-canvas { display: block; }
  .band.is-live .band-svg { display: none; }
  @media (max-width: 1023px) { .band { aspect-ratio: 40 / 8; } }
  @media (max-width: 639px) { .band { aspect-ratio: 24 / 8; } }
</style>
