---
// Minimal placeholder for routes that exist in navigation but are not built
// yet (Courses). noindex until they have real content. No invented content here.
import Base from '../layouts/Base.astro';
import Monument from './Monument.astro';
import { dicts, routes } from '../i18n/routes';
import type { Lang } from '../i18n/types';

interface Props { lang: Lang; page: 'courses' }
const { lang, page } = Astro.props;
const t = dicts[lang];
const s = t.shell[page];
---
<Base lang={lang} page={page} title={s.title} description={s.description} noindex>
  <main id="main" class="shell">
    <div class="grid">
      <h1 class="h">{s.heading}<span class="slash" aria-hidden="true">/</span></h1>
      <p class="b">{s.body}</p>
      <p class="back"><a href={routes.home[lang]}><span class="arrow" aria-hidden="true">←</span> <span class="u">{t.shell.back}</span></a></p>
    </div>
  </main>
  <Monument lang={lang} page={page} />
</Base>

<style>
  .shell { min-height: 80svh; padding-top: calc(var(--header-h) + clamp(48px, 10vh, 140px)); padding-bottom: var(--space-section); }
  .h {
    grid-column: 1 / -1;
    font-size: calc((100vw - 2 * var(--margin)) / 6.4);
    font-weight: var(--display-wght);
    line-height: 0.82;
    letter-spacing: var(--display-track);
    font-variation-settings: var(--display-opsz);
    text-transform: uppercase;
    margin-left: -0.045em;
  }
  .b { grid-column: 1 / span 5; margin-top: clamp(32px, 5vw, 72px); font-size: var(--fs-lead); line-height: 1.3; }
  .back { grid-column: 1 / -1; margin-top: 32px; }
  .back a { text-decoration: none; font-weight: 500; }
  a:hover .arrow { transform: translateX(-4px); }
  @media (max-width: 1024px) { .b { grid-column: 1 / -1; } }
</style>
