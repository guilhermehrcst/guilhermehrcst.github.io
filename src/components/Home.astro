---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import DitherBand from './DitherBand.astro';
import Lume from './Lume.astro';
import Pexiscale from './Pexiscale.astro';
import Principles from './Principles.astro';
import Contact from './Contact.astro';
import Monument from './Monument.astro';
import HomeNarrative from './HomeNarrative.astro';
import PexisMachine from './PexisMachine.astro';
import HomeCapabilities from './HomeCapabilities.astro';
import HomeAiWorkflow from './HomeAiWorkflow.astro';
import HomeEducation from './HomeEducation.astro';
import HomeInfluences from './HomeInfluences.astro';
import { dicts } from '../i18n/routes';
import type { Lang } from '../i18n/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
---
<Base lang={lang} page="home" title={t.meta.title} description={t.meta.description}>
  <main id="main">
    <Hero lang={lang} />
    <HomeNarrative lang={lang}>
      <Pexiscale lang={lang} />
      <DitherBand />
      <Lume lang={lang} />
      <PexisMachine lang={lang} />
      <HomeCapabilities lang={lang} />
      <HomeAiWorkflow lang={lang} />
      <HomeEducation lang={lang} />
      <HomeInfluences lang={lang} />
      <Principles lang={lang} />
      <Contact lang={lang} />
    </HomeNarrative>
  </main>
  <Monument lang={lang} page="home" />
</Base>
