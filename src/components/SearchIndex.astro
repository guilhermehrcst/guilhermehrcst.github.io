---
// /buscar/ (spec §6.8): the whole index as a directory, grouped by kind. Without JavaScript this is the
// complete page. src/scripts/search.ts reveals the form and filters these same entries in place.
// V0.4 M4: the form also filters the resources by five facets (AND across facets, OR inside one). Each
// resource entry carries its facet values; each option exists because some resource has it.
import { buildSearchIndex, type SearchKind } from '../lib/search-index';
import { facetOptions } from '../lib/search-facets';
import { FACETS } from '../lib/search-filter';
import { publishedResources } from '../lib/learning-resources';
import { routes } from '../lib/routes';
import { pt as t } from '../i18n/pt';

const index = buildSearchIndex();
const options = facetOptions(publishedResources);
const f = t.search.filters;
const kinds: SearchKind[] = ['objetivo', 'area', 'materia', 'trilha', 'recurso'];
const groups = kinds.map((kind) => ({ kind, label: t.search.groups[kind], entries: index.filter((e) => e.kind === kind) }));
---
<div class="wrap search" data-search>
  <form role="search" action={routes.search} method="get" hidden data-search-form>
    <label for="q">{t.search.label}</label>
    <input id="q" name="q" type="search" autocomplete="off" spellcheck="false" placeholder={t.search.placeholder} data-search-input>
    <details class="filters" data-search-filters>
      <summary>{f.title}<span class="active" data-filter-count></span></summary>
      <p class="note">{f.note}</p>
      <div class="facets">
        {FACETS.map((facet) => (
          <fieldset data-facet={facet}>
            <legend>{f.facets[facet]}</legend>
            <ul role="list">
              {options[facet].map((option) => (
                <li><label><input type="checkbox" name={facet} value={option.value} data-facet-option={facet}><span>{option.label}</span></label></li>
              ))}
            </ul>
          </fieldset>
        ))}
      </div>
    </details>
    <p><button type="button" class="clear" hidden data-filter-clear>{f.clear}</button></p>
  </form>
  <p class="status" aria-live="polite" data-search-status data-one={t.search.results(1)} data-many={t.search.results(0).replace('0', '{n}')}></p>
  <p class="empty" hidden data-search-empty>{t.search.empty} <a href={routes.subjectIndex}>{t.search.groups.area}</a></p>
  <p class="empty" hidden data-search-empty-filtered>{f.emptyFiltered} <button type="button" class="clear" data-filter-clear>{f.clear}</button></p>

  {groups.map((group) => (
    <section class="group" aria-labelledby={`grupo-${group.kind}`} data-search-group>
      <h2 id={`grupo-${group.kind}`}>{group.label}</h2>
      <ul role="list">
        {group.entries.map((e) => (
          <li
            data-search-entry
            data-entry-id={e.id}
            data-terms={e.terms}
            data-facet-caminho={e.facets?.caminho.join(' ')}
            data-facet-materia={e.facets ? e.facets.materia.join(' ') : undefined}
            data-facet-instituicao={e.facets?.instituicao.join(' ')}
            data-facet-idioma={e.facets?.idioma.join(' ')}
            data-facet-formato={e.facets?.formato.join(' ')}
          >
            <a href={e.url}><span class="title">{e.title}</span> <span class="context">{e.context}</span></a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<script>
  import '../scripts/search';
</script>

<style>
  form { display: grid; gap: var(--space-2); margin-bottom: var(--space-3); }
  /* The field keeps a reading width; the filters take the page's. */
  label[for='q'], #q { max-width: 40rem; }
  form[hidden] { display: none; }
  label { font-weight: 600; }
  input {
    width: 100%;
    min-height: 52px;
    padding-inline: var(--space-4);
    font: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--muted);
    border-radius: var(--radius);
  }
  input:focus-visible { outline: 2px solid var(--action); outline-offset: 2px; border-color: var(--action); }
  .filters { margin-top: var(--space-2); border-block: 1px solid var(--rule); }
  .filters summary { display: flex; align-items: center; gap: var(--space-2); min-height: 48px; font-weight: 600; cursor: pointer; }
  .filters summary:focus-visible { outline: 2px solid var(--action); outline-offset: 2px; }
  .active { font-size: var(--fs-small); font-weight: 500; color: var(--action); }
  .filters .note { margin-bottom: var(--space-4); font-size: var(--fs-small); color: var(--muted); }
  .facets { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-5) var(--space-6); padding-bottom: var(--space-5); }
  @media (min-width: 640px) { .facets { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .facets { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  legend { padding: 0; margin-bottom: var(--space-1); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  fieldset ul { display: grid; grid-template-columns: minmax(0, 1fr); }
  fieldset li { border-top: 0; }
  fieldset label { display: flex; align-items: flex-start; gap: var(--space-3); min-height: 44px; padding-block: 0.6rem; line-height: 1.3; font-weight: 400; cursor: pointer; }
  fieldset input { width: 1.25rem; height: 1.25rem; min-height: 0; margin: 0.05rem 0 0; padding: 0; flex: none; accent-color: var(--action); }
  .clear { min-height: 44px; padding-inline: var(--space-4); font: inherit; font-weight: 560; color: var(--action); background: transparent; border: 1px solid var(--action); border-radius: var(--radius); cursor: pointer; }
  .clear:hover { color: var(--paper); background: var(--action); }
  .clear[hidden] { display: none; }
  .status { min-height: 1.6em; font-size: var(--fs-small); color: var(--muted); }
  .empty { margin-top: var(--space-4); }
  .group { margin-top: var(--space-6); }
  .group h2 { font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-2); }
  ul { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: var(--space-7); }
  @media (min-width: 768px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  li { border-top: 1px solid var(--rule); }
  li a { display: grid; padding-block: var(--space-2); text-decoration: none; }
  .title { font-weight: 500; }
  li a:hover .title { text-decoration: underline; }
  .context { font-size: var(--fs-small); color: var(--muted); }
</style>
