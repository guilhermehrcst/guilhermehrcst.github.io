---
import Label from './Label.astro';
import ProjectDetail from './ProjectDetail.astro';
import { dicts } from '../i18n/routes';
import { lumeModel } from '../lib/lume-model';
import type { Lang } from '../i18n/types';

interface Props { lang: Lang }
const t = dicts[Astro.props.lang].lume;
const w = dicts[Astro.props.lang].resume.work.lume;
const fig = t.figure;

// Static picture (no JS / reduced motion): the final, compacted state.
const COLS = 48, ROWS = 20;
const model = lumeModel(COLS, ROWS);
const live = model.blocks.filter((b) => b.live).reduce((n, b) => n + b.len, 0);
const fullRows = Math.floor(live / COLS);
const rest = live % COLS;
---
<section class="lume" id="lume" aria-labelledby="lume-title" data-reveal data-narrative-section="lume">
  <div class="cols" aria-hidden="true"></div>
  <div class="grid head">
    <Label text={t.label} class="p-label" />
    <h2 id="lume-title" class="giant">{t.name}<span class="slash rv-slash" data-reveal aria-hidden="true">/</span></h2>
    <p class="meta spec"><span>{w.kind}</span><span class="spec-stack">{w.stack}</span></p>
    <p class="question">{t.question}</p>
  </div>

  <div class="grid body">
    <figure class="fig" data-lume>
      <div class="fig-bar meta" aria-hidden="true">
        <span>{fig.axis}</span>
        <span class="state" data-lume-state data-states={JSON.stringify(fig.states)}>{fig.states?.[2]}</span>
      </div>
      <div class="stage">
        <svg class="stage-svg" viewBox={`0 0 ${COLS} ${ROWS}`} role="img" aria-label={fig.alt}>
          <defs>
            <pattern id="lume-free" width="1" height="1" patternUnits="userSpaceOnUse">
              <rect x="0.08" y="0.08" width="0.84" height="0.84" style="fill: var(--void-ink); fill-opacity: 0.07" />
            </pattern>
            <pattern id="lume-live" width="1" height="1" patternUnits="userSpaceOnUse">
              <rect x="0.08" y="0.08" width="0.84" height="0.84" style="fill: var(--void-ink); fill-opacity: 0.86" />
            </pattern>
          </defs>
          <rect width={COLS} height={ROWS} fill="url(#lume-free)" />
          {fullRows > 0 && <rect width={COLS} height={fullRows} fill="url(#lume-live)" />}
          {rest > 0 && <rect y={fullRows} width={rest} height="1" fill="url(#lume-live)" />}
        </svg>
        <canvas class="stage-canvas" role="img" aria-label={fig.alt}></canvas>
      </div>
      <ul class="legend meta" aria-hidden="true">
        <li><span class="k k-live"></span>{fig.legend?.[0]}</li>
        <li><span class="k k-move"></span>{fig.legend?.[1]}</li>
        <li><span class="k k-dead"></span>{fig.legend?.[2]}</li>
      </ul>
      <figcaption class="meta cap">{fig.caption}</figcaption>
    </figure>

    <div class="aside">
      <p class="lead">{t.body}</p>
      <p class="link">
        <a href={t.link.href}><span class="u">{t.link.text}</span> <span class="arrow ne" aria-hidden="true">↗</span></a>
        <span class="meta note">{t.link.note}</span>
      </p>
    </div>
  </div>

  <ProjectDetail project={t} num="03" />
</section>

<style>
  .lume {
    --line: var(--void-rule);
    --soft: var(--void-muted);
    --accent: var(--void-signal);
    background: var(--void);
    color: var(--void-ink);
    padding-block: var(--space-2xl) var(--space-section);
  }
  .lume { position: relative; }
  .lume > :global(*) { position: relative; }
  /* The 12-column grid, surfacing once as the section enters: hairlines at each column start,
     aligned to the page grid. Opacity only; absent under reduced motion (the section is already composed). */
  .lume > .cols {
    position: absolute;
    inset: 0 var(--margin) auto;
    height: min(100%, 110vh);
    -webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent);
    mask-image: linear-gradient(to bottom, #000 30%, transparent);
    pointer-events: none;
    background: repeating-linear-gradient(
      to right,
      var(--void-rule) 0 1px,
      transparent 1px calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols) + var(--gap))
    );
    opacity: 0.55;
    transition: opacity 1200ms var(--ease);
  }
  :global(.reveal-ready) .lume:not(:global(.is-in)) > .cols { opacity: 0; }
  .lume :global(::selection) { background: var(--void-signal); color: var(--void); }
  .lume :global(:focus-visible) { outline-color: var(--void-signal); }

  .lume :global(.p-label) { grid-column: 1 / -1; color: var(--void-muted); }
  .giant {
    grid-column: 1 / -1;
    font-size: var(--fs-display-l);
    font-weight: var(--display-wght);
    line-height: 0.8;
    letter-spacing: var(--display-track);
    font-variation-settings: var(--display-opsz);
    text-transform: uppercase;
    margin: var(--space-md) 0 0 -0.045em;
  }
  .question {
    grid-column: 1 / span 9;
    margin-top: var(--space-xl);
    font-size: var(--fs-h3);
    font-weight: 440;
    line-height: 1.02;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  /* What it is and what it is built with: the résumé's own two lines, which the terminal repeats. */
  .spec { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 2px; margin-top: var(--space-md); }
  .spec-stack { color: var(--void-muted); }

  .body { margin-top: var(--space-xl); row-gap: var(--space-xl); align-items: end; }
  .fig { grid-column: 1 / span 8; }
  .fig-bar {
    display: flex;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--void-rule);
    color: var(--void-muted);
  }
  .state { color: var(--void-ink); }
  .stage { position: relative; aspect-ratio: 48 / 20; margin-top: 16px; }
  .stage-svg, .stage-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stage-canvas { display: none; }
  .fig:global(.is-live) .stage-canvas { display: block; }
  .fig:global(.is-live) .stage-svg { display: none; }

  .legend { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 18px; color: var(--void-muted); }
  .legend li { display: flex; align-items: center; gap: 8px; }
  .k { width: 8px; height: 8px; }
  .k-live { background: var(--void-ink); }
  .k-move { background: var(--void-signal); }
  .k-dead { box-shadow: inset 0 0 0 1px var(--void-muted); }
  .cap { margin-top: 10px; color: var(--void-muted); text-transform: none; letter-spacing: 0; max-width: 60em; }

  .aside { grid-column: 9 / span 4; display: flex; flex-direction: column; gap: var(--space-lg); padding-bottom: 4px; }
  .lead { font-size: var(--fs-lead); line-height: 1.3; letter-spacing: -0.006em; text-wrap: pretty; }
  .link { display: flex; flex-direction: column; gap: 6px; }
  .link a { text-decoration: none; font-size: var(--fs-body); font-weight: 500; }
  .note { color: var(--void-muted); }

  @media (max-width: 1024px) {
    .question { grid-column: 1 / -1; }
    .fig { grid-column: 1 / -1; }
    .aside { grid-column: 1 / span 4; }
  }
  @media (max-width: 640px) {
    .stage { aspect-ratio: 1; }
    .aside { grid-column: 1 / -1; }
  }
</style>
