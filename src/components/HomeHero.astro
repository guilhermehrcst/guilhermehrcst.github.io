---
// The Home's opening (V2), after the McGill reference: an editorial split. On the left the promise, set the
// way a university sets its name: "Aprenda" in the serif, "com direção." in the sans, bold (together the
// page's one h1, pages.home.heading); one line of what the Academy is; a search that is the site's own
// (/buscar/?q=, a native GET form: it works without JavaScript); the library as a button and the paths as a
// large underlined link. On the right one large photograph with square corners: the supplied image of a real
// course of the library (src/lib/home-featured.ts), named in the caption by its title and institution, so the
// picture never stands for an institution or suggests a partnership. The brand's wine disc sits over its edge
// (McGill's red circle; no play button: there is no video here). The picture is decorative for assistive tech.
// On a phone the title, the search and the actions come first; the photograph follows.
import { Image } from 'astro:assets';
import CourseThumb from './CourseThumb.astro';
import MagnifyingGlassIcon from './icons/radix/MagnifyingGlassIcon.astro';
import symbol from '../assets/brand/symbol-white.png';
import { heroCourses } from '../lib/home-featured';
import { thumbLabelOf } from '../lib/course-library';
import { routes } from '../lib/routes';
import { pt as t } from '../i18n/pt';

const h = t.home.hero;
const [photo] = heroCourses();
if (!photo) throw new Error('HomeHero: one hero course');
---
<header class="hero">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1><span class="h-serif">{h.headingLead}</span> <span class="h-strong">{h.headingStrong}</span></h1>
      <p class="lead">{h.lead}</p>
      <form class="search" action={routes.search} method="get" role="search" data-home-search>
        <label class="sr-only" for="home-q">{h.searchLabel}</label>
        <MagnifyingGlassIcon class="glass" width={20} height={20} />
        <input id="home-q" name="q" type="search" placeholder={h.searchPlaceholder} autocomplete="off" enterkeyhint="search" />
        <button type="submit">{h.searchSubmit}</button>
      </form>
      <div class="actions">
        <a class="primary" href={routes.courses}>{h.primary}</a>
        <a class="secondary" href="#objetivo">{h.secondary}</a>
      </div>
    </div>
    <figure class="composition" data-hero-courses>
      <div class="picture" aria-hidden="true">
        <div class="photo" data-demo-resource-id={photo.id}>
          <CourseThumb resource={photo} label={thumbLabelOf(photo)} priority sizes="(min-width: 1024px) 640px, 100vw" />
        </div>
        <span class="disc"><Image class="symbol" src={symbol} alt="" width={40} densities={[1, 2]} format="png" loading="eager" /></span>
      </div>
      <figcaption><span>{h.compositionCaption} <span translate="no">{photo.curated?.plate ?? photo.title}</span>, <span translate="no">{photo.provider}</span>.</span> <a href={routes.courses}>{h.compositionLink}{' '}<span aria-hidden="true">→</span></a></figcaption>
    </figure>
  </div>
</header>

<style>
  .hero { padding-block: var(--space-6) var(--space-7); overflow: clip; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-7); align-items: center; }
  /* A wide screen: 46/54, the photograph a little larger than the text, both on one centre line. */
  @media (min-width: 1024px) {
    .grid { grid-template-columns: minmax(0, 46fr) minmax(0, 54fr); gap: clamp(2.5rem, 4.5vw, 4.5rem); }
    .hero { padding-block: var(--space-7); }
  }

  /* The promise: the serif line, then the bold sans line, at one size (the McGill pairing). */
  .eyebrow { margin-bottom: var(--space-4); }
  /* The two faces at one size: the serif line a touch looser, the sans line set tighter and a step lighter
     than bold, so the pair reads as one title rather than two weights fighting. */
  h1 { font-size: clamp(var(--fs-hero), 14vw, 4.75rem); line-height: 1; }
  .h-serif, .h-strong { display: block; }
  .h-serif { font-family: var(--serif); font-weight: 400; letter-spacing: -0.025em; }
  .h-strong { margin-top: 0.02em; font-family: var(--sans); font-weight: 600; letter-spacing: -0.04em; }
  @media (min-width: 640px) and (max-width: 1023px) { h1 { font-size: clamp(5rem, 2.5rem + 7vw, 6rem); } }
  @media (min-width: 1024px) { h1 { font-size: clamp(4.75rem, 1.5rem + 4.6vw, 5.5rem); } }
  .lead { margin-top: var(--space-4); max-width: 30ch; font-size: var(--fs-lead); line-height: 1.45; color: var(--muted); }

  /* The search: one wide field on paper, the glass inside, the action at its end. */
  .search {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 34rem;
    min-height: 60px;
    margin-top: var(--space-6);
    padding: 6px 6px 6px 18px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--raised);
    box-shadow: 0 1px 0 rgb(29 33 37 / 0.03), 0 12px 32px -24px rgb(29 33 37 / 0.35);
    transition: border-color var(--t-ui), box-shadow var(--t-ui);
  }
  .search:hover { border-color: var(--muted); }
  .search:focus-within { border-color: var(--action); box-shadow: 0 0 0 3px var(--tint-brand); }
  .search :global(.glass) { flex: none; color: var(--muted); }
  .search input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.0625rem;
  }
  .search input::placeholder { color: var(--muted); opacity: 1; }
  .search input:focus { outline: none; }
  .search button {
    flex: none;
    min-height: 48px;
    padding-inline: var(--space-5);
    border: 0;
    border-radius: 999px;
    background: var(--action);
    color: var(--on-action);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--t-ui);
  }
  .search button:hover { background: var(--action-hover); }
  .search button:focus-visible { outline: 2px solid var(--action); outline-offset: 3px; }
  /* A phone: the whole question must fit in the field. */
  @media (max-width: 479px) {
    .search { gap: 6px; padding-left: 12px; }
    .search :global(.glass) { width: 18px; height: 18px; }
    .search input { font-size: 1rem; }
    .search button { padding-inline: var(--space-4); }
  }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-6); margin-top: var(--space-5); }
  .primary {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding-inline: var(--space-5);
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 560;
    text-decoration: none;
    transition: background var(--t-ui);
  }
  .primary:hover { background: var(--action); color: var(--on-action); }
  /* The call to a path: a large wine link with a thick underline, as McGill's "Choose your program". */
  .secondary {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: 1.125rem;
    font-weight: 560;
    color: var(--action);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
    transition: text-underline-offset var(--t-ui) var(--ease), color var(--t-ui);
  }
  .secondary:hover { color: var(--action-hover); text-underline-offset: 0.45em; }

  /* The photograph: one large picture with square corners; the wine disc over its edge. */
  .composition { margin: 0; }
  .picture { position: relative; }
  /* 5:4 keeps the stage, the screen and the hall whole (the source is 3:2); a phone takes 4:3. */
  .photo :global(.thumb) { aspect-ratio: 4 / 3; border-radius: 2px; }
  .photo :global([data-duration]) { display: none; }
  /* The brand's seal: small, inside the lower corner of the picture, away from what it shows and from the
     search beside it at every width. */
  .disc {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    display: grid;
    place-items: center;
    width: 56px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 0 4px var(--paper), 0 10px 24px -14px rgb(29 33 37 / 0.6);
  }
  .disc :global(.symbol) { width: 54%; height: auto; }
  @media (min-width: 640px) and (max-width: 1023px) { .photo :global(.thumb) { aspect-ratio: 16 / 9; } }
  @media (min-width: 1024px) {
    .photo :global(.thumb) { aspect-ratio: 5 / 4; }
    .disc { width: 64px; left: var(--space-4); bottom: var(--space-4); }
  }
  /* One quiet line: what the picture is, and the way to every course. */
  figcaption { display: flex; flex-wrap: wrap; gap: 0 var(--space-3); margin-top: var(--space-3); font-size: 0.8125rem; color: var(--muted); }
  figcaption a { font-weight: 560; white-space: nowrap; }

  @media (prefers-reduced-motion: no-preference) {
    .copy > * { animation: rise 600ms var(--ease) both; }
    .copy > :nth-child(2) { animation-delay: 50ms; }
    .copy > :nth-child(n + 3) { animation-delay: 110ms; }
    .composition { animation: rise 800ms var(--ease) 140ms both; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
</style>
