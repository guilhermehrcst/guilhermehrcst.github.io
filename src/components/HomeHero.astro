---
// The Home's opening (V2), an editorial split: on the left the promise ("Aprenda com direção.", the page's one
// h1), one line of what the Academy is, a search that is the site's own (/buscar/?q=, a native GET form: it
// works without JavaScript) and the two ways in (the course library, a path). On the right a composition made
// of what the Academy already has: the photograph of a real course of the library, a second real course and
// the brand's own plate (src/lib/home-featured.ts). Each course is named on it by its title and institution,
// so the picture never stands for an institution or suggests a partnership. The composition is decorative for
// assistive tech and captioned by a link to the library. On a phone the title, the search and the actions
// come first; the composition follows.
import { Image } from 'astro:assets';
import CourseThumb from './CourseThumb.astro';
import MagnifyingGlassIcon from './icons/radix/MagnifyingGlassIcon.astro';
import symbol from '../assets/brand/symbol-white.png';
import { heroCourses } from '../lib/home-featured';
import { thumbLabelOf } from '../lib/course-library';
import { routes } from '../lib/routes';
import { pt as t } from '../i18n/pt';

const h = t.home.hero;
const c = t.pages.home;
const [main, second] = heroCourses();
if (!main || !second) throw new Error('HomeHero: two hero courses');
---
<header class="hero">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1>{c.heading}</h1>
      <p class="lead">{h.lead}</p>
      <form class="search" action={routes.search} method="get" role="search" data-home-search>
        <label class="sr-only" for="home-q">{h.searchLabel}</label>
        <MagnifyingGlassIcon class="glass" width={20} height={20} />
        <input id="home-q" name="q" type="search" placeholder={h.searchPlaceholder} autocomplete="off" enterkeyhint="search" />
        <button type="submit">{h.searchSubmit}</button>
      </form>
      <div class="actions">
        <a class="primary" href={routes.courses}>{h.primary}</a>
        <a class="secondary" href="#objetivo">{h.secondary}{' '}<span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="composition" data-hero-courses>
      <div class="bento" aria-hidden="true">
        <div class="tile main" data-demo-resource-id={main.id}>
          <CourseThumb resource={main} label={thumbLabelOf(main)} priority sizes="(min-width: 1024px) 560px, (min-width: 640px) 64vw, 100vw" />
          <div class="tag">
            <span class="tag-title" translate="no">{main.title}</span>
            <span class="tag-by" translate="no">{main.provider}</span>
          </div>
        </div>
        <div class="tile plate">
          <Image class="symbol" src={symbol} alt="" width={72} densities={[1, 2]} format="png" loading="eager" />
        </div>
        <div class="tile second" data-demo-resource-id={second.id}>
          <CourseThumb resource={second} label={thumbLabelOf(second)} sizes="(min-width: 1024px) 380px, (min-width: 640px) 32vw, 66vw" />
          <div class="tag">
            <span class="tag-title" translate="no">{second.title}</span>
            <span class="tag-by" translate="no">{second.provider}</span>
          </div>
        </div>
      </div>
      <figcaption>{h.compositionCaption}{' '}<a href={routes.courses}>{h.compositionLink}{' '}<span aria-hidden="true">→</span></a></figcaption>
    </figure>
  </div>
</header>

<style>
  .hero { padding-block: var(--space-6); overflow: clip; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-7); align-items: center; }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: minmax(0, 11fr) minmax(0, 10fr); gap: clamp(2.5rem, 5vw, 5.5rem); }
    .hero { padding-block: var(--space-7) var(--space-6); }
  }

  /* The promise: a large, quiet serif, the way a university sets its name. */
  .eyebrow { margin-bottom: var(--space-5); }
  h1 {
    font-size: clamp(var(--fs-hero), 14vw, 4.5rem);
    font-weight: 420;
    line-height: 0.96;
    letter-spacing: -0.04em;
  }
  @media (min-width: 640px) and (max-width: 1023px) { h1 { font-size: clamp(4.5rem, 3rem + 5vw, 6rem); max-width: 9ch; } }
  @media (min-width: 1024px) { h1 { font-size: min(6rem, 6.6vw); } }
  .lead { margin-top: var(--space-5); max-width: 30ch; font-size: var(--fs-lead); line-height: 1.45; color: var(--muted); }

  /* The search: one wide field on paper, the glass inside, the action at its end. */
  .search {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 34rem;
    margin-top: var(--space-6);
    padding: 6px 6px 6px var(--space-4);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--raised);
    box-shadow: 0 1px 0 rgb(29 33 37 / 0.03), 0 12px 32px -24px rgb(29 33 37 / 0.35);
    transition: border-color var(--t-ui), box-shadow var(--t-ui);
  }
  .search:focus-within { border-color: var(--action); box-shadow: 0 0 0 3px var(--tint-brand); }
  .search :global(.glass) { flex: none; color: var(--muted); }
  .search input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.0625rem;
  }
  .search input::placeholder { color: var(--muted); opacity: 1; }
  .search input:focus { outline: none; }
  .search button {
    flex: none;
    min-height: 44px;
    padding-inline: var(--space-5);
    border: 0;
    border-radius: 999px;
    background: var(--action);
    color: var(--on-action);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--t-ui);
  }
  .search button:hover { background: var(--action-hover); }
  .search button:focus-visible { outline: 2px solid var(--action); outline-offset: 3px; }
  /* A phone: the whole question must fit in the field. */
  @media (max-width: 479px) {
    .search { gap: 6px; padding-left: 12px; }
    .search :global(.glass) { width: 18px; height: 18px; }
    .search input { font-size: 1rem; }
    .search button { padding-inline: var(--space-4); }
  }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); margin-top: var(--space-5); }
  .primary {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding-inline: var(--space-5);
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 560;
    text-decoration: none;
    transition: background var(--t-ui);
  }
  .primary:hover { background: var(--action); color: var(--on-action); }
  /* The second way in, underlined in the wine the way a university marks its call to action. */
  .secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 48px;
    font-weight: 560;
    color: var(--action);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  .secondary:hover { color: var(--action-hover); }
  .secondary span { transition: transform var(--t-ui) var(--ease); }
  .secondary:hover span { transform: translateX(3px); }

  /* The composition: a bento of three tiles, square and calm: the photograph across, then the brand's plate
     and a second course. Nothing turned, nothing moving. */
  .composition { margin: 0; }
  .bento { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-3); }
  .tile { position: relative; overflow: hidden; border-radius: 22px; background: var(--surface); }
  .tile :global(.thumb) { border-radius: 0; }
  .main { grid-column: 1 / -1; }
  .main :global(.thumb) { aspect-ratio: 16 / 10; }
  @media (min-width: 1024px) { .main :global(.thumb) { aspect-ratio: 16 / 11; } }
  .plate { display: grid; place-items: center; background: var(--brand); }
  .plate :global(.symbol) { width: clamp(44px, 30%, 72px); height: auto; }
  @media (min-width: 640px) { .bento { gap: var(--space-4); } .tile { border-radius: 26px; } }
  .tag {
    position: absolute;
    left: 10px;
    bottom: 10px;
    display: grid;
    gap: 1px;
    max-width: calc(100% - 20px);
    padding: 8px 12px;
    border-radius: 12px;
    background: rgb(255 253 249 / 0.92);
    backdrop-filter: blur(6px);
  }
  .tag-title { font-size: 0.8125rem; font-weight: 600; line-height: 1.25; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tag-by { font-size: 0.6875rem; color: var(--muted); }
  /* The duration badge would sit under the tag here: the tag already names the course. */
  .tile :global([data-duration]) { display: none; }
  /* The second course is a graphic with its own lettering: its label sits under it, never over it. */
  .second { display: flex; flex-direction: column; background: var(--raised); box-shadow: inset 0 0 0 1px var(--rule); }
  .second .tag { position: static; max-width: none; padding: 10px 14px 12px; border-radius: 0; background: none; backdrop-filter: none; }
  @media (max-width: 479px) {
    .second .tag { padding: 7px 10px 9px; }
    .second .tag-title { font-size: 0.75rem; }
  }
  figcaption { margin-top: var(--space-4); font-size: var(--fs-small); color: var(--muted); }
  figcaption a { font-weight: 560; white-space: nowrap; }
  /* A tablet in portrait: the composition stays one band under the actions, the photograph beside the plate
     and the second course, so the hero keeps its hierarchy without a tall picture. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .bento { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
    .main { grid-column: 1; grid-row: 1 / span 2; }
    .main :global(.thumb) { height: 100%; aspect-ratio: auto; }
    .plate { min-height: 8rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .copy > * { animation: rise 600ms var(--ease) both; }
    .copy > :nth-child(2) { animation-delay: 50ms; }
    .copy > :nth-child(n + 3) { animation-delay: 110ms; }
    .composition { animation: rise 800ms var(--ease) 140ms both; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
</style>
