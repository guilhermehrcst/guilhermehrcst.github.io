---
// The résumé, as one terminal session. Under the site's light header, a dark, full-bleed terminal
// holds the whole page: the title, then one command per section (whoami → projects --selected →
// capabilities → ai-workflow → education → influences → contact → exit), and the footer, where the
// session closes. It is a presentation, not a shell: nothing accepts input.
//
// Every word is server-rendered, semantic HTML from the dictionaries (headings, lists, links); the
// commands come from src/lib/resume-session.ts. On screen, with motion allowed, each step runs as
// the reader scrolls to it (src/scripts/resume-session.ts) and stays: the history is never erased.
// Without JS, under reduced motion and in print, the session is already complete. In print the
// terminal turns into a plain paper résumé. No images.
import Base from '../layouts/Base.astro';
import TermStep from './TermStep.astro';
import ResumeProjects from './ResumeProjects.astro';
import { dicts, routes } from '../i18n/routes';
import { CHAR_MS, OUTPUT_GAP_MS } from '../lib/resume-session';
import { influenceRoster } from '../lib/influence-roster';
import type { Lang } from '../i18n/types';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const r = t.resume;
const other: Lang = lang === 'en' ? 'pt' : 'en';
// "Software Engineer | Backend, Systems & AI": two lines on screen, one string in the DOM.
const [roleA, roleB] = r.whoami.role.split(' | ');
const contactShort = t.contact.items.filter((c) => c.icon !== 'instagram');
---
<Base lang={lang} page="resume" title={r.meta.title} description={r.meta.description}>
  <main id="main" class="term" style={`--t-char: ${CHAR_MS}ms; --t-gap: ${OUTPUT_GAP_MS}ms`}>
    <!-- Hides the steps that have not run yet, before first paint, only when motion is allowed.
         Fail-open: if the session controller has not started within 2.5s, everything shows. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (!d.classList.contains('motion') || !('IntersectionObserver' in window)) return;
        d.classList.add('t-pending');
        setTimeout(function () { if (!d.classList.contains('t-live')) d.classList.remove('t-pending'); }, 2500);
      })();
    </script>

    <div class="t-wrap">
      <header class="t-hero">
        <p class="t-path" aria-hidden="true">{r.terminal.path}</p>
        <h1 class="t-title">{r.heading}<span class="slash" aria-hidden="true">/</span></h1>
        <p class="t-name">Guilherme Henrique</p>
        <p class="t-role"><span class="t-role-a">{roleA}</span><span class="sr-only"> | </span><span class="t-role-b">{roleB}</span></p>
        <div class="t-boot">
          <p aria-hidden="true"><span class="t-ok">●</span> {r.terminal.ready[0]}</p>
          <p aria-hidden="true" class="t-hint">{r.terminal.ready[1]} <span class="t-arrow">↓</span></p>
          <button type="button" class="t-print" data-print hidden>{r.print}</button>
        </div>
      </header>

      <TermStep id="whoami" labelledby="t-whoami-title">
        <h2 id="t-whoami-title" class="sr-only">Guilherme Henrique</h2>
        <p class="t-label">{r.whoami.place}</p>
        <p class="t-lead">{r.whoami.summary}</p>
      </TermStep>

      <TermStep id="projects" labelledby="t-projects-title">
        <h2 id="t-projects-title" class="t-h">{r.work.title}<span class="sl" aria-hidden="true">/</span></h2>
        <ResumeProjects t={t} />
      </TermStep>

      <TermStep id="capabilities" labelledby="t-capabilities-title">
        <h2 id="t-capabilities-title" class="t-h">{r.capabilities.title}<span class="sl" aria-hidden="true">/</span></h2>
        <dl class="t-table">
          {r.capabilities.groups.map((g) => (
            <div>
              <dt>{g.title}</dt>
              <dd><ul class="t-slashes">{g.items.map((i) => <li>{i}</li>)}</ul></dd>
            </div>
          ))}
        </dl>
      </TermStep>

      <TermStep id="ai-workflow" labelledby="t-ai-title">
        <h2 id="t-ai-title" class="t-h">{r.ai.title}<span class="sl" aria-hidden="true">/</span></h2>
        <div class="t-flow-wrap">
          <p class="t-label">{r.ai.flowLabel}</p>
          <ol class="t-flow">
            {r.ai.flow.map((step, i) => (
              <li><span class="t-flow-n" aria-hidden="true">0{i + 1}</span><span class="t-flow-w">{step}</span></li>
            ))}
          </ol>
        </div>
        <p class="t-lead">{r.ai.body}</p>
        <dl class="t-table">
          {[r.ai.models, r.ai.agents].map((g) => (
            <div>
              <dt>{g.label}</dt>
              <dd><ul class="t-slashes">{g.items.map((name) => <li>{name}</li>)}</ul></dd>
            </div>
          ))}
        </dl>
      </TermStep>

      <TermStep id="education" labelledby="t-education-title">
        <h2 id="t-education-title" class="t-h">{r.education.title}<span class="sl" aria-hidden="true">/</span></h2>
        {[r.education, r.coursework].map((s, gi) => (
          <div class="t-group">
            {gi > 0 && <h3 class="t-label">{s.title}</h3>}
            <ul class="t-study">
              {s.items.map((it) => (
                <li>
                  <span class="t-school">{it.school}</span>
                  <span class="t-program">{it.program}</span>
                  {it.status && <span class="t-status">{it.status}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </TermStep>

      <TermStep id="influences" labelledby="t-influences-title">
        <h2 id="t-influences-title" class="t-h">{r.influences.title}<span class="sl" aria-hidden="true">/</span></h2>
        <p class="t-comment">{r.influences.intro}</p>
        <dl class="t-table t-infl">
          {influenceRoster.map((p) => (
            <div><dt>{p.name}</dt><dd>{r.influences.descriptions[p.id]}</dd></div>
          ))}
        </dl>
        <p class="t-quote">{r.influences.quote}</p>
      </TermStep>

      <TermStep id="contact" labelledby="t-contact-title">
        <h2 id="t-contact-title" class="t-h">{t.contact.heading}<span class="sl" aria-hidden="true">/</span></h2>
        <dl class="t-table t-contact">
          {t.contact.items.map((c) => (
            <div><dt>{c.label}</dt><dd><a class="u" href={c.href}>{c.value}</a></dd></div>
          ))}
        </dl>
      </TermStep>

      <TermStep id="exit" as="footer">
        <p class="t-closed" aria-hidden="true">{r.terminal.closed}</p>
        <p class="t-sign">Guilherme Henrique <span aria-hidden="true">·</span> {t.footer.place}</p>
        <ul class="t-links">
          {contactShort.map((c) => <li><a class="u" href={c.href}>{c.label}</a></li>)}
          <li><a class="u" href={routes.resume[other]} lang={other === 'en' ? 'en' : 'pt-BR'} hreflang={other === 'en' ? 'en' : 'pt-BR'}>{other === 'en' ? 'English' : 'Português'}</a></li>
          <li><a class="u" href="#top">{t.footer.top} <span aria-hidden="true">↑</span></a></li>
        </ul>
        <p class="t-updated">{t.footer.updated}</p>
      </TermStep>
    </div>
  </main>
</Base>

<script>
  import '../scripts/resume-session';
  // The print action exists only when it can work: without JS the button stays hidden.
  document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((b) => {
    b.hidden = false;
    b.addEventListener('click', () => window.print());
  });
</script>

<style>
  /* The terminal: dark and full-bleed from under the header to the end of the page. Not a window:
     no frame, no traffic lights, no glow. The palette is the Lume module's (global.css): void,
     white ink, grey for the secondary, hairlines, and the signal blue as the only accent. */
  :global(body:has(.term)) { background: var(--void); }
  .term {
    --fs-t-cmd: clamp(0.8125rem, 0.95vw, 0.9375rem); /* 13-15px */
    --fs-t-h: clamp(2rem, 4.6vw, 4.25rem);
    --fs-t-h3: clamp(1.75rem, 3.2vw, 3rem);
    min-height: 100svh;
    padding-top: calc(var(--header-h) + 1px);
    background: var(--void);
    color: var(--void-ink);
  }
  .term :global(::selection) { background: var(--void-signal); color: var(--void); }
  .term :global(:focus-visible) { outline-color: var(--void-signal); }
  .t-wrap { max-width: 76rem; margin-inline: auto; padding-inline: var(--margin); container-type: inline-size; }

  /* The hero, inside the terminal. */
  .t-hero { padding-block: var(--space-xl) var(--space-lg); border-bottom: 1px solid var(--void-rule); }
  .t-path, .t-boot { font-family: var(--mono); font-size: var(--fs-t-cmd); color: var(--void-muted); }
  .t-title {
    margin-top: var(--space-lg);
    /* CURRÍCULO/ is the widest title (measured advance 5.68em at 700 / opsz 144): it fits the column. */
    font-size: min(10rem, calc(100cqi / 5.68));
    font-weight: var(--display-wght);
    line-height: 0.84;
    letter-spacing: var(--display-track);
    font-variation-settings: var(--display-opsz);
    text-transform: uppercase;
    margin-left: -0.045em;
    padding-top: 0.08em; /* room for the accent of Í */
  }
  .slash, .sl { color: var(--void-signal); }
  .t-name { margin-top: var(--space-lg); font-size: var(--fs-h3); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em; }
  .t-role { margin-top: var(--space-xs); font-size: var(--fs-lead); line-height: 1.3; }
  .t-role-a, .t-role-b { display: block; }
  .t-role-b { color: var(--void-muted); }
  .t-boot { margin-top: var(--space-xl); display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 3ch; row-gap: 4px; }
  .t-ok { color: var(--void-signal); font-size: 0.7em; vertical-align: 0.15em; }
  .t-hint { color: var(--void-ink); }
  .t-arrow { color: var(--void-signal); }
  .t-print {
    margin-left: auto;
    padding: 0 0 2px;
    border: 0;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    color: var(--void-ink);
    font: inherit;
    cursor: pointer;
  }
  .t-print:hover, .t-print:focus-visible { background-image: linear-gradient(var(--void-signal), var(--void-signal)); background-size: 100% 2px; }
  .t-print[hidden] { display: none; }

  /* Output primitives, shared by every step (and ResumeProjects.astro). */
  .term :global(.t-h) {
    font-size: var(--fs-t-h);
    font-weight: var(--display-wght);
    line-height: 0.9;
    letter-spacing: var(--display-track);
    font-variation-settings: var(--display-opsz);
    text-transform: uppercase;
    margin-left: -0.04em;
    margin-bottom: var(--space-lg);
    text-wrap: balance;
  }
  .term :global(.t-label) {
    font-family: var(--mono);
    font-size: var(--fs-t-cmd);
    font-weight: 400;
    color: var(--void-muted);
    letter-spacing: 0;
  }
  .term :global(.t-comment) { font-family: var(--mono); font-size: var(--fs-t-cmd); color: var(--void-muted); margin-bottom: var(--space-md); }
  .term :global(.t-comment::before) { content: '# ' / ''; color: var(--void-signal); }
  .term :global(.t-lead) { max-width: 42em; margin-top: var(--space-sm); font-size: var(--fs-lead); line-height: 1.42; text-wrap: pretty; }
  .term :global(.t-rows li) { padding-block: var(--space-sm); border-top: 1px solid var(--void-rule); line-height: 1.5; text-wrap: pretty; }
  .term :global(.t-rows li::before) { content: '› ' / ''; color: var(--void-signal); font-family: var(--mono); }
  .term :global(.t-kv > div) { padding-block: var(--space-sm); border-top: 1px solid var(--void-rule); }
  .term :global(.t-kv dt) { font-weight: 600; }
  .term :global(.t-kv dd) { margin: 4px 0 0; color: var(--void-muted); line-height: 1.5; }
  .term :global(.t-figs) { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--gap); align-self: start; }
  .term :global(.t-figs > div) { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-xs); padding-top: var(--space-sm); border-top: 2px solid var(--void-signal); }
  .term :global(.t-figs dt) { font-family: var(--mono); font-size: var(--fs-t-cmd); color: var(--void-muted); }
  .term :global(.t-figs dd) { margin: 0; font-size: var(--fs-h3); font-weight: 600; line-height: 1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* Two-column table: label | value, on hairlines. Collapses to one column on a phone. */
  .term :global(.t-table) { border-bottom: 1px solid var(--void-rule); }
  .term :global(.t-table > div) {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    column-gap: var(--space-lg);
    row-gap: 4px;
    padding-block: var(--space-sm);
    border-top: 1px solid var(--void-rule);
    align-items: baseline;
  }
  .term :global(.t-table dt) { font-family: var(--mono); font-size: var(--fs-t-cmd); color: var(--void-muted); }
  .term :global(.t-table dd) { margin: 0; font-size: var(--fs-lead); line-height: 1.4; }
  /* Slash-separated words: the separator is the site's mark, in blue, and it is not read. */
  .t-slashes { display: flex; flex-wrap: wrap; }
  .t-slashes li:not(:last-child)::after { content: '/' / ''; margin-inline: 0.35em; color: var(--void-signal); }

  /* ai-workflow: the method, as four steps on one line. */
  .t-flow-wrap { display: flex; flex-direction: column; gap: var(--space-sm); }
  .t-flow { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); }
  .t-flow li { display: flex; flex-direction: column; gap: var(--space-xs); padding-top: var(--space-sm); border-top: 1px solid var(--void-ink); }
  .t-flow li:first-child { border-top: 2px solid var(--void-signal); }
  .t-flow li:not(:last-child) .t-flow-w::after { content: ' →' / ''; color: var(--void-signal); font-weight: 400; }
  .t-flow-n { font-family: var(--mono); font-size: var(--fs-t-cmd); color: var(--void-muted); }
  .t-flow-w { font-size: min(var(--fs-h3), calc(100cqi / 4 / 7.2)); font-weight: var(--display-wght); line-height: 1; letter-spacing: -0.02em; text-transform: uppercase; white-space: nowrap; }
  .t-flow-wrap + .t-lead { margin-block: var(--space-lg); }

  /* education: school | program | status, one row each; text only. */
  .t-group + .t-group { margin-top: var(--space-lg); }
  .t-group > .t-label { margin-bottom: var(--space-sm); }
  .t-study { border-bottom: 1px solid var(--void-rule); }
  .t-study li {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr);
    column-gap: var(--space-lg);
    row-gap: 4px;
    padding-block: var(--space-sm);
    border-top: 1px solid var(--void-rule);
    align-items: baseline;
  }
  .t-school { font-weight: 600; font-size: var(--fs-lead); line-height: 1.3; }
  .t-program { font-size: var(--fs-lead); line-height: 1.3; }
  .t-status { font-family: var(--mono); font-size: var(--fs-t-cmd); color: var(--void-muted); }

  /* influences: names and one line each. No photographs. */
  .t-infl dd { font-size: var(--fs-body) !important; color: var(--void-muted); }
  .t-infl dt { color: var(--void-ink) !important; font-family: var(--sans) !important; font-size: var(--fs-body) !important; font-weight: 600; }
  .t-quote { margin-top: var(--space-lg); max-width: 34em; font-size: var(--fs-lead); line-height: 1.35; text-wrap: balance; }
  .t-quote::before { content: '“'; color: var(--void-signal); }
  .t-quote::after { content: '”'; color: var(--void-signal); }

  .t-contact a { text-decoration: none; }

  /* exit: the session closes, and the page ends, inside the terminal. */
  .t-closed { font-family: var(--mono); font-size: var(--fs-t-cmd); color: var(--void-muted); }
  .t-sign { margin-top: var(--space-lg); font-size: var(--fs-lead); font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; }
  .t-links { margin-top: var(--space-md); display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-lg); font-family: var(--mono); font-size: var(--fs-t-cmd); }
  .t-links a { text-decoration: none; }
  .t-updated { margin-top: var(--space-md); padding-bottom: var(--space-2xl); font-family: var(--mono); font-size: var(--fs-t-cmd); color: var(--void-muted); }

  @media (max-width: 900px) {
    .term :global(.t-table > div) { grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); }
    .t-study li { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .t-status { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .term :global(.t-table > div), .t-study li { grid-template-columns: minmax(0, 1fr); }
    .t-flow { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-sm); }
    .t-flow-w { font-size: var(--fs-h3); }
    .t-flow li:not(:last-child) .t-flow-w::after { content: ' ↓' / ''; }
    .t-print { margin-left: 0; }
  }

  /* Print → Save as PDF: the terminal turns back into paper. White ground, black text, grey for
     the secondary; no prompt, no session lines, no influences, no exit. Commands stay as small
     grey section labels. The global print rules already drop the site header. */
  @media print {
    @page { margin: 14mm 14mm 16mm; }
    :global(body:has(.term)) { background: var(--gh-white); }
    .term {
      --void-ink: var(--gh-black);
      --void-muted: var(--gh-gray-600);
      --void-rule: var(--gh-gray-200);
      --void-signal: var(--gh-gray-600);
      --fs-t-cmd: 8pt;
      --fs-t-h: 18pt;
      --fs-lead: 10pt;
      --fs-body: 9.5pt;
      --fs-h3: 13pt;
      min-height: 0;
      padding-top: 0;
      font-size: 9.5pt;
      background: none;
      color: var(--gh-black);
    }
    .t-wrap { max-width: none; padding-inline: 0; }
    .t-path, .t-boot, .t-print, .t-closed, .t-links, :global([data-step='influences']), :global([data-step='exit'] .t-cmd) { display: none !important; }
    .t-hero { padding-block: 0 10pt; border-bottom-color: var(--gh-black); }
    .t-title { margin-top: 0; font-size: 36pt; margin-left: 0; }
    .t-name { margin-top: 6pt; font-size: 18pt; }
    .t-sign { margin-top: 0; font-size: 10pt; }
    .t-updated { margin-top: 2pt; padding-bottom: 0; }
    .term :global(.t-h) { margin-bottom: 6pt; }
    .term :global(.t-figs dd) { font-size: 14pt; }
    .t-flow-w { font-size: 11pt; }
    .term :global(.t-table > div), .t-study li, .term :global(.t-rows li), .term :global(.t-kv > div) { padding-block: 3pt; break-inside: avoid; }
    .term :global(.t-h), .t-hero { break-after: avoid; }
    .t-flow, .t-group, .term :global(.t-figs) { break-inside: avoid; }
    a { color: inherit; }
  }
</style>
