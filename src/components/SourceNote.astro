---
// "Fonte oficial: …, verificada em …": the official page a claim rests on, and when it was verified
// (spec §6.5). The link opens in a new tab and says so. When the section already shows that very page as a
// resource (V0.4 QA P2-RC5), the note still cites the source and its date but points to the resource on
// this page (`inPage`, its anchor id), so the external link appears once.
import { officialSources, type OfficialSourceId } from '../lib/official-sources';
import { formatDate } from '../lib/dates';
import { pt as t } from '../i18n/pt';

interface Props { source: OfficialSourceId; inPage?: string | undefined }
const s = officialSources[Astro.props.source];
const { inPage } = Astro.props;
---
<p class="source" data-source-note>
  {t.source.label}{' '}{inPage
    ? <a href={`#${inPage}`}>{s.title}</a>
    : <a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}<span class="sr-only"> ({t.resource.newTab})</span></a>},{' '}<time datetime={s.verified.on}>{t.source.verified(formatDate(s.verified.on))}</time>.
</p>

<style>
  .source { margin-top: var(--space-4); font-size: var(--fs-small); color: var(--muted); }
  .source a { color: var(--ink); }
</style>
