---
// An institution's round avatar beside a course (V0.7). Its official mark only when the mark is square
// enough to sit in a circle without being cut or shrunk to nothing (today, Harvard's shield); otherwise its
// initials (initialsOf). Decorative: the institution's name is written beside it.
import { Image } from 'astro:assets';
import { providerMarks } from '../lib/providers';
import { initialsOf } from '../lib/course-library';

interface Props { provider: string }
const { provider } = Astro.props;
const marks = providerMarks[provider];
const mark = marks?.length === 1 ? marks[0] : undefined;
const square = mark ? (() => { const [x0, y0, x1, y1] = mark.bbox; const r = (x1 - x0) / (y1 - y0); return r > 0.8 && r < 1.25; })() : false;
---
<span class="avatar" aria-hidden="true" data-avatar={square ? 'mark' : 'initials'}>
  {square && mark ? (
    <Image src={mark.src} alt="" width={30} height={30} densities={[1, 2, 3]} format="png" />
  ) : (
    <span class="initials">{initialsOf(provider)}</span>
  )}
</span>

<style>
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--surface);
  }
  .avatar[data-avatar='mark'] { background: var(--raised); padding: 3px; box-shadow: inset 0 0 0 1px var(--rule); }
  .avatar :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .initials { font-size: 0.6875rem; font-weight: 650; letter-spacing: 0.02em; color: var(--ink); }
</style>
