---
// Mono section label. The visible copy may "decode" once on first view
// (scripts/scramble.ts); assistive tech reads the stable text only.
interface Props { text: string; class?: string }
const { text, class: cls } = Astro.props;
---
<p class:list={['meta', 'label', cls]}>
  <span class="sr-only">{text}</span>
  <span aria-hidden="true" data-scramble>{text}</span>
  <span class="sq" aria-hidden="true"></span>
</p>

<style>
  .label { display: flex; align-items: center; gap: 8px; color: inherit; }
  .sq { width: 7px; height: 7px; background: var(--signal); flex: none; }
  :global(.lume) .sq { background: var(--void-signal); }
  [data-scramble] { white-space: pre; }
</style>
