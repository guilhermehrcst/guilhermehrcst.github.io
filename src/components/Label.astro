---
// Section label: "NN / Name". The slash is the site's mark: blue, and it slides in once on
// first view (scripts/motion.ts). Assistive tech reads the stable text only.
interface Props { text: string; class?: string }
const { text, class: cls } = Astro.props;
const [num, ...rest] = text.split(' / ');
const name = rest.join(' / ');
---
<p class:list={['meta', 'label', cls]}>
  <span class="sr-only">{text}</span>
  <span aria-hidden="true">{num}</span>
  <span class="sl rv-slash" aria-hidden="true" data-reveal>/</span>
  <span aria-hidden="true">{name}</span>
</p>

<style>
  .label { display: flex; align-items: baseline; gap: 0.7em; color: inherit; }
</style>
