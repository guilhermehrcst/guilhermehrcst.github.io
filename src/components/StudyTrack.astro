---
import Base from '../layouts/Base.astro';
import Monument from './Monument.astro';
import StudyTrackSection from './StudyTrackSection.astro';
import { dicts, routes } from '../i18n/routes';
import { studyTracks } from '../lib/study-tracks';
import type { ExamId } from '../lib/study-tracks';
import type { Lang, RouteId } from '../i18n/types';

interface Props { lang: Lang; exam: ExamId }
const { lang, exam } = Astro.props;
const t = dicts[lang].studyTracks[exam];
const courses = dicts[lang].courses;
const definition = studyTracks[exam];
const routeId: RouteId = exam === 'enem' ? 'courses-enem' : 'courses-uerj';
---
<Base lang={lang} page={routeId} title={t.meta.title} description={t.meta.description}>
  <main id="main" class="track">
    <div class="frame">
      <header class="hero">
        <p class="meta eyebrow">{t.eyebrow.map((word, index) => (<>{index > 0 && <span class="slash" aria-hidden="true">/</span>}<span>{word}</span></>))}</p>
        <h1>{t.heading}<span class="slash" aria-hidden="true">/</span></h1>
        <p class="intro">{t.intro}</p>
        <a class="back" href={routes.courses[lang]}>← {t.back}</a>
      </header>

      <nav class="track-nav" aria-label={t.navLabel}>
        <ul>
          {definition.sections.map((section) => <li><a href={`#track-${section.id}`}>{t.sections[section.id].title}</a></li>)}
        </ul>
      </nav>

      {definition.sections.map((section, index) => (
        <StudyTrackSection index={index} definition={section} copy={t.sections[section.id]} courses={courses} />
      ))}

      <section class="closing">
        <h2>{t.closing.title}<span class="slash" aria-hidden="true">/</span></h2>
        <div>
          <p>{t.closing.body}</p>
          <a href={routes.courses[lang]}>{t.closing.cta} <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </div>
  </main>
  <Monument lang={lang} page="courses" />
</Base>

<style>
  .track { padding-top: var(--header-h); }
  .frame { margin-inline: var(--margin); border-inline: 1px solid var(--rule); }
  .hero { min-height: clamp(460px, 70svh, 760px); display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); grid-template-rows: auto 1fr auto; border-bottom: 1px solid var(--rule); }
  .eyebrow { grid-column: 1 / -1; display: flex; gap: 0.75em; padding: var(--space-lg); color: var(--muted); border-bottom: 1px solid var(--rule); }
  .hero h1 { align-self: end; padding: var(--space-lg); font-size: clamp(3rem, 8vw, 9rem); font-weight: 600; line-height: 0.88; letter-spacing: -0.035em; overflow-wrap: anywhere; }
  .intro { align-self: end; padding: var(--space-lg); border-left: 1px solid var(--rule); color: var(--muted); font-size: var(--fs-lead); line-height: 1.4; }
  .back { grid-column: 1 / -1; padding: var(--space-md) var(--space-lg); border-top: 1px solid var(--rule); text-decoration: none; font-weight: 600; }
  .track-nav { border-bottom: 1px solid var(--rule); }
  .track-nav ul { display: flex; overflow-x: auto; scrollbar-width: none; }
  .track-nav a { display: flex; align-items: center; min-height: 56px; padding-inline: var(--space-md); white-space: nowrap; text-decoration: none; border-right: 1px solid var(--rule); }
  .closing { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); min-height: 260px; }
  .closing h2 { display: flex; align-items: flex-end; padding: var(--space-lg); font-size: clamp(2rem, 5vw, 5.5rem); line-height: 0.95; letter-spacing: -0.025em; }
  .closing > div { display: flex; flex-direction: column; justify-content: flex-end; gap: var(--space-md); padding: var(--space-lg); border-left: 1px solid var(--rule); color: var(--muted); }
  .closing a { color: var(--ink); font-weight: 600; text-decoration: none; }
  @media (max-width: 640px) {
    .hero { grid-template-columns: 1fr; grid-template-rows: auto auto auto auto; min-height: 0; }
    .eyebrow, .hero h1, .intro, .back { grid-column: 1; }
    .hero h1 { padding: var(--space-xl) var(--space-md); }
    .eyebrow, .intro, .back { padding-inline: var(--space-md); }
    .intro { border-left: 0; border-top: 1px solid var(--rule); }
    .closing { grid-template-columns: 1fr; min-height: 0; }
    .closing h2, .closing > div { padding: var(--space-xl) var(--space-md); }
    .closing > div { border-left: 0; border-top: 1px solid var(--rule); }
  }
</style>
