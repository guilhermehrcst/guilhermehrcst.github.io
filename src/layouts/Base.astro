---
// The page shell: head (title, description, canonical, Open Graph), skip link, header, main, footer.
// Google Sans Flex and Newsreader (both OFL-1.1), self-hosted from @fontsource-variable: weight and
// optical size only, Latin preloaded.
// V0.1 is Portuguese only and carries no hreflang (spec §6.6). No JavaScript here.
import '@fontsource-variable/google-sans-flex/opsz.css';
import '@fontsource-variable/newsreader/opsz.css';
import '../styles/global.css';
import sansLatin from '@fontsource-variable/google-sans-flex/files/google-sans-flex-latin-opsz-normal.woff2?url';
import serifLatin from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BottomNav from '../components/BottomNav.astro';
import { pt as t } from '../i18n/pt';

interface Props {
  title: string;
  description: string;
  /** The 404 and nothing else: not indexed, no canonical. */
  noindex?: boolean;
  /** The bottom navigation of the video library, below 1024px (/cursos/, V0.7). */
  bottomNav?: boolean;
}

const { title, description, noindex = false, bottomNav = false } = Astro.props;
const site = Astro.site ?? new URL('https://guilhermehrcst.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
---
<!doctype html>
<html lang={t.htmlLang} data-bottom-nav={bottomNav || undefined}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
  <meta name="theme-color" content="#faf8f4">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {!noindex && <meta property="og:url" content={canonical}>}
  <meta property="og:locale" content={t.ogLocale}>
  <meta property="og:site_name" content={t.siteName}>
  <meta name="twitter:card" content="summary">
  <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin>
  <!-- The official symbol on the brand red (scripts/brand-assets.mjs). -->
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <SiteHeader />
  <main id="main">
    <slot />
  </main>
  <SiteFooter />
  {bottomNav && <BottomNav />}
</body>
</html>
