---
// /enem/: a preparation hub, not a list of courses (spec §6.3). Understand the exam from INEP, study
// by area as INEP organises it, practise with official material, then go deeper by area.
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import TrackSection from '../../components/TrackSection.astro';
import SourceNote from '../../components/SourceNote.astro';
import ResourceList from '../../components/ResourceList.astro';
import SubjectLinks from '../../components/SubjectLinks.astro';
import { ENEM_AREAS, resolveGuide } from '../../lib/exam-guides';
import { routes } from '../../lib/routes';
import { OBJECTIVES } from '../../lib/taxonomy';
import { pt as t } from '../../i18n/pt';

const c = t.pages.enem;
const g = t.guides.enem;
const sections = new Map(resolveGuide('enem').map((s) => [s.id, s]));
const practice = sections.get('pratique');
const deepen = sections.get('aprofunde');
const deepenByArea = ENEM_AREAS
  .map((area) => ({ ...area, resources: (deepen?.resources ?? []).filter((r) => r.subject !== null && area.subjects.includes(r.subject)) }))
  .filter((area) => area.resources.length > 0);
---
<Base title={c.title} description={c.description}>
  <PageIntro eyebrow={c.eyebrow} heading={c.heading} lead={c.lead} crumbs={[{ label: OBJECTIVES.vestibulares.label, href: routes.objective('vestibulares') }]} />

  <TrackSection id="entenda" title={g.entenda.title}>
    <div class="prose">
      {g.entenda.body.map((p) => <p>{p}</p>)}
      <SourceNote source="inep-matrizes" />
    </div>
  </TrackSection>

  <TrackSection id="areas" title={g.areas.title} why={g.areas.why}>
    <ul class="exam-areas" role="list">
      {ENEM_AREAS.map((area) => (
        <li>
          <div data-exam-area={area.id}>
            <h3>{area.label}</h3>
            <SubjectLinks subjects={area.subjects} />
          </div>
        </li>
      ))}
    </ul>
  </TrackSection>

  {practice && (
    <TrackSection id="pratique" title={g.pratique.title} why={g.pratique.why}>
      <SourceNote source="inep-provas-gabaritos" />
      {practice.resources.length > 0 && <div class="after-note"><ResourceList resources={practice.resources} /></div>}
    </TrackSection>
  )}

  {deepen && (
    <TrackSection id="aprofunde" title={g.aprofunde.title} why={g.aprofunde.why}>
      {deepenByArea.map((area) => (
        <div class="group">
          <h3>{area.label}</h3>
          <ResourceList resources={area.resources} headingLevel={4} compact />
        </div>
      ))}
    </TrackSection>
  )}
</Base>

<style>
  .prose { max-width: var(--measure); }
  .prose p + p { margin-top: var(--space-4); }
  .exam-areas { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: var(--space-7); }
  @media (min-width: 768px) { .exam-areas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .exam-areas > li { padding-block: var(--space-4) var(--space-5); border-top: 1px solid var(--rule); }
  .exam-areas h3, .group h3 { font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-2); }
  .after-note { margin-top: var(--space-5); }
  .group + .group { margin-top: var(--space-6); }
</style>
