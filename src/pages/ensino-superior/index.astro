---
// /ensino-superior/ (V0.3): university courses already verified in the catalogue, grouped by field
// (src/lib/higher-education.ts, fail-closed ids). It says plainly which fields it covers today; it never
// presents a curriculum or a degree.
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import TrackSection from '../../components/TrackSection.astro';
import ResourceList from '../../components/ResourceList.astro';
import FeaturedResources from '../../components/FeaturedResources.astro';
import { higherEducation } from '../../lib/higher-education';
import { anchorPlan } from '../../lib/search-index';
import { superiorCopyFor } from '../../lib/superior-copy';
import { routes } from '../../lib/routes';
import { pt as t } from '../../i18n/pt';

const c = t.pages['ensino-superior'];
const groups = higherEducation();
const copy = superiorCopyFor(groups);
// A resource-home anchor is attached at its first occurrence, exactly as on Tecnologia and ENEM.
// New conditional fields stay absent until a verified course is actually published.
const anchors = anchorPlan(routes.objective('ensino-superior'), groups.map((group) => group.resources));
---
<Base title={c.title} description={copy.description}>
  <PageIntro eyebrow={c.eyebrow} heading={c.heading} lead={c.lead} />
  <p class="wrap note">{copy.note}</p>
  <FeaturedResources path="ensino-superior" />

  {groups.map((group, i) => (
    <TrackSection id={group.id} title={group.label} why={group.why}>
      <ResourceList resources={group.resources} anchored={anchors[i]} />
    </TrackSection>
  ))}
</Base>

<style>
  .note { max-width: var(--measure); margin-bottom: var(--space-4); padding-left: var(--space-4); border-left: 2px solid var(--action); color: var(--ink); }
</style>
