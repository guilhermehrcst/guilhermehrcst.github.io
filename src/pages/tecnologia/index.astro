---
// /tecnologia/: the technology objective and area, organised by tracks (spec §6.3). The page opens with
// the choice of a track, then each track with its resources, in order. Planned tracks are not shown.
// V0.4: the chooser is the shared SectionNav; the editorial highlights follow it once complete. The seven
// tracks and their resources stay whole: the highlights never truncate the catalogue.
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import TrackSection from '../../components/TrackSection.astro';
import ResourceList from '../../components/ResourceList.astro';
import SectionNav from '../../components/SectionNav.astro';
import FeaturedResources from '../../components/FeaturedResources.astro';
import { featuredShown } from '../../lib/featured';
import { anchorPlan } from '../../lib/search-index';
import { routes } from '../../lib/routes';
import { resourcesByIds } from '../../lib/learning-library';
import { publishedResources } from '../../lib/learning-resources';
import { publishedTracks } from '../../lib/tech-tracks';
import { pt as t } from '../../i18n/pt';

const c = t.pages.tecnologia;
const tracks = publishedTracks().map((track) => ({ ...track, resources: resourcesByIds(publishedResources, track.resourceIds) }));
const plan = anchorPlan(routes.objective('tecnologia'), tracks.map((track) => track.resources));
const nav = [
  ...(featuredShown('tecnologia') ? [{ id: 'destaques', label: t.featured.title }] : []),
  ...tracks.map((track) => ({ id: track.id, label: track.label, why: track.why })),
];
---
<Base title={c.title} description={c.description} courseEdition>
  <PageIntro eyebrow={c.eyebrow} heading={c.heading} lead={c.lead} />

  <SectionNav id="chooser" title={t.tecnologia.chooser} items={nav} />
  <FeaturedResources path="tecnologia" />

  {tracks.map((track, i) => (
    <TrackSection id={track.id} track={track.id} title={track.label} why={track.why}>
      <ResourceList resources={track.resources} anchored={plan[i]} />
    </TrackSection>
  ))}
</Base>
