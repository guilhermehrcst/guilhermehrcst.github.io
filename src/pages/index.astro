---
// The Home (Home V1) answers three questions fast: what can I learn here (the search and the six paths),
// where is the content (a sample of the course library, the areas), how do I start (ready paths). Order:
// hero, paths, featured courses, ready paths, areas, commitments, questions. The Home lists courses only in
// #cursos, a small editorial sample from the published library (src/lib/home-featured.ts), never a copy.
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import HomePaths from '../components/HomePaths.astro';
import HomeAreas from '../components/HomeAreas.astro';
import CourseCard from '../components/CourseCard.astro';
import OfficialSources from '../components/OfficialSources.astro';
import FeaturedPaths from '../components/FeaturedPaths.astro';
import { courseCards } from '../lib/course-library';
import { featuredCourses } from '../lib/home-featured';
import { routes } from '../lib/routes';
import { VERIFIED_ON } from '../lib/learning-resources';
import { formatDate } from '../lib/dates';
import { pt as t } from '../i18n/pt';

const c = t.pages.home;
const cur = t.home.curation;
const cards = courseCards();
const featured = featuredCourses().map((r) => cards.find((card) => card.resource.id === r.id)!);
---
<Base title={c.title} description={c.description}>
  <HomeHero />

  <section class="wrap block" id="objetivo" aria-labelledby="objetivo-title">
    <div class="head">
      <h2 id="objetivo-title">{t.home.objectives.heading}</h2>
      <p>{t.home.objectives.lead}</p>
    </div>
    <HomePaths />
  </section>

  <section class="wrap block" id="cursos" aria-labelledby="cursos-title">
    <div class="head">
      <h2 id="cursos-title">{t.home.courses.heading}</h2>
      <p>{t.home.courses.lead}</p>
    </div>
    <ul class="courses" role="list" data-resource-list>
      {featured.map((card) => <CourseCard card={card} />)}
    </ul>
    <p class="all"><a href={routes.courses}>{t.home.courses.all}{' '}<span aria-hidden="true">→</span></a></p>
  </section>

  <section class="wrap block" id="trilhas" aria-labelledby="trilhas-title">
    <div class="head">
      <h2 id="trilhas-title">{t.home.tracks.heading}</h2>
      <p>{t.home.tracks.lead}</p>
    </div>
    <FeaturedPaths />
  </section>

  <section class="wrap block" id="areas" aria-labelledby="areas-title">
    <div class="head">
      <h2 id="areas-title">{t.home.areas.heading}</h2>
      <p>{t.home.areas.lead}</p>
    </div>
    <HomeAreas />
  </section>

  <section class="wrap block" id="curadoria" aria-labelledby="curadoria-title">
    <div class="head">
      <h2 id="curadoria-title">{cur.heading}</h2>
      <p>{cur.lead}</p>
    </div>
    <ol class="commitments" role="list">
      {cur.commitments.map((item, i) => (
        <li>
          <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ol>
    <div class="proof">
      <p class="stamp"><span class="dot" aria-hidden="true"></span><time datetime={VERIFIED_ON}>{cur.verified(formatDate(VERIFIED_ON))}</time></p>
      <p class="more"><a href={routes.about}>{cur.more}{' '}<span aria-hidden="true">→</span></a></p>
    </div>
    <OfficialSources />
  </section>

  <section class="wrap block" id="perguntas" aria-labelledby="perguntas-title">
    <div class="faq">
      <h2 id="perguntas-title">{t.home.faq.heading}</h2>
      <div class="questions">
        {t.home.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .block { padding-block: var(--space-6); }
  .block + .block { border-top: 1px solid var(--rule); }
  /* A section's head: the title, and beside it on a wide screen, one line of what follows. */
  .head { display: grid; gap: var(--space-2) var(--space-7); margin-bottom: var(--space-5); }
  .head h2 { font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.375rem); max-width: 20ch; }
  .head p { max-width: 44ch; color: var(--muted); }
  @media (min-width: 1024px) { .head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; } }

  /* Featured courses: the library's cards; a sideways row on a phone, two columns on a tablet, four wide. */
  .courses { display: grid; grid-auto-flow: column; grid-auto-columns: 82%; gap: var(--space-4); margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none; }
  .courses::-webkit-scrollbar { display: none; }
  .courses > :global(li) { scroll-snap-align: start; }
  @media (min-width: 600px) { .courses { grid-auto-flow: row; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-4); margin-inline: 0; padding-inline: 0; overflow: visible; } }
  @media (min-width: 1100px) { .courses { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .all { margin-top: var(--space-5); }
  .all a, .more a { display: inline-flex; align-items: center; gap: 0.35em; min-height: 44px; font-weight: 560; }

  /* Commitments: three short promises, numbered; then the date of the last verification and the rules. */
  .commitments { display: grid; gap: var(--space-4); }
  @media (min-width: 900px) { .commitments { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); } }
  .commitments li { display: grid; align-content: start; gap: var(--space-2); padding-top: var(--space-4); border-top: 2px solid var(--action); }
  .commitments .n { font-size: var(--fs-small); font-variant-numeric: tabular-nums; color: var(--muted); }
  .commitments h3 { font-family: var(--serif); font-size: 1.375rem; font-weight: 460; letter-spacing: -0.01em; }
  .commitments p { max-width: 44ch; font-size: 0.9375rem; color: var(--muted); }
  .proof { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); margin-block: var(--space-5) var(--space-6); }
  .stamp { display: inline-flex; align-items: center; gap: var(--space-2); padding: 0.3rem 0.75rem; border: 1px solid var(--rule-strong); border-radius: 999px; font-size: var(--fs-small); font-weight: 500; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--action); }

  /* Questions: a narrow column of native disclosures; the marker is drawn, the state is the browser's. */
  .faq { display: grid; gap: var(--space-4); }
  @media (min-width: 1024px) { .faq { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-7); } }
  .faq h2 { font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.375rem); }
  .questions { border-top: 1px solid var(--rule-strong); }
  details { border-bottom: 1px solid var(--rule); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 52px;
    padding-block: var(--space-2);
    font-weight: 560;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '';
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.3rem;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: translateY(-25%) rotate(45deg);
    transition: transform var(--t-ui) var(--ease);
  }
  details[open] summary::after { transform: translateY(25%) rotate(-135deg); }
  summary:hover { color: var(--action); }
  details p { max-width: 60ch; padding-bottom: var(--space-4); color: var(--muted); }
</style>
