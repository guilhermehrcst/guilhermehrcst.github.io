---
// The Home (V2) answers three questions fast: what can I learn here (the search and the six paths), where is
// the content (a sample of the course library, the areas), how do I start (ready paths); then who publishes
// it and what the Academy promises. Order: hero, paths, featured courses, ready paths, areas, institutions,
// commitments, questions. The Home lists courses only in #cursos, a small editorial sample from the published
// library (src/lib/home-featured.ts), never a copy. Each section opens with the same head: a wine eyebrow,
// the serif title and one line of what follows.
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import HomePaths from '../components/HomePaths.astro';
import HomeAreas from '../components/HomeAreas.astro';
import HomeCourseFeature from '../components/HomeCourseFeature.astro';
import OfficialSources from '../components/OfficialSources.astro';
import FeaturedPaths from '../components/FeaturedPaths.astro';
import { courseCards } from '../lib/course-library';
import { featuredCourses } from '../lib/home-featured';
import { routes } from '../lib/routes';
import { VERIFIED_ON } from '../lib/learning-resources';
import { formatDate } from '../lib/dates';
import { pt as t } from '../i18n/pt';

const c = t.pages.home;
const cur = t.home.curation;
const cards = courseCards();
const featured = featuredCourses().map((r) => cards.find((card) => card.resource.id === r.id)!);
---
<Base title={c.title} description={c.description}>
  <HomeHero />

  <section class="wrap block" id="objetivo" aria-labelledby="objetivo-title">
    <div class="head head-stack">
      <div><p class="kicker">{t.home.objectives.eyebrow}</p><h2 id="objetivo-title">{t.home.objectives.heading}</h2></div>
      <p class="lead">{t.home.objectives.lead}</p>
    </div>
    <HomePaths />
  </section>

  <section class="block band" id="cursos" aria-labelledby="cursos-title">
    <div class="wrap">
      <div class="head head-art">
        <div><p class="kicker">{t.home.courses.eyebrow}</p><h2 id="cursos-title">{t.home.courses.heading}</h2><p class="lead">{t.home.courses.lead}</p></div>
        <a class="all" href={routes.courses}>{t.home.courses.all}{' '}<span aria-hidden="true">→</span></a>
      </div>
      <ul class="courses" role="list" data-resource-list>
        {featured.map((card) => <HomeCourseFeature card={card} />)}
      </ul>
      <p class="swipe swipe-courses" aria-hidden="true">{t.home.courses.swipe} <span>→</span></p>
    </div>
  </section>

  <section class="wrap block" id="trilhas" aria-labelledby="trilhas-title">
    <div class="head">
      <div><p class="kicker">{t.home.tracks.eyebrow}</p><h2 id="trilhas-title">{t.home.tracks.heading}</h2></div>
      <p class="lead">{t.home.tracks.lead}</p>
    </div>
    <FeaturedPaths />
  </section>

  <section class="wrap block" id="areas" aria-labelledby="areas-title">
    <div class="head">
      <div><p class="kicker">{t.home.areas.eyebrow}</p><h2 id="areas-title">{t.home.areas.heading}</h2></div>
      <p class="lead">{t.home.areas.lead}</p>
    </div>
    <HomeAreas />
  </section>

  <section class="wrap block" id="fontes" aria-labelledby="fontes-title">
    <div class="head">
      <div><p class="kicker">{t.home.sources.eyebrow}</p><h2 id="fontes-title">{t.home.sources.heading}</h2></div>
      <p class="lead">{t.home.sources.lead}</p>
    </div>
    <OfficialSources />
  </section>

  <section class="wrap block" id="curadoria" aria-labelledby="curadoria-title">
    <div class="head">
      <div><p class="kicker">{cur.eyebrow}</p><h2 id="curadoria-title">{cur.heading}</h2></div>
      <p class="lead">{cur.lead}</p>
    </div>
    <ol class="commitments" role="list">
      {cur.commitments.map((item, i) => (
        <li>
          <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ol>
    <div class="proof">
      <p class="stamp"><span class="dot" aria-hidden="true"></span><time datetime={VERIFIED_ON}>{cur.verified(formatDate(VERIFIED_ON))}</time></p>
      <p class="more"><a href={routes.about}>{cur.more}{' '}<span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="wrap block" id="perguntas" aria-labelledby="perguntas-title">
    <div class="faq">
      <h2 id="perguntas-title">{t.home.faq.heading}</h2>
      <div class="questions">
        {t.home.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* V2.1 rhythm: about 96px between chapters on a wide screen, 72px on a tablet, 56px on a phone (two paddings
     meet), 32px from a head to its content, smaller steps inside the cards. The sections are told apart by
     their heads and grounds; a hairline marks only the quieter run at the end (sources, commitments, questions),
     inside the gutters: never a border on .wrap, whose padding is the gutter. */
  .block { position: relative; padding-block: clamp(1.75rem, 1.2rem + 2.2vw, 3rem); }
  #curadoria::before, #perguntas::before { content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); height: 1px; background: var(--rule); }
  /* The featured courses sit on a quiet band across the page: the library, opened. */
  .band { background: var(--tint-sand); padding-block: clamp(2.25rem, 1.5rem + 2.8vw, 3.75rem); }
  /* A section's head: the eyebrow and the title, and beside them on a wide screen, one line of what follows. */
  .head { display: grid; gap: var(--space-3) var(--space-7); margin-bottom: var(--space-6); }
  .kicker { margin-bottom: var(--space-2); font-size: 0.75rem; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase; color: var(--action); }
  .head h2 { font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem); font-weight: 420; line-height: 1.02; letter-spacing: -0.03em; max-width: 18ch; }
  .head .lead { max-width: 44ch; color: var(--muted); }
  .side { display: grid; gap: var(--space-3); justify-items: start; }
  @media (min-width: 1024px) { .head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; } }

  /* Featured courses (after ART Course): the title at the left, the way to all at the right; the cards in one
     staggered row (the first and third lower, so the others read raised), sideways on a phone and a tablet. */
  /* The paths' head (V2.2): the title with its line right under it, on one reading width, at every width. */
  .head.head-stack { grid-template-columns: minmax(0, 1fr); gap: var(--space-3); margin-bottom: var(--space-5); }
  .head-stack .lead { max-width: 46ch; font-size: var(--fs-lead); line-height: 1.45; }
  .head-art { grid-template-columns: minmax(0, 1fr); align-items: end; }
  .head-art .lead { margin-top: var(--space-3); }
  .head-art .all { justify-self: start; }
  @media (min-width: 900px) { .head-art { grid-template-columns: minmax(0, 1fr) auto; } .head-art .all { justify-self: end; } }
  .courses { display: grid; grid-auto-flow: column; grid-auto-columns: 76%; gap: var(--space-4); margin-inline: calc(-1 * var(--gutter)); padding: var(--space-2) var(--gutter) var(--space-4); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none; }
  .courses::-webkit-scrollbar { display: none; }
  .courses > :global(li) { scroll-snap-align: start; }
  @media (min-width: 600px) { .courses { grid-auto-columns: 42%; gap: var(--space-5); } }
  @media (min-width: 1100px) {
    .courses { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-inline: 0; padding: 0 0 var(--space-5); overflow: visible; }
    .courses > :global(li:nth-child(odd)) { translate: 0 var(--space-5); }
  }
  /* The cue under a sideways row: a phone and a tablet only (the row is whole on a wide screen). */
  .swipe { display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-2); font-size: 0.8125rem; font-weight: 560; color: var(--muted); }
  @media (min-width: 1100px) { .swipe-courses { display: none; } }
  .all {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 44px;
    padding-inline: var(--space-5);
    border-radius: 999px;
    background: var(--action);
    color: var(--on-action);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--t-ui);
  }
  .all:hover { background: var(--action-hover); color: var(--on-action); }
  .more a { display: inline-flex; align-items: center; gap: 0.35em; min-height: 44px; font-weight: 560; }

  /* Commitments: three short promises, numbered; then the date of the last verification and the rules. */
  .commitments { display: grid; gap: var(--space-4); }
  @media (min-width: 900px) { .commitments { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); } }
  /* A hairline over each promise and a short wine mark at its start: the colour points, the line organises. */
  .commitments li { position: relative; display: grid; align-content: start; gap: var(--space-3); padding-top: var(--space-5); border-top: 1px solid var(--rule-strong); }
  .commitments li::before { content: ''; position: absolute; top: -1px; left: 0; width: 2rem; height: 2px; background: var(--action); }
  .commitments .n { font-size: 0.75rem; font-weight: 650; font-variant-numeric: tabular-nums; letter-spacing: 0.06em; color: var(--action); }
  .commitments h3 { font-family: var(--serif); font-size: clamp(1.5rem, 1.3rem + 0.5vw, 1.75rem); font-weight: 440; line-height: 1.1; letter-spacing: -0.02em; }
  .commitments p { max-width: 42ch; font-size: 0.9375rem; line-height: 1.6; color: var(--muted); }
  .proof { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); margin-top: var(--space-6); }
  .stamp { display: inline-flex; align-items: center; gap: var(--space-2); font-size: 0.8125rem; color: var(--muted); }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--action); }

  /* Questions: a narrow column of native disclosures; the marker is drawn, the state is the browser's. */
  .faq { display: grid; gap: var(--space-4); }
  @media (min-width: 1024px) { .faq { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-7); } }
  .faq h2 { font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem); font-weight: 420; line-height: 1.02; letter-spacing: -0.03em; }
  .questions { border-top: 1px solid var(--rule-strong); }
  details { border-bottom: 1px solid var(--rule); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    padding-block: var(--space-3);
    font-size: 1.0625rem;
    font-weight: 560;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '';
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.3rem;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: translateY(-25%) rotate(45deg);
    transition: transform var(--t-ui) var(--ease);
  }
  details[open] summary::after { transform: translateY(25%) rotate(-135deg); border-color: var(--action); }
  details[open] summary { color: var(--action); }
  summary:hover { color: var(--action); }
  summary:focus-visible { outline: 2px solid var(--action); outline-offset: 2px; border-radius: 4px; }
  details p { max-width: 60ch; padding: 0 var(--space-6) var(--space-5) 0; line-height: 1.65; color: var(--muted); }
</style>
