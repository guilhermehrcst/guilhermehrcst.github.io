---
// The Home orients; it does not pour out content (spec §5.2). Objective → path → area; no resource list here.
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import ObjectiveList from '../components/ObjectiveList.astro';
import AreaList from '../components/AreaList.astro';
import LearningPath from '../components/LearningPath.astro';
import OfficialSources from '../components/OfficialSources.astro';
import FeaturedPaths from '../components/FeaturedPaths.astro';
import { routes } from '../lib/routes';
import { VERIFIED_ON } from '../lib/learning-resources';
import { formatDate } from '../lib/dates';
import { pt as t } from '../i18n/pt';

const c = t.pages.home;
const cur = t.home.curation;
---
<Base title={c.title} description={c.description}>
  <HomeHero />

  <section class="wrap block" id="objetivo" aria-labelledby="objetivo-title">
    <div class="head">
      <h2 id="objetivo-title">{t.home.objectives.heading}</h2>
      <p>{t.home.objectives.lead}</p>
    </div>
    <ObjectiveList />
  </section>

  <section class="wrap block" id="caminho" aria-labelledby="caminho-title">
    <div class="head">
      <h2 id="caminho-title">{t.home.path.heading}</h2>
      <p>{t.home.path.lead}</p>
    </div>
    <LearningPath />
  </section>

  <section class="wrap block" id="fontes" aria-labelledby="fontes-title">
    <div class="head">
      <h2 id="fontes-title">{t.home.sources.heading}</h2>
      <p>{t.home.sources.lead}</p>
    </div>
    <OfficialSources />
  </section>

  <section class="wrap block" id="areas" aria-labelledby="areas-title">
    <div class="head">
      <h2 id="areas-title">{t.home.areas.heading}</h2>
      <p>{t.home.areas.lead}</p>
    </div>
    <AreaList />
  </section>

  <section class="wrap block" id="trilhas" aria-labelledby="trilhas-title">
    <div class="head">
      <h2 id="trilhas-title">{t.home.tracks.heading}</h2>
      <p>{t.home.tracks.lead}</p>
    </div>
    <FeaturedPaths />
  </section>

  <section class="wrap block" id="curadoria" aria-labelledby="curadoria-title">
    <div class="policy">
      <div class="policy-lead">
        <h2 id="curadoria-title">{cur.heading}</h2>
        <p class="statement">{cur.statement}</p>
        <p class="stamp"><span class="dot" aria-hidden="true"></span><time datetime={VERIFIED_ON}>{cur.verified(formatDate(VERIFIED_ON))}</time></p>
        <p class="more"><a href={routes.about}>{cur.more}{' '}<span aria-hidden="true">→</span></a></p>
      </div>
      <ol class="rules" role="list">
        {cur.rules.map((rule, i) => (
          <li>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{rule.title}</h3>
            <p>{rule.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wrap block" id="perguntas" aria-labelledby="perguntas-title">
    <div class="faq">
      <h2 id="perguntas-title">{t.home.faq.heading}</h2>
      <div class="questions">
        {t.home.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .block { padding-block: var(--space-7); }
  .block > h2 { font-size: var(--fs-h2); margin-bottom: var(--space-5); }
  /* A section's head: the title, and beside it on a wide screen, one line of what follows. */
  .head { display: grid; gap: var(--space-3) var(--space-7); margin-bottom: var(--space-6); }
  .head h2 { font-size: var(--fs-h2); max-width: 18ch; }
  .head p { max-width: 44ch; font-size: var(--fs-lead); line-height: 1.45; color: var(--muted); }
  @media (min-width: 1024px) { .head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; } }
  /* Curation: the policy in one sentence and its date on the left, the rules as an editorial list. */
  .policy { display: grid; gap: var(--space-6); padding-top: var(--space-6); border-top: 1px solid var(--rule-strong); }
  @media (min-width: 1024px) { .policy { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-7); } }
  .policy h2 { font-size: var(--fs-h2); }
  .statement { margin-top: var(--space-4); max-width: 22ch; font-family: var(--serif); font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.875rem); line-height: 1.25; color: var(--muted); }
  .stamp { display: inline-flex; align-items: center; gap: var(--space-2); margin-top: var(--space-5); padding: 0.3rem 0.75rem; border: 1px solid var(--rule-strong); border-radius: 999px; font-size: var(--fs-small); font-weight: 500; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--action); }
  .more { margin-top: var(--space-3); }
  .more a { display: inline-flex; align-items: center; gap: 0.35em; min-height: 44px; font-weight: 560; }
  .rules li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); column-gap: var(--space-4); padding-block: var(--space-5); border-bottom: 1px solid var(--rule); }
  .rules li:first-child { padding-top: 0; }
  .rules .n { grid-row: span 2; font-size: var(--fs-small); font-variant-numeric: tabular-nums; color: var(--muted); line-height: 2; }
  .rules h3 { font-family: var(--serif); font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem); font-weight: 500; letter-spacing: -0.01em; }
  .rules p { margin-top: var(--space-2); max-width: 52ch; color: var(--muted); }

  /* Questions: a narrow column of native disclosures; the marker is drawn, the state is the browser's. */
  .faq { display: grid; gap: var(--space-5); }
  @media (min-width: 1024px) { .faq { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-7); } }
  .faq h2 { font-size: var(--fs-h2); }
  .questions { border-top: 1px solid var(--rule-strong); }
  details { border-bottom: 1px solid var(--rule); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    padding-block: var(--space-3);
    font-weight: 560;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '';
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.3rem;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: translateY(-25%) rotate(45deg);
    transition: transform var(--t-ui) var(--ease);
  }
  details[open] summary::after { transform: translateY(25%) rotate(-135deg); }
  summary:hover { color: var(--action); }
  details p { max-width: 60ch; padding-bottom: var(--space-5); color: var(--muted); }
</style>
