---
// /cursos/ (V0.6): the course library as a video-style grid (src/components/CourseLibrary.astro), with a search
// already filtered to the course formats that are published. /materiais/ keeps the format sections of
// LibraryPage.astro.
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import CourseLibrary from '../../components/CourseLibrary.astro';
import MagnifyingGlassIcon from '../../components/icons/radix/MagnifyingGlassIcon.astro';
import { libraryGroups } from '../../lib/libraries';
import { routes } from '../../lib/routes';
import { pt as t } from '../../i18n/pt';

const c = t.pages.cursos;
const l = t.library;
const search = `${routes.search}?formato=${libraryGroups('cursos').map((g) => g.format).join(',')}`;
---
<Base title={c.title} description={c.description}>
  <PageIntro eyebrow={c.eyebrow} heading={c.heading} lead={c.lead}>
    <a class="search" href={search}><MagnifyingGlassIcon width={18} height={18} />{t.courseLibrary.search}</a>
  </PageIntro>
  <div data-library="cursos"><CourseLibrary /></div>
  <div class="wrap next">
    <p class="note">{l.note}</p>
    <p class="other">
      {l.other.materiais.text}{' '}
      <a href={routes.materials}>{l.other.materiais.label}{' '}<span aria-hidden="true">→</span></a>
    </p>
  </div>
</Base>

<style>
  .search {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-top: var(--space-5);
    padding-inline: var(--space-4) var(--space-5);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--raised);
    color: var(--ink);
    font-weight: 560;
    text-decoration: none;
    transition: border-color var(--t-ui);
  }
  .search:hover { border-color: var(--ink); color: var(--ink); }
  .next { display: grid; gap: var(--space-3); padding-block: var(--space-6) var(--space-8); border-top: 1px solid var(--rule); }
  .note { max-width: var(--measure); color: var(--muted); }
  .other a { display: inline-flex; align-items: center; gap: 0.35em; min-height: 44px; font-weight: 560; }
</style>
