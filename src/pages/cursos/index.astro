---
// /cursos/ (V0.7): the course library laid out like a video platform, in the Academy's own identity: the
// wine header, a row of path chips, the grid of thumbnails, and, below 1024px, the bottom navigation. The
// page's title and breadcrumb stay for assistive tech and search engines, hidden from sight. There is one
// theme, the institutional one: no dark mode, no switch.
import Base from '../../layouts/Base.astro';
import CourseLibrary from '../../components/CourseLibrary.astro';
import { routes } from '../../lib/routes';
import { pt as t } from '../../i18n/pt';

const c = t.pages.cursos;
---
<Base title={c.title} description={c.description} bottomNav>
  <div class="sr-only">
    <nav aria-label={t.breadcrumb.label} data-breadcrumb>
      <ol role="list"><li><a href={routes.home}>{t.breadcrumb.home}</a></li><li aria-current="page">{c.heading}</li></ol>
    </nav>
    <h1>{c.heading}</h1>
    <p>{c.lead}</p>
  </div>
  <CourseLibrary />
</Base>

<style>
  /* One side margin for the header bar, the chips and the grid: they align on the same edge. */
  :global(html[data-bottom-nav]) { --library-side: 12px; }
  @media (min-width: 1280px) { :global(html[data-bottom-nav]) { --library-side: 24px; } }
</style>
